                <span style="font-size:11px;font-weight:700;color:var(--mut);letter-spacing:.12em;text-transform:uppercase">Horarios de Atención</span>
                <span style="font-size:13.5px;font-weight:600;color:var(--txt)">Lun – Vier 8:00am – 5:00pm<br>Sáb y Dom 8:00am – 2:00pm</span>
              </div>
            </div>

            <div style="height:1px;background:var(--line);margin:4px 0"></div>

            <div style="display:flex;gap:12px;align-items:flex-start">
              <span class="mi" style="font-size:20px;color:var(--gold);margin-top:1px">location_on</span>
              <div style="display:grid;gap:2px">
                <span style="font-size:11px;font-weight:700;color:var(--mut);letter-spacing:.12em;text-transform:uppercase">Sede Presencial</span>
