              <span style="font-size:14px;font-weight:700;color:var(--txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Lyosprofesional@gmail.com</span>
            </div>
            <span class="mi mio" style="font-size:18px;color:var(--gold)">open_in_new</span>
