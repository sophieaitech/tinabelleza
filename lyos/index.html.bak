</section>

<footer style="position:relative;background:linear-gradient(180deg,var(--bg) 0%,var(--surf) 100%);border-top:1.5px solid var(--line2);padding:clamp(52px,6.5vw,76px) 0 calc(28px + env(safe-area-inset-bottom));overflow:hidden">
  
