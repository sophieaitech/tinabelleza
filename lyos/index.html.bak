const money = (n, lang = 'es') => {
  if (n == null) return '';
  const L = LANGS.find(x => x.id === lang) || LANGS[0];
  const val = Math.round(n * L.rate);
  if (L.id === 'en') {
    return '$ ' + val + ' USD';
  } else if (L.id === 'pt') {
    return 'R$ ' + new Intl.NumberFormat('pt-BR').format(val) + ' BRL';
  } else if (L.id === 'kr') {
    return '₩ ' + new Intl.NumberFormat('ko-KR').format(val);
  } else {
    return '$ ' + new Intl.NumberFormat('es-CO').format(val);
  }
};

