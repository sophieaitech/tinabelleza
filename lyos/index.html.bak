          <div style="position:absolute;left:24px;right:24px;bottom:20px">
            <div style="display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:999px;border:1px solid rgba(241,222,184,.4);background:rgba(14,11,7,.6);backdrop-filter:blur(12px);font-size:10px;letter-spacing:.22em;text-transform:uppercase;font-weight:800;color:#F1DEB8">
              <span style="width:7px;height:7px;border-radius:999px;background:#25D366;box-shadow:0 0 8px #25D366;display:inline-block"></span>
