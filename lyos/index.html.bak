          </div>
        </div>

        <!-- Contact Details Grid -->
        <div style="padding:clamp(22px,3vw,32px);display:grid;gap:16px;align-content:start;flex:1">
          
          <!-- WhatsApp Contact Item -->
          <a href="{{ waLink }}" target="_blank" style="display:flex;gap:14px;align-items:center;padding:14px 16px;border-radius:20px;background:var(--surf2);border:1px solid var(--line);transition:all .25s" style-hover="border-color:var(--gold);transform:translateX(4px)">
            <div style="width:42px;height:42px;border-radius:14px;background:#25D366;display:grid;place-items:center;color:#fff;flex:none;box-shadow:0 8px 18px -4px rgba(37,211,102,.5)">
              <span class="mi" style="font-size:22px">chat</span>
            </div>
            <div style="display:grid;gap:2px;flex:1">
              <span style="font-size:11px;font-weight:700;color:var(--mut);letter-spacing:.12em;text-transform:uppercase">Línea Oficial WhatsApp</span>
