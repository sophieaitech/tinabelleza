        <!-- Newsletter Input Form -->
        <div style="display:flex;gap:6px;margin-top:14px;background:var(--surf);border:1.5px solid var(--line2);border-radius:999px;padding:4px 4px 4px 14px;box-shadow:var(--e1)">
          <input placeholder="Tu correo electrónico" aria-label="Correo para newsletter" style="flex:1;min-width:0;height:40px;border:0;background:transparent;outline:none;font-size:13px;color:var(--txt)" />
          <button onClick="{{ subscribe }}" aria-label="Suscribirme al club" title="Suscribirme" style="width:40px;height:40px;flex:none;border:0;border-radius:999px;background:var(--goldGrad);color:var(--onGold);cursor:pointer;display:grid;place-items:center;box-shadow:0 4px 12px rgba(168,124,47,.4);transition:all .2s" style-hover="filter:brightness(1.1);transform:scale(1.05)">
            <span class="mi" style="font-size:19px">arrow_forward</span>
          </button>
        </div>

        <!-- Payment Badges Strip -->
        <div style="margin-top:18px">
          <span style="display:block;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);font-weight:700;margin-bottom:8px">PAGOS SEGUROS &amp; DESPACHO</span>
          <div style="display:flex;flex-wrap:wrap;gap:6px">
            <span style="padding:5px 10px;border-radius:8px;background:var(--surf2);border:1px solid var(--line);font-size:11px;font-weight:700;color:var(--txt)">Bancolombia</span>
            <span style="padding:5px 10px;border-radius:8px;background:var(--surf2);border:1px solid var(--line);font-size:11px;font-weight:700;color:var(--txt)">Nequi</span>
            <span style="padding:5px 10px;border-radius:8px;background:var(--surf2);border:1px solid var(--line);font-size:11px;font-weight:700;color:var(--txt)">PSE</span>
            <span style="padding:5px 10px;border-radius:8px;background:rgba(37,211,102,.1);border:1px solid rgba(37,211,102,.25);font-size:11px;font-weight:700;color:#25D366">Contraentrega</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Luxury Copyright & Legal Bar -->
    <div style="margin-top:clamp(40px,5vw,56px);padding-top:22px;border-top:1.5px solid var(--line2);display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;font-size:12px;color:var(--mut)">
      <div style="display:flex;align-items:center;gap:8px">
        <span class="mi" style="font-size:16px;color:var(--gold)">verified_user</span>
        <span>© 2026 LYOS Profesional · Todos los derechos reservados · Fórmulas con registro oficial INVIMA.</span>
      </div>
      
      <div style="display:flex;flex-wrap:wrap;gap:18px;align-items:center">
        <a href="#contacto" style="color:var(--mut);text-decoration:none;transition:color .2s" style-hover="color:var(--gold)">Políticas de Envío</a>
        <a href="#contacto" style="color:var(--mut);text-decoration:none;transition:color .2s" style-hover="color:var(--gold)">Garantía &amp; Devoluciones</a>
        <a href="#contacto" style="color:var(--mut);text-decoration:none;transition:color .2s" style-hover="color:var(--gold)">Privacidad</a>
        <a href="#inicio" aria-label="Volver arriba" title="Volver al inicio" style="width:34px;height:34px;border-radius:999px;background:var(--surf);border:1px solid var(--line2);display:grid;place-items:center;color:var(--gold);text-decoration:none;transition:all .2s;box-shadow:var(--e1)" style-hover="background:var(--surf2);transform:translateY(-2px)">
          <span class="mi" style="font-size:18px">arrow_upward</span>
        </a>
      </div>
    </div>

  </div>
</footer>

<nav class="mob" style="position:fixed;left:14px;right:14px;bottom:calc(12px + env(safe-area-inset-bottom));z-index:65;background:var(--glass);backdrop-filter:blur(28px) saturate(1.6);-webkit-backdrop-filter:blur(28px) saturate(1.6);border:1px solid var(--line2);border-radius:999px;padding:6px 8px;display:flex;justify-content:space-around;align-items:center;box-shadow:0 18px 45px -10px rgba(0,0,0,.3),var(--e2)">
  <a href="#inicio" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 2px;border-radius:999px;color:var(--txt);font-size:10px;font-weight:700;text-decoration:none;transition:all .2s" style-hover="color:var(--gold)"><span class="mi mio" style="font-size:21px">home</span><span data-i18n="nav_home">Inicio</span></a>
  <a href="#productos" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 2px;border-radius:999px;color:var(--txt);font-size:10px;font-weight:700;text-decoration:none;transition:all .2s" style-hover="color:var(--gold)"><span class="mi mio" style="font-size:21px">storefront</span><span data-i18n="nav_products">Productos</span></a>
  <a href="#comparador" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 2px;border-radius:999px;color:var(--txt);font-size:10px;font-weight:700;text-decoration:none;transition:all .2s" style-hover="color:var(--gold)"><span class="mi mio" style="font-size:21px">compare</span><span data-i18n="nav_before_after">Antes &amp; Después</span></a>
  <a href="#contacto" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 2px;border-radius:999px;color:var(--txt);font-size:10px;font-weight:700;text-decoration:none;transition:all .2s" style-hover="color:var(--gold)"><span class="mi mio" style="font-size:21px">support_agent</span><span data-i18n="nav_vip_support">Asesoría VIP</span></a>
</nav>

<div class="fab">
  <sc-if value="{{ installReady }}" hint-placeholder-val="{{ false }}">
    <button onClick="{{ install }}" style="display:flex;align-items:center;gap:8px;height:46px;padding:0 18px;border:1px solid var(--line2);border-radius:999px;background:var(--glass);backdrop-filter:blur(18px);color:var(--txt);font-weight:600;font-size:13px;cursor:pointer;box-shadow:var(--e2)"><span class="mi" style="font-size:19px;color:var(--gold)">install_mobile</span>Instalar app</button>
  </sc-if>
  <a href="{{ waLink }}" target="_blank" aria-label="WhatsApp" style="position:relative;width:60px;height:60px;border-radius:999px;background:#25D366;display:grid;place-items:center;box-shadow:0 14px 32px -8px rgba(37,211,102,.66)" style-hover="transform:scale(1.06)">
    <span style="position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;animation:ping 2.4s ease-out infinite"></span>
    <svg viewBox="0 0 24 24" width="31" height="31" fill="#fff" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.92 1.16-.15.2-.3.22-.6.07-.3-.15-1.12-.41-2.14-1.32-.79-.71-1.32-1.58-1.47-1.88-.15-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.08 3.3 5.05 4.5.7.3 1.25.48 1.68.62.71.22 1.35.19 1.86.12.57-.09 1.75-.71 2-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c0 5.19-4.23 9.41-9.43 9.41zm8.02-17.44A11.32 11.32 0 0 0 12.04 1C5.8 1 .73 6.07.73 12.3c0 1.99.52 3.94 1.51 5.66L.5 23.5l5.68-1.49a11.3 11.3 0 0 0 5.86 1.6h.01c6.23 0 11.3-5.07 11.3-11.3 0-3.02-1.18-5.86-3.29-7.98z"/></svg>
  </a>
</div>

<div style="position:fixed;left:clamp(12px,2vw,20px);bottom:calc(88px + env(safe-area-inset-bottom));z-index:94;display:flex;flex-direction:column;gap:10px;max-width:min(94vw,390px);pointer-events:none">
  <sc-for list="{{ toasts }}" as="t" hint-placeholder-count="0">
    <div style="pointer-events:auto;display:flex;gap:12px;align-items:center;padding:14px 18px;border-radius:24px;background:var(--surf);backdrop-filter:blur(24px);border:1.5px solid {{ t.color }};box-shadow:0 20px 50px -14px rgba(0,0,0,.5),var(--e3);animation:slidein .32s cubic-bezier(.2,.8,.2,1);position:relative">
      
      <!-- Icon with glow -->
      <span style="width:38px;height:38px;flex:none;border-radius:999px;background:{{ t.color }};display:grid;place-items:center;color:#fff;box-shadow:0 0 14px {{ t.color }}">
        <span class="mi" style="font-size:20px">{{ t.icon }}</span>
      </span>

      <div style="display:flex;flex-direction:column;flex:1;min-width:0">
        <span style="font-size:13.5px;font-weight:800;line-height:1.25;color:var(--txt)">{{ t.t }}</span>
        <span style="font-size:12px;color:var(--mut);line-height:1.35;margin-top:2px">{{ t.b }}</span>
        
        <sc-if value="{{ t.isCart }}" hint-placeholder-val="{{ false }}">
          <button onClick="{{ t.viewCart }}" style="align-self:flex-start;margin-top:6px;border:0;background:transparent;padding:0;font-size:11.5px;font-weight:800;color:#25D366;cursor:pointer;display:inline-flex;align-items:center;gap:4px;text-decoration:underline">
            <span>Ver mi carrito &amp; pagar</span>
            <span class="mi" style="font-size:14px">arrow_forward</span>
          </button>
        </sc-if>
      </div>

      <button onClick="{{ t.close }}" aria-label="Cerrar notificación" style="width:28px;height:28px;flex:none;border:0;background:var(--surf2);border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--dim);margin-left:2px;transition:all .2s" style-hover="background:var(--surf3);color:var(--txt)">
        <span class="mi" style="font-size:16px">close</span>
      </button>
    </div>
  </sc-for>
</div>
<sc-if value="{{ buyP }}" hint-placeholder-val="{{ false }}">
<div onClick="{{ closeBuy }}" style="position:fixed;inset:0;z-index:98;background:rgba(8,6,4,.68);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);display:flex;align-items:center;justify-content:center;padding:clamp(14px,3vw,24px);overflow-y:auto">
  <div onClick="{{ stop }}" class="hs" style="width:min(100%,540px);background:var(--surf);border:1.5px solid var(--line2);border-radius:clamp(28px,3.5vw,36px);box-shadow:0 30px 90px -20px rgba(0,0,0,.6),var(--e3);animation:slidein .34s cubic-bezier(.2,.8,.2,1);max-height:min(90dvh,880px);overflow-y:auto;position:relative;margin:auto">
    
    <!-- Modal Header with VIP Badge, Theme Toggle and Close Button -->
    <div style="padding:22px 24px 0;display:flex;align-items:center;justify-content:space-between;gap:12px">
      <span style="display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:999px;background:var(--surf3);font-size:10.5px;letter-spacing:.16em;font-weight:800;color:var(--gold);box-shadow:var(--e1)">
        <span class="mi" style="font-size:15px">bolt</span>COMPRA RÁPIDA VIP
      </span>
      <div style="display:flex;align-items:center;gap:8px">
        <button onClick="{{ toggleTheme }}" aria-label="Cambiar tema claro/oscuro" title="Cambiar tema claro / oscuro" style="width:38px;height:38px;border:1px solid var(--line2);border-radius:999px;background:var(--surf2);cursor:pointer;display:grid;place-items:center;color:var(--gold);transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf3);border-color:var(--gold);transform:translateY(-1px)">
          <span class="mi mio" style="font-size:19px">{{ themeIcon }}</span>
        </button>
        <button onClick="{{ closeBuy }}" aria-label="Cerrar modal" style="width:38px;height:38px;border:1px solid var(--line2);border-radius:999px;background:var(--surf2);cursor:pointer;display:grid;place-items:center;color:var(--txt);transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf3);border-color:var(--gold);color:var(--gold);transform:rotate(90deg)">
          <span class="mi" style="font-size:20px">close</span>
        </button>
      </div>
    </div>

    <!-- Product Summary Card -->
    <div style="padding:18px 24px 0;display:flex;gap:16px;align-items:center">
      <span style="width:92px;height:92px;flex:none;border-radius:24px;background:var(--plinth);display:grid;place-items:center;overflow:hidden;border:1.5px solid var(--line2);box-shadow:var(--e1)">
        <img src="{{ buyImg }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:contain;padding:8px;mix-blend-mode:multiply;transition:transform .4s" style-hover="transform:scale(1.08)" />
      </span>
      <div style="display:flex;flex-direction:column;flex:1;min-width:0">
        <div style="display:flex;align-items:center;gap:6px">
          <span style="color:var(--gold);letter-spacing:1.2px;font-size:13px">★★★★★</span>
          <span style="font-size:12.5px;font-weight:800;color:var(--txt)">{{ buyP.rating }}</span>
          <span style="font-size:10.5px;font-weight:700;color:var(--gold);padding:2px 7px;border-radius:999px;background:var(--surf3);margin-left:auto">OFICIAL</span>
        </div>
        <span style="font-family:'Outfit',sans-serif;font-size:19px;font-weight:800;letter-spacing:-.025em;line-height:1.18;margin-top:4px;color:var(--txt)">{{ buyP.name }}</span>
        <span style="font-size:12.5px;color:var(--mut);margin-top:3px;font-weight:600">{{ buyV.ml }} seleccionado</span>
      </div>
    </div>

    <!-- Variant Selector -->
    <div style="padding:22px 24px 0">
      <span style="display:flex;align-items:center;gap:6px;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mut);font-weight:800">
        <span class="mi" style="font-size:16px;color:var(--gold)">view_in_ar</span>Presentación
      </span>
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:10px">
        <sc-for list="{{ buyVariants }}" as="v" hint-placeholder-count="0">
          <button onClick="{{ v.pick }}" style="{{ v.style }}">
            <span style="display:block;font-size:13px;font-weight:800">{{ v.label }}</span>
            <span style="display:block;font-size:12px;color:var(--mut);margin-top:2px;font-weight:600">{{ v.price }}</span>
          </button>
        </sc-for>
      </div>
    </div>

    <!-- Quantity Selector -->
    <div style="padding:20px 24px 0;display:flex;align-items:center;justify-content:space-between;gap:14px">
      <span style="display:flex;align-items:center;gap:6px;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mut);font-weight:800">
        <span class="mi" style="font-size:16px;color:var(--gold)">shopping_basket</span>Cantidad
      </span>
      <div style="display:flex;align-items:center;gap:3px;border:1.5px solid var(--line2);background:var(--surf2);border-radius:999px;padding:3px;box-shadow:var(--e1)">
        <button onClick="{{ buyDec }}" aria-label="Disminuir cantidad" style="width:36px;height:36px;border:0;background:transparent;border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--txt);transition:all .2s" style-hover="background:var(--surf3)">
          <span class="mi" style="font-size:19px">remove</span>
        </button>
        <span style="min-width:32px;text-align:center;font-size:16px;font-weight:800;color:var(--txt)">{{ buyQty }}</span>
        <button onClick="{{ buyInc }}" aria-label="Aumentar cantidad" style="width:36px;height:36px;border:0;background:transparent;border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--txt);transition:all .2s" style-hover="background:var(--surf3)">
          <span class="mi" style="font-size:19px">add</span>
        </button>
      </div>
    </div>

    <!-- Total to Pay Card -->
    <div style="margin:20px 24px 0;padding:18px 20px;border-radius:24px;background:linear-gradient(150deg,var(--surf2) 0%,var(--surf3) 100%);border:1.5px solid var(--line2);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;box-shadow:var(--e1)">
      <div style="display:flex;flex-direction:column">
        <span style="font-size:11px;color:var(--mut);letter-spacing:.12em;font-weight:700">TOTAL A PAGAR</span>
        <span style="font-family:'Outfit',sans-serif;font-size:28px;font-weight:800;letter-spacing:-.03em;line-height:1.1;color:var(--txt);margin-top:2px">{{ buyTotal }}</span>
      </div>
      <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:var(--surf);border:1px solid var(--line2);font-size:11.5px;font-weight:700;color:var(--mut)">
        <span class="mi" style="font-size:16px;color:var(--gold)">local_shipping</span>Envío se calcula al confirmar
      </span>
    </div>

    <!-- WhatsApp Trust Callout -->
    <div style="margin:16px 24px 0;padding:14px 18px;border-radius:20px;background:var(--surf2);border:1px solid var(--line2);display:flex;gap:12px;align-items:center">
      <span style="width:34px;height:34px;border-radius:999px;background:#25D366;display:grid;place-items:center;color:#fff;flex:none;box-shadow:0 6px 14px -4px rgba(37,211,102,.6)">
        <span class="mi" style="font-size:19px">chat</span>
      </span>
      <div style="display:grid;gap:1px;flex:1">
        <span style="font-size:12.5px;font-weight:800;color:var(--txt)">Atención directa por WhatsApp</span>
        <span style="font-size:11.5px;color:var(--mut);line-height:1.4">Recibes confirmación instantánea, datos de transferencia y guía.</span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div style="padding:20px 24px 24px;display:grid;gap:10px">
      <a href="{{ buyWa }}" target="_blank" onClick="{{ buyConfirm }}" style="display:flex;align-items:center;justify-content:center;gap:10px;height:58px;border-radius:999px;background:#25D366;color:#fff;font-weight:800;font-size:15.5px;box-shadow:0 14px 32px -10px rgba(37,211,102,.7);transition:all .25s" style-hover="filter:brightness(1.08);transform:translateY(-2px)">
        <svg viewBox="0 0 24 24" width="23" height="23" fill="#fff" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.92 1.16-.15.2-.3.22-.6.07-.3-.15-1.12-.41-2.14-1.32-.79-.71-1.32-1.58-1.47-1.88-.15-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.08 3.3 5.05 4.5.7.3 1.25.48 1.68.62.71.22 1.35.19 1.86.12.57-.09 1.75-.71 2-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c0 5.19-4.23 9.41-9.43 9.41zm8.02-17.44A11.32 11.32 0 0 0 12.04 1C5.8 1 .73 6.07.73 12.3c0 1.99.52 3.94 1.51 5.66L.5 23.5l5.68-1.49a11.3 11.3 0 0 0 5.86 1.6h.01c6.23 0 11.3-5.07 11.3-11.3 0-3.02-1.18-5.86-3.29-7.98z"/></svg>
        <span>Confirmar por WhatsApp</span>
      </a>
      <button onClick="{{ buyAddCart }}" style="height:52px;border:1.5px solid var(--line2);background:transparent;border-radius:999px;cursor:pointer;font-weight:700;font-size:14px;color:var(--txt);display:flex;align-items:center;justify-content:center;gap:8px;transition:all .25s" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold)">
        <span class="mi mio" style="font-size:20px">add_shopping_cart</span>
        <span>Seguir comprando y añadir al carrito</span>
      </button>
    </div>

  </div>
</div>
</sc-if>

<sc-if value="{{ qvP }}" hint-placeholder-val="{{ false }}">
<div onClick="{{ closeQv }}" style="position:fixed;inset:0;z-index:95;background:rgba(8,6,4,.68);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);overflow-y:auto;padding:clamp(12px,2.8vw,24px);display:flex;align-items:center;justify-content:center">
  <div onClick="{{ stop }}" class="hs" style="max-width:960px;width:100%;margin:auto;background:var(--surf);border:1.5px solid var(--line2);border-radius:clamp(26px,3.5vw,36px);overflow:hidden;box-shadow:0 32px 100px -20px rgba(0,0,0,.65),var(--e3);animation:slidein .34s cubic-bezier(.2,.8,.2,1);max-height:min(92dvh,880px);overflow-y:auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr))">
    
    <!-- Left Column: Visual Product Stage -->
    <div style="position:relative;background:var(--plinth);padding:clamp(20px,2.8vw,32px);display:flex;flex-direction:column;justify-content:space-between;border-right:1px solid var(--line);min-height:360px">
      
      <!-- Top Badges & Close on Mobile/Desktop -->
      <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
        <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:999px;background:rgba(14,11,7,.85);backdrop-filter:blur(10px);border:1px solid rgba(241,222,184,.3);color:#F1DEB8;font-size:9.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;box-shadow:0 4px 12px rgba(0,0,0,.3)">
          <span class="mi" style="font-size:13px;color:var(--gold)">stars</span>
          <span>{{ qvP.badge }}</span>
        </span>
        <div style="display:flex;align-items:center;gap:8px">
          <button onClick="{{ toggleTheme }}" aria-label="Cambiar tema claro/oscuro" title="Cambiar tema claro / oscuro" style="width:38px;height:38px;border:1px solid var(--line2);border-radius:999px;background:var(--surf);backdrop-filter:blur(10px);cursor:pointer;display:grid;place-items:center;color:var(--gold);transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf2);border-color:var(--gold);transform:translateY(-1px)">
            <span class="mi mio" style="font-size:19px">{{ themeIcon }}</span>
          </button>
          <button onClick="{{ qvP.fav }}" aria-label="Guardar en favoritos" style="width:38px;height:38px;border:1px solid var(--line2);border-radius:999px;background:var(--surf);backdrop-filter:blur(10px);cursor:pointer;display:grid;place-items:center;color:{{ qvP.favColor }};transition:all .25s;box-shadow:var(--e1)" style-hover="transform:scale(1.1)">
            <span class="mi" style="font-size:20px">{{ qvP.favIcon }}</span>
          </button>
          <button onClick="{{ closeQv }}" aria-label="Cerrar ficha" style="width:38px;height:38px;border:1px solid var(--line2);border-radius:999px;background:var(--surf);backdrop-filter:blur(10px);cursor:pointer;display:grid;place-items:center;color:var(--txt);transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold);transform:rotate(90deg)">
            <span class="mi" style="font-size:20px">close</span>
          </button>
        </div>
      </div>

      <!-- Main Product Display -->
      <div style="flex:1;display:grid;place-items:center;padding:18px 0;min-height:260px">
        <img src="{{ qvImgSrc }}" alt="{{ qvP.name }}" loading="lazy" style="max-width:100%;max-height:380px;object-fit:contain;mix-blend-mode:multiply;transition:transform .5s cubic-bezier(.2,.8,.2,1)" style-hover="transform:scale(1.06)" />
      </div>

      <!-- Gallery Thumbnails -->
      <div style="display:flex;gap:8px;justify-content:center;margin-top:auto;padding-top:10px">
        <sc-for list="{{ qvGallery }}" as="g" hint-placeholder-count="0">
          <button onClick="{{ g.pick }}" style="{{ g.style }}">
            <img src="{{ g.src }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:contain;padding:4px;mix-blend-mode:multiply" />
          </button>
        </sc-for>
      </div>
    </div>

    <!-- Right Column: Minimalist Luxury Editorial Details -->
    <div style="padding:clamp(22px,3vw,34px);display:flex;flex-direction:column;justify-content:space-between">
      
      <div>
        <!-- Social Proof Bar & Status -->
        <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px">
          <div style="display:flex;align-items:center;gap:6px">
            <span style="color:var(--gold);letter-spacing:1px;font-size:14px">★★★★★</span>
            <span style="font-size:13px;font-weight:800;color:var(--txt)">{{ qvP.rating }}</span>
            <span style="font-size:12px;color:var(--mut)">({{ qvP.reviews }} reseñas)</span>
          </div>
          <span style="display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:999px;background:rgba(37,211,102,.1);color:#25D366;font-size:11px;font-weight:700">
            <span style="width:6px;height:6px;border-radius:999px;background:#25D366"></span>
            En stock · Despacho Hoy
          </span>
        </div>

        <!-- Product Name -->
        <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(22px,2.8vw,32px);font-weight:800;letter-spacing:-.035em;line-height:1.08;margin:10px 0 0;color:var(--txt)">
          {{ qvP.name }}
        </h2>

        <!-- Description -->
        <p style="font-size:13.5px;line-height:1.62;color:var(--mut);margin:8px 0 0;max-width:48ch">
          {{ qvP.desc }}
        </p>

        <!-- Tags Minimalist Pills -->
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:12px">
          <sc-for list="{{ qvP.tags }}" as="t" hint-placeholder-count="0">
            <span style="padding:5px 11px;border-radius:999px;background:var(--surf2);border:1px solid var(--line2);font-size:11px;font-weight:700;color:var(--gold)">
              {{ t }}
            </span>
          </sc-for>
        </div>

        <!-- Key Technical Specs / Benefits (Ultra-fine 2x2 Grid) -->
        <div style="display:grid;gap:6px;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));margin-top:16px;padding:12px 14px;border-radius:18px;background:var(--surf2);border:1px solid var(--line)">
          <sc-for list="{{ qvBullets }}" as="b" hint-placeholder-count="0">
            <div style="display:flex;gap:7px;align-items:center">
              <span class="mi" style="font-size:16px;color:var(--gold);flex:none">check_circle</span>
              <span style="font-size:12px;font-weight:600;color:var(--txt);line-height:1.35">{{ b }}</span>
            </div>
          </sc-for>
        </div>

        <!-- Mode of Use (Collapsible Luxury Accordion) -->
        <details style="margin-top:14px;border-radius:16px;background:var(--surf);border:1px solid var(--line2);overflow:hidden">
          <summary style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;cursor:pointer;font-size:12.5px;font-weight:700;color:var(--txt);list-style:none">
            <span style="display:inline-flex;align-items:center;gap:7px"><span class="mi" style="font-size:17px;color:var(--gold)">science</span>Modo de uso &amp; protocolo</span>
            <span class="mi" style="font-size:18px;color:var(--mut)">expand_more</span>
          </summary>
          <p style="margin:0;padding:0 14px 12px;font-size:12px;line-height:1.6;color:var(--mut)">
            {{ qvP.uso }}
          </p>
        </details>

        <!-- Presentation Selector -->
        <div style="margin-top:16px">
          <span style="display:block;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mut);font-weight:800">
            Presentación disponible
          </span>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px">
            <sc-for list="{{ qvVariants }}" as="v" hint-placeholder-count="0">
              <button onClick="{{ v.pick }}" style="{{ v.style }}">
                <span style="display:block;font-size:12.5px;font-weight:800">{{ v.label }}</span>
                <span style="display:block;font-size:11.5px;color:var(--mut);margin-top:1px;font-weight:600">{{ v.price }}</span>
              </button>
            </sc-for>
          </div>
        </div>
      </div>

      <!-- Checkout & Action Footer -->
      <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--line)">
        
        <!-- Total & Quantity Row -->
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
          <div style="display:flex;flex-direction:column">
            <span style="font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--mut);font-weight:700">Total</span>
            <span style="font-family:'Outfit',sans-serif;font-size:26px;font-weight:800;letter-spacing:-.03em;color:var(--txt);line-height:1.1">{{ qvTotal }}</span>
          </div>

          <div style="display:flex;align-items:center;gap:2px;border:1.5px solid var(--line2);border-radius:999px;padding:3px;background:var(--surf2)">
            <button onClick="{{ qvDec }}" aria-label="Menos" style="width:34px;height:34px;border:0;background:transparent;border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--txt)" style-hover="background:var(--surf3)">
              <span class="mi" style="font-size:18px">remove</span>
            </button>
            <span style="min-width:28px;text-align:center;font-size:14.5px;font-weight:800;color:var(--txt)">{{ qvQty }}</span>
            <button onClick="{{ qvInc }}" aria-label="Más" style="width:34px;height:34px;border:0;background:transparent;border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--txt)" style-hover="background:var(--surf3)">
              <span class="mi" style="font-size:18px">add</span>
            </button>
          </div>
        </div>

        <!-- Buttons Row -->
        <div style="display:flex;gap:8px;margin-top:14px">
          <button onClick="{{ qvBuy }}" style="flex:1;height:52px;border:0;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:800;font-size:14.5px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 10px 26px -8px rgba(168,124,47,.7);transition:all .25s" style-hover="filter:brightness(1.08);transform:translateY(-2px)">
            <span class="mi" style="font-size:19px">bolt</span>
            <span>{{ qvCta }}</span>
          </button>
          <button onClick="{{ qvAdd }}" aria-label="Añadir al carrito" style="width:52px;height:52px;flex:none;border:1.5px solid var(--line2);background:transparent;border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--txt);transition:all .25s" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold)">
            <span class="mi mio" style="font-size:21px">add_shopping_cart</span>
          </button>
        </div>

        <!-- Micro Trust Guarantee Line -->
        <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:center;margin-top:14px;font-size:11.5px;color:var(--mut);font-weight:600">
          <span style="display:inline-flex;align-items:center;gap:5px"><span class="mi" style="font-size:15px;color:var(--gold)">local_shipping</span>Envío 1–4 días</span>
          <span style="display:inline-flex;align-items:center;gap:5px"><span class="mi" style="font-size:15px;color:var(--gold)">verified_user</span>100% Original</span>
          <span style="display:inline-flex;align-items:center;gap:5px"><span class="mi" style="font-size:15px;color:var(--gold)">support_agent</span>Asesoría VIP</span>
        </div>

      </div>

    </div>

  </div>
</div>
</sc-if>

<sc-if value="{{ searchOpen }}" hint-placeholder-val="{{ false }}">
<div onClick="{{ closeSearch }}" style="position:fixed;inset:0;z-index:99;background:rgba(10,8,5,.5);backdrop-filter:blur(10px);padding:16px">
  <div onClick="{{ stop }}" style="max-width:680px;margin:8vh auto 0;background:var(--surf);border:1px solid var(--line2);border-radius:30px;box-shadow:var(--e3);overflow:hidden;animation:slidein .3s cubic-bezier(.2,.8,.2,1)">
    <div style="display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid var(--line)">
      <span class="mi mio" style="font-size:23px;color:var(--gold)">search</span>
      <input autofocus placeholder="Buscar producto o tratamiento…" onInput="{{ onSearch }}" style="flex:1;border:0;background:transparent;outline:none;font-size:16px" />
      <button onClick="{{ closeSearch }}" aria-label="Cerrar" style="border:0;background:var(--surf2);width:34px;height:34px;border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--txt)"><span class="mi" style="font-size:19px">close</span></button>
    </div>
    <div style="max-height:56vh;overflow:auto;padding:8px">
      <sc-for list="{{ searchResults }}" as="r" hint-placeholder-count="3">
        <button onClick="{{ r.open }}" style="width:100%;display:flex;align-items:center;gap:14px;padding:10px;border:0;background:transparent;border-radius:20px;cursor:pointer;text-align:left" style-hover="background:var(--surf2)">
          <span style="width:54px;height:54px;border-radius:16px;background:var(--plinth);display:grid;place-items:center;overflow:hidden;flex:none;border:1px solid var(--line)"><img src="{{ r.img }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:contain;padding:5px;mix-blend-mode:multiply" /></span>
          <span style="display:flex;flex-direction:column;flex:1;min-width:0">
            <span style="font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ r.name }}</span>
            <span style="font-size:12px;color:var(--mut);margin-top:2px">{{ r.cat }} · {{ r.priceLabel }}</span>
          </span>
          <span class="mi mio" style="font-size:20px;color:var(--gold)">arrow_outward</span>
        </button>
      </sc-for>
      <sc-if value="{{ noResults }}" hint-placeholder-val="{{ false }}"><p style="padding:26px 16px;text-align:center;color:var(--mut);font-size:14px">Sin resultados. Escríbenos por WhatsApp y te ayudamos.</p></sc-if>
    </div>
  </div>
</div>
</sc-if>

<sc-if value="{{ cartOpen }}" hint-placeholder-val="{{ false }}">
<div onClick="{{ closeCart }}" style="position:fixed;inset:0;z-index:90;background:rgba(8,6,4,.65);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)">
  <aside onClick="{{ stop }}" class="hs" style="position:absolute;top:0;right:0;bottom:0;width:min(100%,460px);background:var(--surf);border-left:1.5px solid var(--line2);display:flex;flex-direction:column;animation:slidein .32s cubic-bezier(.2,.8,.2,1);box-shadow:0 30px 90px -15px rgba(0,0,0,.6),var(--e3)">
    
    <!-- Cart Header with Theme Toggle & Close -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--line);background:var(--surf);gap:10px">
      <div style="display:flex;align-items:center;gap:10px;min-width:0;flex:1">
        <span style="width:38px;height:38px;border-radius:999px;background:var(--surf3);display:grid;place-items:center;color:var(--gold);flex:none">
          <span class="mi" style="font-size:20px">shopping_bag</span>
        </span>
        <div style="min-width:0">
          <h3 data-en="Your bag" style="font-family:'Outfit',sans-serif;font-size:18px;font-weight:800;margin:0;letter-spacing:-.025em;color:var(--txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Tu Carrito VIP</h3>
          <span style="font-size:11.5px;color:var(--mut);font-weight:600">{{ cartCount }} artículo(s)</span>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:8px;flex:none">
        <button onClick="{{ toggleTheme }}" aria-label="Cambiar tema claro/oscuro" title="Cambiar tema claro / oscuro" style="width:36px;height:36px;border:1px solid var(--line2);border-radius:999px;background:var(--surf2);cursor:pointer;display:grid;place-items:center;color:var(--gold);transition:all .2s;box-shadow:var(--e1)" style-hover="background:var(--surf3);border-color:var(--gold);transform:translateY(-1px)">
          <span class="mi mio" style="font-size:18px">{{ themeIcon }}</span>
        </button>
        <button onClick="{{ closeCart }}" aria-label="Cerrar carrito" style="width:36px;height:36px;border:1px solid var(--line2);border-radius:999px;background:var(--surf2);cursor:pointer;display:grid;place-items:center;color:var(--txt);transition:all .2s" style-hover="background:var(--surf3);border-color:var(--gold);color:var(--gold)">
          <span class="mi" style="font-size:19px">close</span>
        </button>
      </div>
    </div>

    <!-- Hot Sales Urgency Strip -->
    <div style="padding:10px 18px;background:linear-gradient(90deg,rgba(168,124,47,.15),rgba(37,211,102,.12));border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px">
      <span class="mi" style="font-size:16px;color:var(--gold);animation:arrowPulse 1.4s infinite">local_fire_department</span>
      <span style="font-size:11.5px;font-weight:700;color:var(--txt);line-height:1.3">
        🔥 <strong>Alta Demanda:</strong> Stock reservado temporalmente para tu orden.
      </span>
    </div>

    <!-- Empty Cart State -->
    <sc-if value="{{ cartEmpty }}" hint-placeholder-val="{{ false }}">
      <div style="flex:1;display:grid;place-items:center;padding:40px;text-align:center">
        <div>
          <span style="width:74px;height:74px;border-radius:999px;background:var(--surf2);display:grid;place-items:center;margin:0 auto;color:var(--dim);border:1px dashed var(--line2)">
            <span class="mi mio" style="font-size:38px">shopping_bag</span>
          </span>
          <p data-en="Your bag is empty" style="font-family:'Outfit',sans-serif;font-size:19px;font-weight:800;color:var(--txt);margin:16px 0 0">Tu carrito está esperando por ti</p>
          <p style="font-size:13px;color:var(--mut);margin:6px 0 0;max-width:32ch">Explora nuestro catálogo profesional con fórmulas libres de formol y brillo espejo.</p>
          <a href="#productos" onClick="{{ closeCart }}" style="display:inline-flex;align-items:center;gap:7px;margin-top:20px;padding:12px 26px;border-radius:999px;background:var(--goldGrad);font-size:13.5px;font-weight:800;color:var(--onGold);box-shadow:var(--e1)">
            <span class="mi" style="font-size:17px">storefront</span>
            <span>Ver portafolio de productos</span>
          </a>
        </div>
      </div>
    </sc-if>

    <!-- Cart Items Scroll Area -->
    <div style="flex:1;overflow-y:auto;padding:16px">
      
      <!-- Free Shipping Progress Bar (Hot Sales) -->
      <sc-if value="{{ hasFreeShipBar }}" hint-placeholder-val="{{ false }}">
        <div style="padding:14px 16px;border-radius:20px;background:var(--surf2);border:1.5px dashed var(--line2);margin-bottom:14px">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
            <span style="font-size:12px;font-weight:700;color:var(--txt);display:inline-flex;align-items:center;gap:5px">
              <span class="mi" style="font-size:16px;color:var(--gold)">local_shipping</span>
              <span>Te faltan <strong style="color:var(--gold)">{{ freeShipLeft }}</strong> para <strong>ENVÍO GRATIS</strong></span>
            </span>
            <span style="font-size:11.5px;font-weight:800;color:var(--gold)">{{ freeShipPct }}</span>
          </div>
          <div style="height:7px;border-radius:999px;background:var(--surf3);margin-top:9px;overflow:hidden">
            <div style="height:100%;width:{{ freeShipPct }};background:var(--goldGrad);border-radius:999px;transition:width .4s ease"></div>
          </div>
        </div>
      </sc-if>

      <sc-for list="{{ cartLines }}" as="l" hint-placeholder-count="0">
        <div style="display:flex;gap:13px;padding:14px;border-radius:22px;background:var(--surf2);border:1px solid var(--line);margin-bottom:12px;box-shadow:var(--e1)">
          
          <span style="width:72px;height:72px;flex:none;border-radius:18px;background:var(--plinth);overflow:hidden;display:grid;place-items:center;border:1px solid var(--line)">
            <img src="{{ l.img }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:contain;padding:5px;mix-blend-mode:multiply" />
          </span>

          <div style="flex:1;min-width:0;display:flex;flex-direction:column;justify-content:space-between">
            <div>
              <p style="margin:0;font-family:'Outfit',sans-serif;font-size:14.5px;font-weight:800;line-height:1.25;color:var(--txt)">{{ l.name }}</p>
              <div style="display:flex;align-items:center;gap:6px;margin-top:4px">
                <span style="font-size:11px;font-weight:700;color:var(--gold);padding:2px 7px;border-radius:999px;background:var(--surf3)">{{ l.ml }}</span>
                <span style="font-size:12px;color:var(--mut)">{{ l.unitLabel }} c/u</span>
              </div>
            </div>

            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:12px">
              <div style="display:flex;align-items:center;gap:2px;border:1.5px solid var(--line2);border-radius:999px;padding:2px;background:var(--surf)">
                <button onClick="{{ l.dec }}" aria-label="Menos" style="width:28px;height:28px;border:0;background:transparent;border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--txt)" style-hover="background:var(--surf2)">
                  <span class="mi" style="font-size:16px">remove</span>
                </button>
                <span style="min-width:24px;text-align:center;font-size:13.5px;font-weight:800;color:var(--txt)">{{ l.qty }}</span>
                <button onClick="{{ l.inc }}" aria-label="Más" style="width:28px;height:28px;border:0;background:transparent;border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--txt)" style-hover="background:var(--surf2)">
                  <span class="mi" style="font-size:16px">add</span>
                </button>
              </div>

              <span style="font-family:'Outfit',sans-serif;font-size:16px;font-weight:800;color:var(--txt)">{{ l.totalLabel }}</span>

              <button onClick="{{ l.del }}" aria-label="Quitar del carrito" style="width:30px;height:30px;border:0;background:transparent;border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--dim);transition:all .2s" style-hover="color:#C4392E;background:rgba(196,57,46,.1)">
                <span class="mi mio" style="font-size:18px">delete</span>
              </button>
            </div>
          </div>

        </div>
      </sc-for>

      <!-- Trust Mini Matrix inside Cart -->
      <div style="display:grid;gap:6px;padding:12px 14px;border-radius:18px;background:var(--surf2);border:1px solid var(--line);margin-top:6px;font-size:11.5px;color:var(--mut);font-weight:600">
        <div style="display:flex;align-items:center;gap:7px"><span class="mi" style="font-size:16px;color:var(--gold)">verified_user</span><span>Fórmulas 100% Originales y Certificadas</span></div>
        <div style="display:flex;align-items:center;gap:7px"><span class="mi" style="font-size:16px;color:var(--gold)">local_shipping</span><span>Despacho ágil en 24h desde bodega Cali</span></div>
      </div>

    </div>

    <!-- Cart Footer with Persuasive Total & Checkout CTA -->
    <div style="padding:18px 22px calc(18px + env(safe-area-inset-bottom));border-top:1.5px solid var(--line2);background:var(--surf);box-shadow:0 -10px 30px rgba(0,0,0,.08)">
      
      <div style="display:grid;gap:7px;font-size:13.5px">
        <div style="display:flex;justify-content:space-between;color:var(--mut)">
          <span data-en="Subtotal">Subtotal</span>
          <span style="color:var(--txt);font-weight:700">{{ subLabel }}</span>
        </div>
        <div style="display:flex;justify-content:space-between;color:var(--mut)">
          <span data-en="Shipping">Envío nacional</span>
          <span style="color:var(--gold);font-weight:700">{{ shipLabel }}</span>
        </div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:12px;padding-top:12px;border-top:1px solid var(--line)">
        <span style="font-size:14px;font-weight:800;color:var(--txt)">Total Estimado</span>
        <span style="font-family:'Outfit',sans-serif;font-size:26px;font-weight:800;letter-spacing:-.03em;color:var(--txt)">{{ grandLabel }}</span>
      </div>

      <button onClick="{{ openCo }}" style="width:100%;height:56px;margin-top:14px;border:0;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:800;font-size:15px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px;box-shadow:0 14px 34px -10px rgba(168,124,47,.7);transition:all .25s" style-hover="filter:brightness(1.08);transform:translateY(-2px)">
        <span>Finalizar Compra Segura</span>
        <span class="mi" style="font-size:20px">arrow_forward</span>
      </button>

      <p style="margin:10px 0 0;text-align:center;font-size:11.5px;color:var(--dim);display:flex;align-items:center;justify-content:center;gap:5px">
        <span class="mi" style="font-size:15px;color:#25D366">lock</span>
        <span>Cierre directo y seguro por WhatsApp con soporte en vivo</span>
      </p>
    </div>

  </aside>
</div>
</sc-if>

<sc-if value="{{ coOpen }}" hint-placeholder-val="{{ false }}">
<div style="position:fixed;inset:0;z-index:100;background:var(--bg);overflow-y:auto">
  
  <!-- Checkout Top Sticky Bar -->
  <div style="position:sticky;top:0;z-index:50;background:var(--glass);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-bottom:1.5px solid var(--line2)">
    <div style="max-width:1040px;margin:0 auto;padding:14px 20px;display:flex;align-items:center;gap:14px">
      <button onClick="{{ closeCo }}" aria-label="Volver al carrito" style="width:40px;height:40px;border:1.5px solid var(--line2);background:var(--surf);border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--txt);transition:all .2s" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold)">
        <span class="mi" style="font-size:21px">arrow_back</span>
      </button>
      
      <div style="display:flex;flex-direction:column;flex:1">
        <span style="font-family:'Outfit',sans-serif;font-size:18px;font-weight:800;letter-spacing:-.025em;color:var(--txt);display:inline-flex;align-items:center;gap:6px">
          <span style="color:var(--gold)">LYOS</span> · Checkout Express
        </span>
        <span style="font-size:12px;color:var(--mut);font-weight:600;margin-top:1px">
          {{ coStep }}
        </span>
      </div>

      <!-- Theme Toggle (Luna / Sol) -->
      <button onClick="{{ toggleTheme }}" aria-label="Cambiar tema claro/oscuro" title="Cambiar tema claro / oscuro" style="width:39px;height:39px;border:1px solid var(--line2);background:var(--surf);border-radius:999px;display:grid;place-items:center;cursor:pointer;color:var(--txt);transition:all .25s;box-shadow:var(--e1);flex:none" style-hover="background:var(--surf2);border-color:var(--gold);transform:translateY(-1px)">
        <span class="mi mio" style="font-size:19px;color:var(--gold)">{{ themeIcon }}</span>
      </button>
      
      <!-- Multi-Language & Currency Selector -->
      <div style="position:relative;flex:none">
        <button onClick="{{ toggleLangMenu }}" aria-label="Cambiar idioma y divisa" style="height:39px;padding:0 10px 0 6px;border:1px solid var(--line2);background:var(--surf);border-radius:999px;display:flex;align-items:center;gap:6px;cursor:pointer;font-size:12px;font-weight:700;color:var(--txt);transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf2);border-color:var(--gold);transform:translateY(-1px)">
          <img src="{{ activeLang.flagSrc }}" alt="{{ activeLang.name }}" width="20" height="20" style="width:20px;height:20px;border-radius:50%;object-fit:cover;flex:none;box-shadow:0 1px 4px rgba(0,0,0,.2);border:1px solid var(--line2);display:block" />
          <span style="font-weight:800;font-size:11.5px;letter-spacing:.04em;color:var(--txt)">{{ activeLang.code }}</span>
          <span style="font-size:9.5px;color:var(--gold);font-weight:800;padding:1px 6px;border-radius:999px;background:var(--surf3);letter-spacing:.03em;border:1px solid rgba(212,175,55,.2)">{{ activeLang.curr }}</span>
          <span class="mi" style="font-size:15px;color:var(--mut);margin-left:-3px">expand_more</span>
        </button>

        <sc-if value="{{ langMenuOpen }}" hint-placeholder-val="{{ false }}">
          <div onClick="{{ stop }}" style="position:absolute;top:calc(100% + 8px);right:0;width:268px;background:var(--surf);backdrop-filter:blur(28px);-webkit-backdrop-filter:blur(28px);border:1.5px solid var(--line2);border-radius:24px;padding:10px;box-shadow:0 22px 55px -12px rgba(0,0,0,.45),var(--e3);z-index:90;animation:slidein .25s cubic-bezier(.2,.8,.2,1);display:grid;gap:4px">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:6px 10px 8px;border-bottom:1px solid var(--line);margin-bottom:3px">
              <span style="display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)">
                <span class="mi" style="font-size:13px">public</span>
                <span>Idioma &amp; Moneda</span>
              </span>
              <span style="font-size:9.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--mut)">
                Divisa
              </span>
            </div>
            <sc-for list="{{ langOptions }}" as="lo" hint-placeholder-count="4">
              <button onClick="{{ lo.pick }}" style="display:flex;align-items:center;justify-content:space-between;width:100%;padding:9px 11px;border-radius:16px;border:1.5px solid {{ lo.active ? 'var(--gold)' : 'transparent' }};background:{{ lo.active ? 'var(--surf3)' : 'transparent' }};cursor:pointer;color:var(--txt);transition:all .2s;text-align:left" style-hover="background:var(--surf2);transform:translateX(2px)">
                <span style="display:flex;align-items:center;gap:10px;min-width:0">
                  <img src="{{ lo.flagSrc }}" alt="{{ lo.name }}" width="22" height="22" style="width:22px;height:22px;border-radius:50%;object-fit:cover;flex:none;box-shadow:0 2px 6px rgba(0,0,0,.2);border:1px solid var(--line2);display:block" />
                  <span style="display:flex;flex-direction:column;line-height:1.2">
                    <span style="font-size:13.5px;font-weight:{{ lo.active ? '800' : '600' }};color:var(--txt)">{{ lo.name }}</span>
                    <span style="font-size:10.5px;color:var(--mut);font-weight:600">{{ lo.region }}</span>
                  </span>
                </span>
                <div style="display:flex;align-items:center;gap:6px">
                  <span style="font-size:11px;font-weight:800;padding:3px 8px;border-radius:999px;background:{{ lo.active ? 'var(--goldGrad)' : 'var(--surf2)' }};color:{{ lo.active ? 'var(--onGold)' : 'var(--mut)' }};border:1px solid {{ lo.active ? 'transparent' : 'var(--line2)' }};box-shadow:{{ lo.active ? '0 3px 8px -2px rgba(168,124,47,.5)' : 'none' }}">
                    {{ lo.curr }}
                  </span>
                </div>
              </button>
            </sc-for>
          </div>
        </sc-if>
      </div>

      <span class="desk" style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:999px;background:rgba(37,211,102,.12);border:1px solid rgba(37,211,102,.3);font-size:11.5px;font-weight:800;color:#25D366;white-space:nowrap">
        <span class="mi" style="font-size:16px">verified</span>
        <span>Despacho Directo</span>
      </span>
    </div>
  </div>

  <div style="max-width:1040px;margin:0 auto;padding:26px 20px 56px">
    
    <!-- STEP 1: ULTRA-MINIMALIST 1-CLICK EXPRESS CHECKOUT -->
    <sc-if value="{{ isCo1 }}" hint-placeholder-val="{{ false }}">
      <div style="max-width:580px;margin:0 auto;padding:clamp(24px,4vw,36px);border-radius:32px;background:var(--surf);border:1.5px solid var(--line2);box-shadow:var(--e3);position:relative">
        
        <!-- Top Badge & Title -->
        <div style="text-align:center;margin-bottom:22px">
          <div style="display:inline-flex;align-items:center;gap:6px;padding:5px 14px;border-radius:999px;background:rgba(212,175,55,.12);border:1px solid rgba(212,175,55,.35);font-size:11px;font-weight:800;color:var(--gold);margin-bottom:10px">
            <span class="mi" style="font-size:14px">bolt</span>
            <span>Despacho Express en 1 Clic · Cero Formularios</span>
          </div>
          
          <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(24px,3.8vw,32px);font-weight:800;letter-spacing:-.035em;color:var(--txt);margin:0">
            Confirmar tu Pedido
          </h2>
          
          <p style="font-size:13.5px;color:var(--mut);margin:6px auto 0;max-width:42ch;line-height:1.5">
            Sin formularios largos. Confirma y un asesor te atenderá de inmediato por WhatsApp para coordinar tu entrega y pago.
          </p>
        </div>

        <!-- Selected Products List -->
        <div style="background:var(--surf2);border:1px solid var(--line);border-radius:22px;padding:16px;margin-bottom:20px">
          <div style="display:flex;align-items:center;justify-content:space-between;padding-bottom:10px;border-bottom:1px solid var(--line);margin-bottom:10px">
            <span style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);font-weight:800">PRODUCTOS SELECCIONADOS</span>
            <span style="font-size:11px;font-weight:700;color:#25D366;display:inline-flex;align-items:center;gap:4px">
              <span class="mi" style="font-size:13px">check_circle</span>Stock Disponible
            </span>
          </div>

          <div style="display:grid;gap:12px;max-height:240px;overflow-y:auto;padding-right:4px">
            <sc-for list="{{ cartLines }}" as="l" hint-placeholder-count="2">
              <div style="display:flex;gap:12px;align-items:center;justify-content:space-between">
                <div style="display:flex;align-items:center;gap:12px;min-width:0;flex:1">
                  <span style="width:44px;height:44px;border-radius:12px;background:var(--plinth);overflow:hidden;display:grid;place-items:center;flex:none;border:1px solid var(--line)">
                    <img src="{{ l.img }}" alt="" style="width:100%;height:100%;object-fit:contain;padding:3px;mix-blend-mode:multiply" />
                  </span>
                  <div style="display:flex;flex-direction:column;min-width:0">
                    <span style="color:var(--txt);font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px">
                      {{ l.qty }} × {{ l.name }}
                    </span>
                    <span style="color:var(--mut);font-size:12px">Presentación: {{ l.ml }}</span>
                  </div>
                </div>
                <span style="font-family:'Outfit',sans-serif;font-weight:800;white-space:nowrap;color:var(--txt);font-size:15px">{{ l.totalLabel }}</span>
              </div>
            </sc-for>
          </div>
        </div>

        <!-- Optional Email field for receipt/order tracking (completely optional - no name asked) -->
        <div style="margin-bottom:16px">
          <label style="display:grid;gap:6px">
            <span style="font-size:11.5px;color:var(--mut);font-weight:700;letter-spacing:.04em;text-transform:uppercase">Correo Electrónico (Opcional)</span>
            <div style="position:relative;display:flex;align-items:center">
              <span class="mi mio" style="position:absolute;left:14px;color:var(--dim);font-size:18px;pointer-events:none">mail</span>
              <input name="email" type="email" onInput="{{ onField }}" placeholder="tucorreo@ejemplo.com (para tu comprobante)" style="width:100%;height:46px;padding:0 14px 0 42px;border-radius:14px;border:1.5px solid var(--line2);background:var(--surf2);outline:none;font-size:13.5px;color:var(--txt);transition:all .2s" style-focus="border-color:var(--gold);background:var(--surf)" />
            </div>
          </label>
        </div>

        <!-- Coupon code row -->
        <div style="display:flex;gap:8px;margin-bottom:18px">
          <input onInput="{{ onCoupon }}" placeholder="CÓDIGO DE CUPÓN (LYOS10)" style="flex:1;min-width:0;height:44px;padding:0 14px;border-radius:14px;border:1.5px solid var(--line2);background:var(--surf2);outline:none;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--txt)" style-focus="border-color:var(--gold)" />
          <button onClick="{{ applyCoupon }}" type="button" style="height:44px;padding:0 16px;border:1.5px solid var(--line2);background:var(--surf);border-radius:14px;cursor:pointer;font-weight:800;font-size:12px;color:var(--txt);white-space:nowrap;transition:all .2s" style-hover="border-color:var(--gold);color:var(--gold);background:var(--surf2)">Aplicar</button>
        </div>

        <sc-if value="{{ couponOk }}" hint-placeholder-val="{{ false }}">
          <div style="margin:-8px 0 16px;padding:8px 12px;border-radius:12px;background:rgba(37,211,102,.1);border:1px solid rgba(37,211,102,.3);display:flex;align-items:center;gap:7px;font-size:12px;color:#25D366;font-weight:700">
            <span class="mi" style="font-size:16px">check_circle</span>
            <span>¡LYOS10 aplicado! 10% de descuento directo en tu orden</span>
          </div>
        </sc-if>

        <!-- Total Breakdown Strip -->
        <div style="background:var(--surf2);border:1px solid var(--line);border-radius:20px;padding:16px 20px;margin-bottom:20px;display:grid;gap:8px">
          <div style="display:flex;justify-content:space-between;color:var(--mut);font-size:13.5px">
            <span>Subtotal</span>
            <span style="font-weight:700;color:var(--txt)">{{ subLabel }}</span>
          </div>
          <sc-if value="{{ hasDisc }}" hint-placeholder-val="{{ false }}">
            <div style="display:flex;justify-content:space-between;color:#25D366;font-size:13.5px">
              <span>Descuento aplicado</span>
              <span style="font-weight:800;color:#25D366">-{{ discLabel }}</span>
            </div>
          </sc-if>
          <div style="display:flex;justify-content:space-between;align-items:baseline;padding-top:10px;border-top:1px solid var(--line)">
            <span style="font-size:14px;font-weight:800;color:var(--txt)">TOTAL ESTIMADO</span>
            <span style="font-family:'Outfit',sans-serif;font-size:28px;font-weight:800;letter-spacing:-.03em;color:var(--txt)">{{ grandLabel }}</span>
          </div>
        </div>

        <!-- High-Impact Direct WhatsApp Button -->
        <button onClick="{{ sendOrder }}" style="width:100%;height:58px;border:0;border-radius:999px;background:#25D366;color:#fff;font-weight:800;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;box-shadow:0 14px 34px -10px rgba(37,211,102,.7);transition:all .25s" style-hover="filter:brightness(1.06);transform:translateY(-2px)">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="#fff" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.92 1.16-.15.2-.3.22-.6.07-.3-.15-1.12-.41-2.14-1.32-.79-.71-1.32-1.58-1.47-1.88-.15-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.08 3.3 5.05 4.5.7.3 1.25.48 1.68.62.71.22 1.35.19 1.86.12.57-.09 1.75-.71 2-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c0 5.19-4.23 9.41-9.43 9.41zm8.02-17.44A11.32 11.32 0 0 0 12.04 1C5.8 1 .73 6.07.73 12.3c0 1.99.52 3.94 1.51 5.66L.5 23.5l5.68-1.49a11.3 11.3 0 0 0 5.86 1.6h.01c6.23 0 11.3-5.07 11.3-11.3 0-3.02-1.18-5.86-3.29-7.98z"/></svg>
          <span>Confirmar y Pedir por WhatsApp</span>
        </button>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid var(--line);text-align:center">
          <div style="display:flex;align-items:center;justify-content:center;gap:5px;font-size:11px;color:var(--mut);font-weight:700">
            <span class="mi" style="font-size:16px;color:#25D366">verified_user</span>
            <span>Atención Inmediata</span>
          </div>
          <div style="display:flex;align-items:center;justify-content:center;gap:5px;font-size:11px;color:var(--mut);font-weight:700">
            <span class="mi" style="font-size:16px;color:var(--gold)">local_shipping</span>
            <span>Envíos Nacionales</span>
          </div>
          <div style="display:flex;align-items:center;justify-content:center;gap:5px;font-size:11px;color:var(--mut);font-weight:700">
            <span class="mi" style="font-size:16px;color:#25D366">lock</span>
            <span>Cero Formularios</span>
          </div>
        </div>

      </div>
    </sc-if>

    <!-- STEP 2: LUXURY ORDER CONFIRMATION & REAL-TIME DISPATCH TRACKING -->
    <sc-if value="{{ isCo2 }}" hint-placeholder-val="{{ false }}">
      <div style="max-width:960px;margin:0 auto;display:grid;gap:24px">
        
        <!-- Header Banner: Celebration & Order Number -->
        <div style="text-align:center;padding:clamp(24px,4vw,36px) 20px 22px;border-radius:32px;background:linear-gradient(150deg,var(--surf) 0%,var(--surf2) 100%);border:1.5px solid var(--line2);box-shadow:var(--e2);position:relative;overflow:hidden">
          <div style="position:absolute;top:0;left:50%;transform:translateX(-50%);width:320px;height:120px;background:radial-gradient(ellipse,rgba(37,211,102,.2) 0%,transparent 70%);filter:blur(30px);pointer-events:none"></div>
          
          <div style="width:60px;height:60px;border-radius:999px;background:rgba(37,211,102,.12);border:2px solid #25D366;color:#25D366;display:grid;place-items:center;margin:0 auto 14px;box-shadow:0 8px 24px -4px rgba(37,211,102,.4)">
            <span class="mi" style="font-size:32px">verified</span>
          </div>

          <div style="display:inline-flex;align-items:center;gap:6px;padding:5px 14px;border-radius:999px;background:var(--surf3);border:1px solid var(--line2);font-size:11.5px;font-weight:800;color:var(--gold);margin-bottom:8px">
            <span class="mi" style="font-size:14px">receipt_long</span>
            <span>ORDEN #{{ orderId }} · {{ orderDate }}</span>
          </div>

          <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(24px,4vw,34px);font-weight:800;letter-spacing:-.035em;color:var(--txt);margin:0">
            ¡Tu Pedido ha sido Enviado con Éxito!
          </h2>

          <p style="font-size:14px;color:var(--mut);margin:8px auto 0;max-width:56ch;line-height:1.55">
            Recibimos tu solicitud en nuestro canal de WhatsApp. Tu asesor de logística se comunicará contigo de inmediato para coordinar la entrega y el pago.
          </p>

          <!-- Direct Reopen WhatsApp Button -->
          <div style="max-width:440px;margin:20px auto 0">
            <a href="{{ waResend }}" target="_blank" style="display:flex;align-items:center;justify-content:center;gap:10px;height:54px;border-radius:999px;background:#25D366;color:#fff;font-weight:800;font-size:15px;text-decoration:none;box-shadow:0 12px 30px -8px rgba(37,211,102,.7);transition:all .25s" style-hover="filter:brightness(1.06);transform:translateY(-2px)">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="#fff" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.92 1.16-.15.2-.3.22-.6.07-.3-.15-1.12-.41-2.14-1.32-.79-.71-1.32-1.58-1.47-1.88-.15-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.08 3.3 5.05 4.5.7.3 1.25.48 1.68.62.71.22 1.35.19 1.86.12.57-.09 1.75-.71 2-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c0 5.19-4.23 9.41-9.43 9.41zm8.02-17.44A11.32 11.32 0 0 0 12.04 1C5.8 1 .73 6.07.73 12.3c0 1.99.52 3.94 1.51 5.66L.5 23.5l5.68-1.49a11.3 11.3 0 0 0 5.86 1.6h.01c6.23 0 11.3-5.07 11.3-11.3 0-3.02-1.18-5.86-3.29-7.98z"/></svg>
              <span>Abrir Chat de WhatsApp con tu Asesor</span>
            </a>
          </div>
        </div>

        <!-- 2-Column Balanced Grid: Dispatch Timeline (Left) & Order Summary (Right) -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:20px;align-items:start">
          
          <!-- Column 1: Live Dispatch Status & Stepper -->
          <div style="display:grid;gap:18px">
            
            <!-- Cinematic GPS Route Frame -->
            <div style="position:relative;border-radius:28px;overflow:hidden;border:1.5px solid var(--line2);box-shadow:var(--e2);background:var(--surf)">
              <div style="position:relative;height:210px;background:radial-gradient(circle at 30% 40%,rgba(201,164,92,.18),transparent 60%),repeating-linear-gradient(0deg,var(--line) 0 1px,transparent 1px 36px),repeating-linear-gradient(90deg,var(--line) 0 1px,transparent 1px 36px),var(--surf2)">
                <svg viewBox="0 0 400 180" preserveAspectRatio="none" style="position:absolute;inset:0;width:100%;height:100%"><path d="M40 130 C 120 110, 180 60, 260 50 S 330 40, 360 35" fill="none" stroke="var(--gold)" stroke-width="3" stroke-linecap="round" stroke-dasharray="8 6" opacity=".9"></path></svg>
                
                <!-- Origin Hub Node -->
                <span style="position:absolute;left:10%;top:72%;transform:translate(-50%,-50%);display:grid;place-items:center;width:34px;height:34px;border-radius:999px;background:var(--surf);border:2px solid var(--gold);color:var(--gold);box-shadow:var(--e1)"><span class="mi" style="font-size:17px">inventory_2</span></span>
                
                <!-- Destination Node -->
                <span style="position:absolute;left:90%;top:20%;transform:translate(-50%,-50%);display:grid;place-items:center;width:34px;height:34px;border-radius:999px;background:var(--surf3);border:2px solid var(--line2);color:var(--mut)"><span class="mi" style="font-size:17px">home</span></span>
                
                <!-- Courier Moving Pin -->
                <span style="position:absolute;left:calc(10% + {{ trackPct }} * 0.8);top:calc(72% - {{ trackPct }} * 0.52);transform:translate(-50%,-50%);transition:left .8s cubic-bezier(.4,0,.2,1),top .8s cubic-bezier(.4,0,.2,1)">
                  <span style="position:absolute;inset:-12px;border-radius:999px;border:2px solid var(--gold);animation:ping 2.2s ease-out infinite"></span>
                  <span style="position:relative;display:grid;place-items:center;width:40px;height:40px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);box-shadow:var(--e2)"><span class="mi" style="font-size:20px">local_shipping</span></span>
                </span>
                
                <!-- Top Status Badge -->
                <span style="position:absolute;left:14px;top:14px;display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--line2);font-size:10.5px;font-weight:800;color:var(--txt)"><span style="width:7px;height:7px;border-radius:999px;background:#25D366;box-shadow:0 0 6px #25D366"></span>Despacho Cali · EN VIVO</span>
                
                <button onClick="{{ trackAdvance }}" type="button" style="position:absolute;right:14px;bottom:14px;display:inline-flex;align-items:center;gap:5px;height:32px;padding:0 12px;border-radius:999px;border:1px solid var(--line2);background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);cursor:pointer;font-size:11.5px;font-weight:700;color:var(--txt);transition:all .2s" style-hover="border-color:var(--gold);color:var(--gold)"><span class="mi" style="font-size:15px">play_arrow</span>Simular estado</button>
              </div>

              <!-- Dispatch Logistics Info Strip -->
              <div style="padding:14px 18px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px">
                <div style="display:flex;align-items:center;gap:10px">
                  <span style="width:36px;height:36px;border-radius:10px;background:var(--surf3);display:grid;place-items:center;color:var(--gold);flex:none"><span class="mi" style="font-size:20px">local_shipping</span></span>
                  <div style="display:flex;flex-direction:column">
                    <span style="font-size:13px;font-weight:800;color:var(--txt)">Centro Logístico LYOS</span>
                    <span style="font-size:11.5px;color:var(--mut);margin-top:1px">Empaque hermético &amp; sellado de fábrica</span>
                  </div>
                </div>
                <span style="font-size:11px;font-weight:800;color:#25D366;background:rgba(37,211,102,.1);padding:4px 10px;border-radius:999px">ACTIVO</span>
              </div>
            </div>

            <!-- Progress Timeline Stepper -->
            <div style="padding:22px;border-radius:28px;background:var(--surf);border:1.5px solid var(--line2);box-shadow:var(--e1)">
              <div style="display:flex;align-items:center;justify-content:space-between">
                <span style="font-size:11px;letter-spacing:.14em;color:var(--gold);font-weight:800;text-transform:uppercase">ESTADO EN TIEMPO REAL</span>
                <span style="font-size:11px;font-weight:700;color:var(--mut)">{{ trackNow }}</span>
              </div>

              <!-- Progress bar line -->
              <div style="height:4px;border-radius:999px;background:var(--surf3);margin:14px 0 16px;overflow:hidden">
                <div style="height:100%;width:{{ trackPct }};background:var(--goldGrad);border-radius:999px;transition:width .8s cubic-bezier(.4,0,.2,1)"></div>
              </div>

              <!-- Step choices -->
              <div style="display:grid;gap:8px">
                <sc-for list="{{ trackSteps }}" as="t" hint-placeholder-count="5">
                  <button onClick="{{ t.pick }}" type="button" style="display:flex;gap:12px;align-items:center;padding:10px 12px;border-radius:16px;border:0;background:{{ t.bg }};cursor:pointer;text-align:left;transition:all .2s;width:100%" style-hover="transform:translateX(3px)">
                    <span style="width:34px;height:34px;flex:none;border-radius:999px;border:{{ t.border }};display:grid;place-items:center;color:{{ t.color }}"><span class="mi" style="font-size:17px">{{ t.icon }}</span></span>
                    <span style="display:flex;flex-direction:column;flex:1;min-width:0">
                      <span style="font-size:13px;font-weight:800;color:{{ t.color }}">{{ t.label }}</span>
                      <span style="font-size:11.5px;color:var(--mut);margin-top:1px">{{ t.note }}</span>
                    </span>
                    <sc-if value="{{ t.done }}" hint-placeholder-val="{{ false }}">
                      <span class="mi" style="font-size:17px;color:var(--gold);flex:none">check</span>
                    </sc-if>
                  </button>
                </sc-for>
              </div>
            </div>

          </div>

          <!-- Column 2: Items Summary & Official Guarantee -->
          <div style="display:grid;gap:18px">
            
            <div style="padding:24px;border-radius:28px;background:var(--surf);border:1.5px solid var(--line2);box-shadow:var(--e2)">
              <div style="display:flex;align-items:center;justify-content:space-between;padding-bottom:12px;border-bottom:1px solid var(--line)">
                <span style="font-size:11px;letter-spacing:.14em;color:var(--gold);font-weight:800;text-transform:uppercase">RESUMEN DEL PEDIDO</span>
                <span style="font-size:11px;font-weight:700;color:var(--mut)">{{ orderLines.length }} productos</span>
              </div>

              <!-- Product Item list -->
              <div style="display:grid;gap:12px;margin:14px 0 16px;max-height:220px;overflow-y:auto;padding-right:4px">
                <sc-for list="{{ orderLines }}" as="l" hint-placeholder-count="2">
                  <div style="display:flex;gap:10px;align-items:center;justify-content:space-between">
                    <div style="display:flex;align-items:center;gap:10px;min-width:0;flex:1">
                      <span style="width:38px;height:38px;border-radius:10px;background:var(--plinth);overflow:hidden;display:grid;place-items:center;flex:none;border:1px solid var(--line)">
                        <img src="{{ l.img }}" alt="" style="width:100%;height:100%;object-fit:contain;padding:2px;mix-blend-mode:multiply" />
                      </span>
                      <div style="display:flex;flex-direction:column;min-width:0">
                        <span style="color:var(--txt);font-weight:700;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ l.qty }} × {{ l.name }}</span>
                        <span style="color:var(--mut);font-size:11.5px">{{ l.ml }}</span>
                      </div>
                    </div>
                    <span style="font-family:'Outfit',sans-serif;font-weight:800;color:var(--txt);font-size:14px">{{ l.total }}</span>
                  </div>
                </sc-for>
              </div>

              <!-- Optional Email receipt notice -->
              <sc-if value="{{ hasOrderEmail }}" hint-placeholder-val="{{ false }}">
                <div style="margin-bottom:14px;padding:9px 12px;border-radius:14px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.3);display:flex;align-items:center;gap:7px;font-size:12px;color:var(--gold);font-weight:700">
                  <span class="mi" style="font-size:17px">mail</span>
                  <span>Comprobante digital para: {{ orderEmail }}</span>
                </div>
              </sc-if>

              <!-- Totals Breakdown -->
              <div style="padding-top:14px;border-top:1px solid var(--line);display:grid;gap:8px;font-size:13px">
                <div style="display:flex;justify-content:space-between;color:var(--mut)"><span>Subtotal</span><span style="font-weight:700;color:var(--txt)">{{ orderSub }}</span></div>
                <sc-if value="{{ orderHasDisc }}" hint-placeholder-val="{{ false }}"><div style="display:flex;justify-content:space-between;color:#25D366"><span>Descuento aplicado</span><span style="font-weight:800;color:#25D366">-{{ orderDisc }}</span></div></sc-if>
                <div style="display:flex;justify-content:space-between;align-items:baseline;padding-top:12px;border-top:1px solid var(--line)">
                  <span style="font-size:14px;font-weight:800;color:var(--txt)">TOTAL ORDEN</span>
                  <span style="font-family:'Outfit',sans-serif;font-size:26px;font-weight:800;letter-spacing:-.03em;color:var(--txt)">{{ orderTotal }}</span>
                </div>
              </div>

              <!-- Copy Summary Button -->
              <button onClick="{{ copySummary }}" type="button" style="width:100%;height:46px;margin-top:16px;border:1.5px solid var(--line2);background:var(--surf2);border-radius:999px;cursor:pointer;font-weight:800;font-size:13px;color:var(--txt);display:flex;align-items:center;justify-content:center;gap:8px;transition:all .2s" style-hover="background:var(--surf);border-color:var(--gold);color:var(--gold)">
                <span class="mi" style="font-size:17px">{{ copyIcon }}</span>
                <span>{{ copyLabel }}</span>
              </button>

              <!-- Reassurance Strip -->
              <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--line);display:grid;gap:6px">
                <div style="display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--mut);font-weight:600">
                  <span class="mi" style="font-size:15px;color:#25D366">verified</span>
                  <span>Fórmulas 100% originales con registro INVIMA</span>
                </div>
                <div style="display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--mut);font-weight:600">
                  <span class="mi" style="font-size:15px;color:var(--gold)">support_agent</span>
                  <span>Asesoría personalizada directa por WhatsApp</span>
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>
    </sc-if>

  </div>
</div>
</sc-if>
<!--MOUNT-->
</div>
</x-dc>
