          <a href="mailto:Lyosprofesional@gmail.com" style="display:flex;gap:14px;align-items:center;padding:14px 16px;border-radius:20px;background:var(--surf2);border:1px solid var(--line);transition:all .25s" style-hover="border-color:var(--gold);transform:translateX(4px)">
