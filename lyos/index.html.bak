class Component extends DCLogic {
  state = {
    theme:'light', lang:'es', langMenuOpen:false, searchOpen:false, q:'', cat:'Todos',
    cart:[], fav:[], cartOpen:false, qv:null, qvVar:0, qvImg:0, qvQty:1,
    hero:'a', grid:'editorial', buy:null, buyVar:0, buyQty:1,
    co:0, carrier:'inter', order:null, err:'', toasts:[], intent:'comprar', installReady:false,
    pay:'transfer', coupon:'', couponOk:false, track:0, push:false, copied:false,
    addrSuggestions:[], isSearchingAddr:false, isGeolocating:false, addrConfirmed:false,
    beforeAfterPos:50,
    quizStep:1, quizHair:'crespo', quizGoal:'liso', quizProfile:'personal',
    roiClients:12, roiPrice:220000,
    faqCat:'all', faqQuery:'', faqOpen:0,
    activeArticle:null,
    reviewCat:'all'
  };
  f = { email:'', name:'', phone:'', city:'', addr:'', notes:'' };
  root = React.createRef();

  searchAddress(val) {
    this.f.addr = val;
    if (this.state.err) this.setState({ err:'' });
    if (!val || val.trim().length < 3) {
      this.setState({ addrSuggestions:[], isSearchingAddr:false, addrConfirmed:false });
      return;
    }
    this.setState({ isSearchingAddr:true });
    clearTimeout(this._addrT);
    this._addrT = setTimeout(async () => {
      try {
        const q = encodeURIComponent(val.trim());
        const res = await fetch(`https://photon.komoot.io/api/?q=${q}&limit=5&lat=3.4516&lon=-76.5320`);
        const data = await res.json();
        if (data && data.features && data.features.length > 0) {
          const list = data.features.map(f => {
            const p = f.properties;
            const street = [p.street || p.name, p.housenumber].filter(Boolean).join(' ');
            const city = p.city || p.locality || p.county || p.state || 'Cali';
            const details = [p.district, p.locality, city, p.state].filter((x, idx, self) => x && self.indexOf(x) === idx).join(', ');
            const full = (street || p.name || '') + (details ? ', ' + details : '');
            return {
              title: street || p.name || val,
              subtitle: details || p.country || 'Colombia',
              fullAddress: full,
              city: city
            };
          });
          this.setState({ addrSuggestions:list, isSearchingAddr:false });
        } else {
          this.setState({ addrSuggestions:[], isSearchingAddr:false });
        }
      } catch (err) {
        this.setState({ addrSuggestions:[], isSearchingAddr:false });
      }
    }, 240);
  }

  pickAddrSuggestion(item) {
    this.f.addr = item.fullAddress;
    if (item.city) this.f.city = item.city;
    this.setState({ addrSuggestions:[], isSearchingAddr:false, addrConfirmed:true });
    const addrInput = document.querySelector('input[name="addr"]');
    if (addrInput) addrInput.value = item.fullAddress;
    const cityInput = document.querySelector('input[name="city"]');
    if (cityInput && item.city) cityInput.value = item.city;
  }

  geolocateUser() {
    if (!navigator.geolocation) {
      this.toast('location_off', 'GPS no disponible', 'Ingresa tu dirección manualmente');
      return;
    }
    this.setState({ isGeolocating:true });
    navigator.geolocation.getCurrentPosition(async (pos) => {
      const { latitude, longitude } = pos.coords;
      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}`, {
          headers: { 'Accept-Language':'es' }
        });
        const data = await res.json();
        if (data && data.address) {
          const a = data.address;
          const street = [a.road, a.house_number].filter(Boolean).join(' ') || data.name || 'Mi Ubicación';
          const city = a.city || a.town || a.village || a.municipality || a.county || 'Cali';
          const full = [street, a.neighbourhood || a.suburb, city, a.state].filter(Boolean).join(', ');
          this.f.addr = full || data.display_name;
          this.f.city = city;
          const addrInput = document.querySelector('input[name="addr"]');
          if (addrInput) addrInput.value = this.f.addr;
          const cityInput = document.querySelector('input[name="city"]');
          if (cityInput) cityInput.value = this.f.city;
          this.setState({ isGeolocating:false, addrConfirmed:true, addrSuggestions:[] });
          this.toast('pin_drop', '¡Dirección Detectada!', `${city}: ${this.f.addr.slice(0, 32)}...`, '#25D366', false);
        } else {
          this.setState({ isGeolocating:false });
        }
      } catch (e) {
        this.setState({ isGeolocating:false });
      }
    }, (err) => {
      this.setState({ isGeolocating:false });
      this.toast('location_disabled', 'Permiso GPS denegado', 'Por favor escribe tu dirección');
    }, { timeout: 10000, enableHighAccuracy: true });
  }

  freeFrom() {
    const L = LANGS.find(x => x.id === this.state.lang) || LANGS[0];
    return L.freeShip;
  }

  componentDidMount() {
    const P = this.props;
    const init = { theme:P.startTheme ?? 'light', hero:P.heroVariant ?? 'a', grid:P.productLayout ?? 'editorial' };
    try {
      const raw = localStorage.getItem('lyos.state');
      if (raw) {
        const d = JSON.parse(raw);
        init.cart = d.cart || []; init.fav = d.fav || []; init.lang = d.lang || 'es';
        if (P.startTheme == null && d.theme) init.theme = d.theme;
        if (P.heroVariant == null && d.hero) init.hero = d.hero;
        if (P.productLayout == null && d.grid) init.grid = d.grid;
      }
    } catch (e) {}
    this.setState(init);
    this.bip = e => { e.preventDefault(); this.prompt = e; this.setState({ installReady:true }); };
    window.addEventListener('beforeinstallprompt', this.bip);
    if ('serviceWorker' in navigator) {
      try {
        navigator.serviceWorker.register('sw.js').then(r => r.update()).catch(() => {});
        navigator.serviceWorker.addEventListener('controllerchange', () => {});
      } catch (e) {}
    }
    if (this.props.liveFeed !== false) {
      this.feedT = setInterval(() => this.pushFeed(), 17000);
      this.boot = setTimeout(() => this.pushFeed(), 6000);
    }
    setTimeout(() => this.applyLang(), 50);
    this.initCalEmbed();
  }

  initCalEmbed() {
    const mountCal = () => {
      try {
        if (typeof window.Cal === 'function') {
          window.Cal("init", "lyospro", {origin:"https://app.cal.com"});
          window.Cal.config = window.Cal.config || {};
          window.Cal.config.forwardQueryParams = true;
          if (window.Cal.ns && window.Cal.ns.lyospro) {
            window.Cal.ns.lyospro("inline", {
              elementOrSelector:"#my-cal-inline-lyospro",
              config: {"layout":"month_view","useSlotsViewOnSmallScreen":"true"},
              calLink: "tinabelleza/lyospro",
            });
            window.Cal.ns.lyospro("ui", {
              "theme": "dark",
              "cssVarsPerTheme":{
                "dark":{
                  "cal-brand":"#d5ad34",
                  "cal-text":"#f7f2e9",
                  "cal-text-muted":"#a79e90",
                  "cal-bg":"#0d0b08",
                  "cal-bg-emphasis":"#1a150e",
                  "cal-border":"rgba(212,175,55,0.22)"
                }
              },
              "hideEventTypeDetails":false,
              "layout":"month_view"
            });
          }
        }
      } catch (err) {}
    };
    setTimeout(mountCal, 100);
    setTimeout(mountCal, 600);
    setTimeout(mountCal, 1800);
  }

  componentDidUpdate(prev) {
    const P = this.props;
    if (prev.startTheme !== P.startTheme && P.startTheme) this.setState({ theme:P.startTheme });
    if (prev.heroVariant !== P.heroVariant && P.heroVariant) this.setState({ hero:P.heroVariant });
    if (prev.productLayout !== P.productLayout && P.productLayout) this.setState({ grid:P.productLayout });
    this.persist();
  }
  persist() {
    try { localStorage.setItem('lyos.state', JSON.stringify({ cart:this.state.cart, fav:this.state.fav, theme:this.state.theme, lang:this.state.lang, hero:this.state.hero, grid:this.state.grid })); } catch (e) {}
    this.applyLang();
  }
  componentWillUnmount() {
    clearInterval(this.feedT); clearTimeout(this.boot);
    window.removeEventListener('beforeinstallprompt', this.bip);
  }

  applyLang() {
    const r = this.root.current; if (!r) return;
    const lang = this.state.lang || 'es';
    r.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.dataset.i18n;
      if (DICT[key] && DICT[key][lang]) {
        el.textContent = DICT[key][lang];
      }
    });
  }

  toast(icon, t, b, color, isCart) {
    const id = Math.random().toString(36).slice(2);
    const toastColor = color || 'var(--gold)';
    const item = {
      id, icon:icon || 'check_circle', t, b,
      color:toastColor,
      isCart:!!isCart,
      viewCart:() => { this.setState({ cartOpen:true }); this.setState(s => ({ toasts:s.toasts.filter(x => x.id !== id) })); },
      close:() => this.setState(s => ({ toasts:s.toasts.filter(x => x.id !== id) }))
    };
    this.setState(s => ({ toasts:[...s.toasts.slice(-2), item] }));
    setTimeout(() => this.setState(s => ({ toasts:s.toasts.filter(x => x.id !== id) })), 6500);
  }
  pushFeed() {
    const S = this.state;
    if (S.buy || S.qv || S.co > 0 || S.cartOpen || S.searchOpen) return;
    const n = FEED[Math.floor(Math.random() * FEED.length)];
    this.toast(n.icon, n.t, n.b, '#25D366', false);
  }

  prod(id) { return PRODUCTS.find(p => p.id === id); }
  oid() { return 'LYOS-' + Math.floor(100000 + Math.random() * 899999); }

  wa(text) { return 'https://wa.me/' + WA + '?text=' + encodeURIComponent(text); }

  waSingle(p, v, qty) {
    const lang = this.state.lang || 'es';
    const pName = lang === 'en' && p.name_en ? p.name_en : lang === 'pt' && p.name_pt ? p.name_pt : lang === 'kr' && p.name_kr ? p.name_kr : p.name;
    const L = ['*PEDIDO LYOS PROFESIONAL* 🖤', '', 'Hola LYOS Profesional, acabo de adquirir por la web:', '',
      '▸ *' + pName + '*', '▸ Presentación: ' + v.ml, '▸ Cantidad: ' + qty];
    if (v.price != null) L.push('▸ Total: *' + money(v.price * qty, lang) + '*');
    else L.push('▸ Precio: por cotizar');
    L.push('', 'Quisiera saber cómo te transfiero. ¡Gracias!', '', '_Pedido ' + this.oid() + '_');
    return this.wa(L.join('\n'));
  }
  waQuote(p, v) {
    const lang = this.state.lang || 'es';
    const pName = lang === 'en' && p.name_en ? p.name_en : lang === 'pt' && p.name_pt ? p.name_pt : lang === 'kr' && p.name_kr ? p.name_kr : p.name;
    return this.wa(['*COTIZACIÓN LYOS PROFESIONAL*', '', 'Hola LYOS Profesional, me interesa:', '',
      '▸ *' + pName + '*', '▸ Presentación: ' + v.ml, '', '¿Me compartes precio y ficha técnica? Gracias.'].join('\n'));
  }
  waOrder(o) {
    const lang = this.state.lang || 'es';
    const L = ['*PEDIDO LYOS PROFESIONAL* 🖤', '', 'Hola LYOS Profesional, acabo de armar mi pedido por la web:', ''];
    o.lines.forEach(l => {
      const pName = lang === 'en' && l.p.name_en ? l.p.name_en : lang === 'pt' && l.p.name_pt ? l.p.name_pt : lang === 'kr' && l.p.name_kr ? l.p.name_kr : l.p.name;
      L.push('▸ ' + pName + ' (' + l.v.ml + ') × ' + l.qty + ' — ' + money(l.total, lang));
    });
    L.push('', 'Subtotal: ' + money(o.sub, lang));
    if (o.disc > 0) L.push('Descuento Cupón: -' + money(o.disc, lang));
    L.push('*TOTAL ESTIMADO: ' + money(o.total, lang) + '*');
    if (o.email) L.push('', '📧 Correo: ' + o.email);
    L.push('', '¡Hola! Quiero confirmar este pedido para coordinar mi dirección de entrega y datos de pago. ¡Gracias! ✨', '', '_Orden ' + o.id + ' · ' + o.date + '_');
    return this.wa(L.join('\n'));
  }

  add(id, vi, qty) {
    const p = this.prod(id);
    if (!p) return;
    if (p.quote) { window.open(this.waQuote(p, p.variants[vi || 0]), '_blank'); return; }
    const key = id + '|' + (vi || 0);
    this.setState(s => {
      const found = s.cart.find(i => i.key === key);
      return { cart:found ? s.cart.map(i => i.key === key ? { ...i, qty:i.qty + (qty || 1) } : i) : [...s.cart, { key, id, vi:vi || 0, qty:qty || 1 }] };
    });
    const lang = this.state.lang || 'es';
    const pName = lang === 'en' && p.name_en ? p.name_en : lang === 'pt' && p.name_pt ? p.name_pt : lang === 'kr' && p.name_kr ? p.name_kr : p.name;
    const toastTitle = lang === 'en' ? 'Added to bag!' : lang === 'pt' ? 'Adicionado ao carrinho!' : lang === 'kr' ? '장바구니에 담겼습니다!' : '¡Añadido al carrito con éxito!';
    this.toast('check_circle', toastTitle, pName + ' · ' + p.variants[vi || 0].ml + ' (Stock OK)', '#25D366', true);
  }
  setQty(key, d) { this.setState(s => ({ cart:s.cart.map(i => i.key === key ? { ...i, qty:Math.max(1, i.qty + d) } : i) })); }
  remove(key) { this.setState(s => ({ cart:s.cart.filter(i => i.key !== key) })); }
  toggleFav(id) {
    const isFav = this.state.fav.includes(id);
    const p = this.prod(id);
    this.setState(s => ({ fav:isFav ? s.fav.filter(x => x !== id) : [...s.fav, id] }));
    const lang = this.state.lang || 'es';
    const pName = p ? (lang === 'en' && p.name_en ? p.name_en : lang === 'pt' && p.name_pt ? p.name_pt : lang === 'kr' && p.name_kr ? p.name_kr : p.name) : '';
    this.toast(isFav ? 'favorite_border' : 'favorite', isFav ? 'Eliminado de favoritos' : 'Guardado en favoritos', pName, isFav ? '#9A9184' : '#E0245E', false);
  }

  lines() {
    return this.state.cart.map(i => {
      if (i.id === 'bundle') {
        const b = BUNDLES.find(x => x.id === i.bundleId) || BUNDLES[0];
        const curLang = this.state.lang || 'es';
        const localizedName = curLang === 'en' && b.name_en ? b.name_en : b.name;
        return {
          ...i,
          p:{ name:localizedName, name_en:b.name_en, img:b.img },
          v:{ ml:'Kit Completo', price:b.price },
          unit:b.price,
          total:b.price * i.qty
        };
      }
      const p = this.prod(i.id), v = p.variants[i.vi];
      return { ...i, p, v, unit:v.price, total:v.price * i.qty };
    });
  }
  sub() { return this.lines().reduce((a, l) => a + l.total, 0); }
  ship() {
    const c = CARRIERS.find(x => x.id === this.state.carrier) || CARRIERS[0];
    const isFree = this.sub() >= 150000 && c.id !== 'moto' && c.id !== 'pick';
    return isFree ? 0 : c.price;
  }
  fee() { const p = PAYS.find(x => x.id === this.state.pay); return p && p.fee ? p.fee : 0; }
  disc() { return this.state.couponOk ? Math.round(this.sub() * 0.1) : 0; }
  grand() { return this.sub() + this.ship() + this.fee() - this.disc(); }
  applyCoupon() {
    const ok = this.state.coupon.trim().toUpperCase() === 'LYOS10';
    this.setState({ couponOk:ok });
    this.toast(ok ? 'redeem' : 'error', ok ? '¡Cupón LYOS10 Aplicado!' : 'Cupón Inválido', ok ? '10% de descuento directo en tu orden' : 'Revisa el código e intenta de nuevo', ok ? '#25D366' : '#C4392E', false);
  }

  addBundle(bId) {
    const b = BUNDLES.find(x => x.id === bId);
    if (!b) return;
    const key = 'bundle|' + bId;
    this.setState(s => {
      const found = s.cart.find(i => i.key === key);
      return {
        cart:found
          ? s.cart.map(i => i.key === key ? { ...i, qty:i.qty + 1 } : i)
          : [...s.cart, { key, id:'bundle', bundleId:bId, qty:1 }]
      };
    });
    const curLang = this.state.lang || 'es';
    const localizedName = curLang === 'en' && b.name_en ? b.name_en : b.name;
    this.toast('redeem', '¡Combo Añadido!', localizedName + ' (' + money(b.price, curLang) + ')', '#25D366', true);
  }

  getQuizResult() {
    const S = this.state;
    const curLang = S.lang || 'es';
    const hairOpt = QUIZ_HAIR_OPTIONS.find(x => x.id === S.quizHair) || QUIZ_HAIR_OPTIONS[0];
    const goalOpt = QUIZ_GOAL_OPTIONS.find(x => x.id === S.quizGoal) || QUIZ_GOAL_OPTIONS[0];
    const profileOpt = QUIZ_PROFILE_OPTIONS.find(x => x.id === S.quizProfile) || QUIZ_PROFILE_OPTIONS[0];

    let b;
    let title, desc, badge;
    if (S.quizHair === 'crespo' || S.quizHair === 'ondulado' || S.quizGoal === 'liso') {
      b = BUNDLES[0];
      title = curLang === 'en' ? 'Total Mirror Straight Routine' : 'Rutina Liso Espejo Total';
      desc = curLang === 'en' ? 'Designed for frizz elimination, long-lasting silkiness, and thermal protection.' : 'Diseñada para alinear la fibra rebelde, sellar cutícula con Ácido Hialurónico puro y proteger del calor por 4-6 meses.';
      badge = 'Protocolo #1 Más Vendido';
    } else if (S.quizHair === 'decolorado' || S.quizGoal === 'reparacion') {
      b = BUNDLES[1];
      title = curLang === 'en' ? 'Deep Hair Nutrition & Repair Routine' : 'Rutina Nutrición & Reparación Lipídica';
      desc = curLang === 'en' ? 'Formulated to recover elasticity, close split ends, and deeply hydrate.' : 'Especial para recuperar elasticidad, sellar puntas abiertas y reponer masa proteica con Manteca de Murumuru.';
      badge = 'Protocolo Reparación Intensiva';
    } else {
      b = BUNDLES[2];
      title = curLang === 'en' ? 'Daily Thermal Shield & Gloss Routine' : 'Rutina Termo-Protección & Brillo Diario';
      desc = curLang === 'en' ? 'Essential daily defense against flat iron, blow dryer, and UV damage with weightless shine.' : 'Blindaje diario contra el calor de la plancha, secador y rayos UV sin aportar peso graso.';
      badge = 'Protocolo Blindaje Térmico';
    }

    const localizedItems = curLang === 'en' && b.items_en ? b.items_en : b.items;

    return {
      title,
      desc,
      badge,
      img: b.img,
      priceLabel: money(b.price, curLang),
      oldPriceLabel: money(b.oldPrice, curLang),
      saveLabel: curLang === 'en' ? b.saveText_en : b.saveText,
      hairLabel: hairOpt.title,
      goalLabel: goalOpt.title,
      profileLabel: profileOpt.title,
      items: localizedItems.map(it => ({ name: it })),
      waLink: this.wa(`Hola LYOS Profesional, realicé el Diagnóstico Capilar en la web para cabello *${hairOpt.title}* con objetivo *${goalOpt.title}*. Me recomendó el *${b.name}*. Quiero ordenar mi kit con asesoría técnica.`),
      add: () => this.addBundle(b.id)
    };
  }

  roiGross() { return (this.state.roiClients || 12) * (this.state.roiPrice || 220000); }
  roiCost() { return (this.state.roiClients || 12) * 22857; }
  roiNet() { return Math.max(0, this.roiGross() - this.roiCost()); }
  roiMargin() {
    const c = this.roiCost();
    return c > 0 ? Math.round((this.roiNet() / c) * 100) : 0;
  }

  sendOrder() {
    const c = CARRIERS.find(x => x.id === this.state.carrier) || CARRIERS[0];
    const o = {
      id:this.oid(), lines:this.lines(), sub:this.sub(), ship:this.ship(), fee:this.fee(), disc:this.disc(),
      total:this.grand(), carrier:c, pay:PAYS.find(x => x.id === this.state.pay) || PAYS[0],
      guide:c.id.toUpperCase() + '-' + Math.floor(10000000 + Math.random() * 89999999),
      code:String(Math.floor(1000 + Math.random() * 8999)).split(''),
      email:this.f.email ? this.f.email.trim() : '',
      name:this.f.name ? this.f.name.trim() : '',
      phone:this.f.phone ? this.f.phone.trim() : '',
      city:this.f.city ? this.f.city.trim() : '',
      addr:this.f.addr ? this.f.addr.trim() : '',
      notes:this.f.notes ? this.f.notes.trim() : '',
      date:new Date().toLocaleString('es-CO', { dateStyle:'medium', timeStyle:'short' })
    };
    window.open(this.waOrder(o), '_blank');
    this.setState({ order:o, co:2, cart:[], err:'', track:0, couponOk:false, coupon:'' });
    this.toast('celebration', '¡Pedido Enviado a WhatsApp!', o.id + ' · Te respondemos en segundos', '#25D366', false);
  }
  copySummary() {
    const o = this.state.order; if (!o) return;
    const curLang = this.state.lang || 'es';
    const t = ['PEDIDO ' + o.id + ' · LYOS PROFESIONAL']
      .concat(o.lines.map(l => l.qty + ' x ' + l.p.name + ' (' + l.v.ml + ') — ' + money(l.total, curLang)))
      .concat(['Total: ' + money(o.total, curLang), 'Guía: ' + o.guide, 'Estado: ' + TRACK[this.state.track].label]).join('\n');
    try { navigator.clipboard.writeText(t); } catch (e) {}
    this.setState({ copied:true });
    setTimeout(() => this.setState({ copied:false }), 2200);
    this.toast('content_copy', 'Resumen Copiado', 'Listo para pegar en WhatsApp o notas', '#25D366', false);
  }

  renderVals() {
    const S = this.state;
    const curLang = S.lang || 'es';
    const activeLang = LANGS.find(x => x.id === curLang) || LANGS[0];
    const chip = 'height:40px;padding:0 18px;border-radius:999px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;scroll-snap-align:start;flex:none;transition:all .25s;';
    const seg = 'display:flex;align-items:center;gap:7px;height:44px;padding:0 18px;border-radius:999px;border:0;cursor:pointer;font-weight:700;font-size:13.5px;white-space:nowrap;transition:all .25s;';
    const q = S.q.trim().toLowerCase();

    const quoteTxt = curLang === 'en' ? 'Quote' : curLang === 'pt' ? 'Cotar' : curLang === 'kr' ? '견적 문의' : 'Cotizar';
    const fromTxt = curLang === 'en' ? 'From ' : curLang === 'pt' ? 'A partir de ' : curLang === 'kr' ? '시작가 ' : 'Desde ';
    const buyTxt = curLang === 'en' ? 'Buy now' : curLang === 'pt' ? 'Comprar agora' : curLang === 'kr' ? '지금 구매' : 'Comprar ahora';

    const dec = p => {
      const prices = p.variants.map(v => v.price).filter(x => x != null);
      const min = prices.length ? Math.min(...prices) : null;
      const max = prices.length ? Math.max(...prices) : null;
      const isFav = S.fav.includes(p.id);
      const localizedName = curLang === 'en' && p.name_en ? p.name_en : curLang === 'pt' && p.name_pt ? p.name_pt : curLang === 'kr' && p.name_kr ? p.name_kr : p.name;
      const localizedShort = curLang === 'en' && p.short_en ? p.short_en : curLang === 'pt' && p.short_pt ? p.short_pt : curLang === 'kr' && p.short_kr ? p.short_kr : p.short;
      return {
        ...p,
        name: localizedName,
        short: localizedShort,
        priceLabel:p.quote ? quoteTxt : (min === max ? money(min, curLang) : fromTxt + money(min, curLang)),
        sizeLabel:p.variants.map(v => v.ml).join(' · '),
        isFav,
        favColor:isFav ? '#E0245E' : 'var(--mut)',
        favIcon:isFav ? 'favorite' : 'favorite_border',
        ctaBg:p.quote ? 'var(--surf3)' : 'var(--goldGrad)',
        ctaFg:p.quote ? 'var(--txt)' : 'var(--onGold)',
        ctaShadow:p.quote ? 'none' : '0 12px 30px -12px rgba(168,124,47,.7)',
        ctaIcon:p.quote ? 'chat' : 'bolt',
        ctaLabel:p.quote ? quoteTxt : buyTxt,
        open:() => this.setState({ qv:p.id, qvVar:0, qvImg:0, qvQty:1 }),
        buy:() => p.quote ? window.open(this.waQuote(p, p.variants[0]), '_blank') : this.setState({ buy:p.id, buyVar:0, buyQty:1 }),
        add:() => this.add(p.id, 0, 1),
        fav:() => this.toggleFav(p.id)
      };
    };

    const all = PRODUCTS.map(dec);
    const products = all.filter(p => {
      if (S.cat === 'Todos') return true;
      if (S.cat === 'Mascarilla') return p.cat === 'Tratamiento' || p.id === 'tratamiento';
      return p.cat === S.cat;
    }).map((p, i) => ({ ...p, imgOrder:i % 2 === 1 ? 2 : 1 }));
    const results = q ? all.filter(p => (p.name + ' ' + p.cat + ' ' + p.desc).toLowerCase().includes(q)) : all.slice(0, 4);

    const qp = S.qv ? dec(this.prod(S.qv)) : null;
    const qvV = qp ? qp.variants[S.qvVar] : null;
    const bp = S.buy ? dec(this.prod(S.buy)) : null;
    const bv = bp ? bp.variants[S.buyVar] : null;

    const lines = this.lines(), sub = this.sub(), ship = this.ship();

    // Filter FAQs based on active category & search query
    const filteredFaqs = FAQS.filter(f => {
      const matchCat = S.faqCat === 'all' || f.cat === S.faqCat;
      const fq = S.faqQuery.trim().toLowerCase();
      const matchQuery = !fq || (f.q + ' ' + f.a).toLowerCase().includes(fq);
      return matchCat && matchQuery;
    });

    return {
      theme:S.theme, themeIcon:S.theme === 'dark' ? 'dark_mode' : 'light_mode',
      toggleTheme:() => this.setState(s => ({ theme:s.theme === 'dark' ? 'light' : 'dark' })),
      
      activeLang,
      langMenuOpen:S.langMenuOpen,
      toggleLangMenu:() => this.setState(s => ({ langMenuOpen:!s.langMenuOpen })),
      closeLangMenu:() => this.setState({ langMenuOpen:false }),
      langOptions:LANGS.map(l => ({
        ...l, active:l.id === curLang,
        pick:() => {
          this.setState({ lang:l.id, langMenuOpen:false });
          setTimeout(() => this.applyLang(), 20);
        }
      })),

      stop:e => e.stopPropagation(),
      waLink:this.wa('Hola LYOS Profesional, quiero información sobre la línea 👋'),
      calLink:CAL,

      heroA:S.hero === 'a', heroB:S.hero === 'b', heroC:S.hero === 'c', heroD:S.hero === 'd',
      heroOpts:HEROES.map(h => ({
        label:h.label, pick:() => this.setState({ hero:h.id }),
        style:'width:40px;height:34px;border-radius:999px;border:0;cursor:pointer;font-weight:700;font-size:13px;transition:all .25s;' + (S.hero === h.id ? 'background:var(--goldGrad);color:var(--onGold);' : 'background:transparent;color:var(--mut);')
      })),

      // Before & After Interactive Slider
      beforeAfterPos:S.beforeAfterPos,
      onBeforeAfterInput:e => this.setState({ beforeAfterPos:Number(e.target.value) }),

      isEditorial:S.grid === 'editorial', isGallery:S.grid === 'gallery',
      setEditorial:() => this.setState({ grid:'editorial' }), setGallery:() => this.setState({ grid:'gallery' }),
      edStyle:seg + (S.grid === 'editorial' ? 'background:var(--goldGrad);color:var(--onGold);' : 'background:transparent;color:var(--mut);'),
      glStyle:seg + (S.grid === 'gallery' ? 'background:var(--goldGrad);color:var(--onGold);' : 'background:transparent;color:var(--mut);'),

      cats:CATS.map(c => {
        const active = S.cat === c.id;
        const label = c[curLang] || c.es;
        return {
          id:c.id,
          label,
          icon:c.icon,
          count:c.count,
          active,
          pillStyle:'display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 18px;border-radius:999px;font-size:13px;font-weight:700;letter-spacing:.01em;cursor:pointer;white-space:nowrap;scroll-snap-align:start;flex:none;transition:all .25s;' +
            (active
              ? 'background:var(--goldGrad);color:var(--onGold);border:1.5px solid transparent;box-shadow:0 8px 22px -6px rgba(168,124,47,.65);transform:translateY(-1px);'
              : 'background:var(--surf);color:var(--txt);border:1.5px solid var(--line2);box-shadow:var(--e1);'),
          pillHover:active
            ? 'filter:brightness(1.08);transform:translateY(-2px);'
            : 'background:var(--surf2);border-color:var(--gold);color:var(--gold);transform:translateY(-1px);',
          pillIconStyle:'font-size:18px;' + (active ? 'color:var(--onGold);' : 'color:var(--gold);'),
          countStyle:'font-size:10.5px;font-weight:800;padding:2px 7px;border-radius:999px;' +
            (active
              ? 'background:rgba(0,0,0,.22);color:#FFFDF8;'
              : 'background:var(--surf3);color:var(--mut);border:1px solid var(--line);'),
          pick:() => this.setState({ cat:c.id })
        };
      }),
      products,

      // Bundles / Kits Module
      bundles:BUNDLES.map(b => {
        const localizedName = curLang === 'en' && b.name_en ? b.name_en : b.name;
        const localizedShort = curLang === 'en' && b.short_en ? b.short_en : b.short;
        const localizedItems = curLang === 'en' && b.items_en ? b.items_en : b.items;
        const localizedSave = curLang === 'en' && b.saveText_en ? b.saveText_en : b.saveText;
        return {
          ...b,
          name:localizedName,
          short:localizedShort,
          items:localizedItems,
          saveLabel:localizedSave,
          priceLabel:money(b.price, curLang),
          oldPriceLabel:money(b.oldPrice, curLang),
          add:() => this.addBundle(b.id),
          waLink:this.wa(`Hola LYOS Profesional, quiero adquirir el *${b.name}* en combo con descuento.`)
        };
      }),

      // Hair Quiz / Diagnóstico Capilar Virtual en 3 Pasos
      quizStep:S.quizStep,
      isQuizStep1:S.quizStep === 1,
      isQuizStep2:S.quizStep === 2,
      isQuizStep3:S.quizStep === 3,
      isQuizResult:S.quizStep === 4,
      quizStepPct: S.quizStep === 1 ? '33%' : S.quizStep === 2 ? '66%' : S.quizStep === 3 ? '99%' : '100%',
      canQuizPrev: S.quizStep > 1 && S.quizStep < 4,
      quizPrev: () => this.setState(s => ({ quizStep: Math.max(1, s.quizStep - 1) })),
      quizHairOptions:QUIZ_HAIR_OPTIONS.map(ho => {
        const isSelected = S.quizHair === ho.id;
        return {
          ...ho,
          isSelected,
          style:'display:flex;align-items:center;justify-content:space-between;gap:14px;padding:18px 20px;border-radius:24px;cursor:pointer;text-align:left;width:100%;transition:all .28s cubic-bezier(.2,.8,.2,1);' + (isSelected ? 'border:2px solid var(--gold);background:var(--surf2);box-shadow:0 10px 26px -6px rgba(168,124,47,.4);transform:translateY(-2px);' : 'border:1.5px solid var(--line2);background:var(--surf);box-shadow:var(--e1);'),
          iconStyle:'width:46px;height:46px;border-radius:16px;display:grid;place-items:center;flex:none;transition:all .25s;' + (isSelected ? 'background:var(--goldGrad);color:var(--onGold);box-shadow:0 6px 16px -4px rgba(168,124,47,.6);border:1px solid transparent;' : 'background:var(--surf3);color:var(--gold);border:1px solid var(--line2);'),
          checkIcon:isSelected ? 'check_circle' : 'radio_button_unchecked',
          checkColor:isSelected ? 'var(--gold)' : 'var(--dim)',
          pick:() => this.setState({ quizHair:ho.id, quizStep:2 })
        };
      }),
      quizGoalOptions:QUIZ_GOAL_OPTIONS.map(go => {
        const isSelected = S.quizGoal === go.id;
        return {
          ...go,
          isSelected,
          style:'display:flex;align-items:center;justify-content:space-between;gap:14px;padding:18px 20px;border-radius:24px;cursor:pointer;text-align:left;width:100%;transition:all .28s cubic-bezier(.2,.8,.2,1);' + (isSelected ? 'border:2px solid var(--gold);background:var(--surf2);box-shadow:0 10px 26px -6px rgba(168,124,47,.4);transform:translateY(-2px);' : 'border:1.5px solid var(--line2);background:var(--surf);box-shadow:var(--e1);'),
          iconStyle:'width:46px;height:46px;border-radius:16px;display:grid;place-items:center;flex:none;transition:all .25s;' + (isSelected ? 'background:var(--goldGrad);color:var(--onGold);box-shadow:0 6px 16px -4px rgba(168,124,47,.6);border:1px solid transparent;' : 'background:var(--surf3);color:var(--gold);border:1px solid var(--line2);'),
          checkIcon:isSelected ? 'check_circle' : 'radio_button_unchecked',
          checkColor:isSelected ? 'var(--gold)' : 'var(--dim)',
          pick:() => this.setState({ quizGoal:go.id, quizStep:3 })
        };
      }),
      quizProfileOptions:QUIZ_PROFILE_OPTIONS.map(po => {
        const isSelected = S.quizProfile === po.id;
        return {
          ...po,
          isSelected,
          style:'display:flex;align-items:center;justify-content:space-between;gap:14px;padding:18px 20px;border-radius:24px;cursor:pointer;text-align:left;width:100%;transition:all .28s cubic-bezier(.2,.8,.2,1);' + (isSelected ? 'border:2px solid var(--gold);background:var(--surf2);box-shadow:0 10px 26px -6px rgba(168,124,47,.4);transform:translateY(-2px);' : 'border:1.5px solid var(--line2);background:var(--surf);box-shadow:var(--e1);'),
          iconStyle:'width:46px;height:46px;border-radius:16px;display:grid;place-items:center;flex:none;transition:all .25s;' + (isSelected ? 'background:var(--goldGrad);color:var(--onGold);box-shadow:0 6px 16px -4px rgba(168,124,47,.6);border:1px solid transparent;' : 'background:var(--surf3);color:var(--gold);border:1px solid var(--line2);'),
          checkIcon:isSelected ? 'check_circle' : 'radio_button_unchecked',
          checkColor:isSelected ? 'var(--gold)' : 'var(--dim)',
          pick:() => this.setState({ quizProfile:po.id, quizStep:4 })
        };
      }),
      quizResult:this.getQuizResult(),
      quizReset:() => this.setState({ quizStep:1, quizHair:'crespo', quizGoal:'liso', quizProfile:'personal' }),

      // Calculadora de Rentabilidad para Salones (ROI)
      roiClients:S.roiClients,
      roiPrice:S.roiPrice,
      roiPriceLabel:money(S.roiPrice, curLang),
      roiGrossLabel:money(this.roiGross(), curLang),
      roiCostLabel:money(this.roiCost(), curLang),
      roiNetLabel:money(this.roiNet(), curLang),
      roiMargin:this.roiMargin(),
      onRoiClientsInput:e => this.setState({ roiClients:Number(e.target.value) }),
      onRoiPriceInput:e => this.setState({ roiPrice:Number(e.target.value) }),
      roiWaLink:this.wa(`Hola LYOS Profesional, revisé la Calculadora de Rentabilidad en la web y quiero pedir 1 Litro Profesional para mi salón con el precio mayorista.`),

      // Reviews Module (PRO, Minimalist & Modern)
      reviewCat:S.reviewCat,
      reviewCategories:[
        { id:'all', label:'✨ Todas las Reseñas', count:6 },
        { id:'liso', label:'💇‍♀️ Alisado Hialurónico', count:3 },
        { id:'reparacion', label:'🧴 Reparación & Blindaje', count:2 },
        { id:'academia', label:'🎓 Academia & Negocio', count:1 }
      ].map(rc => {
        const isSelected = S.reviewCat === rc.id;
        return {
          ...rc,
          style:'display:inline-flex;align-items:center;gap:7px;height:40px;padding:0 18px;border-radius:999px;font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap;transition:all .25s;' + (isSelected ? 'background:var(--goldGrad);color:var(--onGold);border:1.5px solid transparent;box-shadow:0 8px 20px -4px rgba(168,124,47,.55);transform:translateY(-1px);' : 'background:var(--surf);color:var(--txt);border:1.5px solid var(--line2);box-shadow:var(--e1);'),
          pick:() => this.setState({ reviewCat:rc.id })
        };
      }),
      reviewsList:REVIEWS_DATA.filter(r => S.reviewCat === 'all' || r.cat === S.reviewCat).map(r => ({
        ...r,
        isAcademy: r.badgeType === 'academy',
        isVerified: r.badgeType === 'verified'
      })),

      // FAQ VIP Interactivo
      faqQuery:S.faqQuery,
      onFaqQueryInput:e => this.setState({ faqQuery:e.target.value }),
      faqCategories:FAQ_CATEGORIES.map(fc => {
        const isSelected = S.faqCat === fc.id;
        return {
          ...fc,
          style:'display:inline-flex;align-items:center;gap:7px;height:38px;padding:0 16px;border-radius:999px;font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap;scroll-snap-align:start;transition:all .25s;' + (isSelected ? 'background:var(--goldGrad);color:var(--onGold);border:1px solid transparent;box-shadow:0 6px 16px -4px rgba(168,124,47,.5);' : 'background:var(--surf);color:var(--txt);border:1.5px solid var(--line2);'),
          pick:() => this.setState({ faqCat:fc.id })
        };
      }),
      faqsList:filteredFaqs.map(f => ({
        id:f.id,
        q:curLang === 'en' && f.q_en ? f.q_en : f.q,
        a:curLang === 'en' && f.a_en ? f.a_en : f.a,
        icon:f.icon,
        isOpen:S.faqOpen === f.id,
        toggle:() => this.setState(s => ({ faqOpen:s.faqOpen === f.id ? null : f.id }))
      })),

      // Blog Articles Carousel & Reader Modal
      articlesList:ARTICLES.map(art => {
        const title = curLang === 'en' && art.title_en ? art.title_en : art.title;
        const cat = curLang === 'en' && art.cat_en ? art.cat_en : art.cat;
        const excerpt = curLang === 'en' && art.excerpt_en ? art.excerpt_en : art.excerpt;
        return {
          ...art,
          title,
          cat,
          excerpt,
          open:() => this.setState({ activeArticle:art.id }),
          waCommentLink:this.wa(`Hola LYOS Profesional, estuve leyendo el artículo "${art.title}" en el Journal y me gustaría comentar sobre el protocolo técnico.`)
        };
      }),
      hasActiveArticle:!!S.activeArticle,
      activeArticleData:S.activeArticle ? (() => {
        const found = ARTICLES.find(x => x.id === S.activeArticle) || ARTICLES[0];
        const title = curLang === 'en' && found.title_en ? found.title_en : found.title;
        const cat = curLang === 'en' && found.cat_en ? found.cat_en : found.cat;
        return {
          ...found,
          title,
          cat,
          waLink:this.wa(`Hola LYOS Profesional, quiero información sobre el protocolo del artículo "${found.title}".`)
        };
      })() : null,
      closeArticleModal:() => this.setState({ activeArticle:null }),
      slideBlogPrev:() => {
        const el = document.getElementById('blog-track');
        if (el) el.scrollBy({ left:-380, behavior:'smooth' });
      },
      slideBlogNext:() => {
        const el = document.getElementById('blog-track');
        if (el) el.scrollBy({ left:380, behavior:'smooth' });
      },

      searchOpen:S.searchOpen, openSearch:() => this.setState({ searchOpen:true }),
      closeSearch:() => this.setState({ searchOpen:false, q:'' }),
      onSearch:e => this.setState({ q:e.target.value }),
      searchResults:results.map(r => ({ ...r, open:() => this.setState({ searchOpen:false, q:'', qv:r.id, qvVar:0, qvImg:0, qvQty:1 }) })),
      noResults:q.length > 1 && results.length === 0,

      hasCart:S.cart.length > 0, cartCount:S.cart.reduce((a, i) => a + i.qty, 0),
      cartOpen:S.cartOpen, openCart:() => this.setState({ cartOpen:true }), closeCart:() => this.setState({ cartOpen:false }),
      cartEmpty:lines.length === 0,
      cartLines:lines.map(l => {
        const localizedName = curLang === 'en' && l.p.name_en ? l.p.name_en : curLang === 'pt' && l.p.name_pt ? l.p.name_pt : curLang === 'kr' && l.p.name_kr ? l.p.name_kr : l.p.name;
        return {
          key:l.key, name:localizedName, ml:l.v.ml, img:l.p.img, qty:l.qty,
          totalLabel:money(l.total, curLang), unitLabel:money(l.unit, curLang),
          inc:() => this.setQty(l.key, 1), dec:() => this.setQty(l.key, -1), del:() => this.remove(l.key)
        };
      }),
      subLabel:money(sub, curLang),
      shipLabel:ship === 0 ? (curLang === 'en' ? 'Free' : curLang === 'pt' ? 'Grátis' : curLang === 'kr' ? '무료' : 'Gratis') : money(ship, curLang),
      grandLabel:money(this.grand(), curLang),
      hasFreeShipBar:sub > 0 && sub < 150000,
      freeShipLeft:money(Math.max(0, 150000 - sub), curLang),
      freeShipPct:Math.min(100, Math.round(sub / 150000 * 100)) + '%',

      qvP:qp, qvV, qvImgSrc:qp ? qp.gallery[S.qvImg] || qp.img : '',
      qvGallery:qp ? qp.gallery.map((g, i) => ({ src:g, pick:() => this.setState({ qvImg:i }), style:'width:58px;height:58px;flex:none;border-radius:16px;overflow:hidden;background:var(--plinth);cursor:pointer;padding:0;border:2px solid ' + (i === S.qvImg ? 'var(--gold)' : 'transparent') })) : [],
      qvVariants:qp ? qp.variants.map((v, i) => ({
        label:v.ml, price:v.price == null ? quoteTxt : money(v.price, curLang), pick:() => this.setState({ qvVar:i }),
        style:'flex:1;min-width:100px;padding:12px 14px;border-radius:18px;cursor:pointer;text-align:left;transition:all .2s;' + (i === S.qvVar ? 'border:1.5px solid var(--gold);background:var(--surf2);' : 'border:1.5px solid var(--line);background:transparent;')
      })) : [],
      qvBullets:qp ? qp.bullets : [],
      qvTotal:qvV ? (qvV.price == null ? quoteTxt : money(qvV.price * S.qvQty, curLang)) : '',
      qvQty:S.qvQty,
      qvInc:() => this.setState(s => ({ qvQty:s.qvQty + 1 })),
      qvDec:() => this.setState(s => ({ qvQty:Math.max(1, s.qvQty - 1) })),
      qvBuy:() => { const p = this.prod(S.qv); if (p.quote) { window.open(this.waQuote(p, p.variants[S.qvVar]), '_blank'); return; } this.setState({ buy:S.qv, buyVar:S.qvVar, buyQty:S.qvQty, qv:null }); },
      qvAdd:() => { this.add(S.qv, S.qvVar, S.qvQty); this.setState({ qv:null }); },
      qvCta:qp && qp.quote ? quoteTxt : buyTxt,
      closeQv:() => this.setState({ qv:null }),

      buyP:bp, buyV:bv, buyQty:S.buyQty, buyImg:bp ? bp.img : '',
      buyVariants:bp ? bp.variants.map((v, i) => ({
        label:v.ml, price:v.price == null ? quoteTxt : money(v.price, curLang), pick:() => this.setState({ buyVar:i }),
        style:'flex:1;min-width:92px;padding:11px 13px;border-radius:16px;cursor:pointer;text-align:left;transition:all .2s;' + (i === S.buyVar ? 'border:1.5px solid var(--gold);background:var(--surf2);' : 'border:1.5px solid var(--line);background:transparent;')
      })) : [],
      buyTotal:bv && bv.price != null ? money(bv.price * S.buyQty, curLang) : quoteTxt,
      buyInc:() => this.setState(s => ({ buyQty:s.buyQty + 1 })),
      buyDec:() => this.setState(s => ({ buyQty:Math.max(1, s.buyQty - 1) })),
      buyWa:bp && bv ? this.waSingle(bp, bv, S.buyQty) : '#',
      buyConfirm:() => { this.toast('celebration', 'Pedido enviado', bp.name + ' · te respondemos por WhatsApp'); this.setState({ buy:null }); },
      buyAddCart:() => { this.add(S.buy, S.buyVar, S.buyQty); this.setState({ buy:null }); },
      closeBuy:() => this.setState({ buy:null }),

      co:S.co, coOpen:S.co > 0, err:S.err, hasErr:!!S.err,
      openCo:() => this.setState({ cartOpen:false, co:S.cart.length ? 1 : 0, err:'' }),
      closeCo:() => this.setState({ co:0, addrSuggestions:[], isSearchingAddr:false }),
      onField:e => { this.f[e.target.name] = e.target.value; if (S.err) this.setState({ err:'' }); },
      onAddrInput:e => this.searchAddress(e.target.value),
      hasAddrSuggestions:S.addrSuggestions.length > 0,
      addrSuggestions:S.addrSuggestions.map(s => ({
        title:s.title, subtitle:s.subtitle,
        pick:() => this.pickAddrSuggestion(s)
      })),
      isSearchingAddr:S.isSearchingAddr,
      isGeolocating:S.isGeolocating,
      geolocateIcon:S.isGeolocating ? 'hourglass_top' : 'my_location',
      geolocateLabel:S.isGeolocating ? 'Buscando...' : 'Ubicación actual',
      geolocateUser:() => this.geolocateUser(),
      addrConfirmed:S.addrConfirmed,
      isCo1:S.co === 1, isCo2:S.co === 2,
      coTitle:S.co === 2 ? 'Seguimiento del pedido' : 'Confirmar pedido',
      coStep:S.co === 2 ? TRACK[S.track].label + ' · ' + (S.order ? S.order.carrier.name : '') : 'Datos de entrega, envío y pago',
      sendOrder:() => this.sendOrder(),
      carriers:CARRIERS.map(c => {
        const isFree = sub >= 150000 && c.id !== 'moto' && c.id !== 'pick';
        const pr = isFree ? 0 : c.price;
        const isSelected = S.carrier === c.id;
        return {
          ...c,
          isSelected,
          priceLabel:pr === 0 ? (curLang === 'en' ? 'Free' : curLang === 'pt' ? 'Grátis' : curLang === 'kr' ? '무료' : 'Gratis') : money(pr, curLang),
          pick:() => this.setState({ carrier:c.id }),
          style:'display:flex;gap:12px;align-items:center;width:100%;text-align:left;padding:12px 14px;border-radius:18px;cursor:pointer;transition:all .2s;' + (isSelected ? 'border:1.5px solid var(--gold);background:var(--surf3);box-shadow:0 4px 14px -4px rgba(168,124,47,.25);' : 'border:1.5px solid var(--line);background:transparent;'),
          dot:isSelected ? 'radio_button_checked' : 'radio_button_unchecked',
          dotColor:isSelected ? 'var(--gold)' : 'var(--dim)'
        };
      }),
      order:S.order, orderId:S.order ? S.order.id : '', orderDate:S.order ? S.order.date : '',
      orderEmail:S.order && S.order.email ? S.order.email : '',
      hasOrderEmail:S.order ? !!S.order.email : false,
      orderTotal:S.order ? money(S.order.total, curLang) : '', orderCarrier:S.order ? S.order.carrier.name : '',
      orderEta:S.order ? S.order.carrier.eta : '', orderGuide:S.order ? S.order.guide : '',
      orderAddr:S.order ? (S.order.addr || 'Recoge en tienda · Cl. 14 #65-64') : '',
      orderCity:S.order ? S.order.city : '', orderPhone:S.order ? S.order.phone : '',
      orderName:S.order ? S.order.name : '', orderPayName:S.order ? S.order.pay.name : '',
      orderSub:S.order ? money(S.order.sub, curLang) : '',
      orderShip:S.order ? (S.order.ship === 0 ? 'Gratis' : money(S.order.ship, curLang)) : '',
      orderHasFee:S.order ? S.order.fee > 0 : false, orderFee:S.order ? money(S.order.fee, curLang) : '',
      orderHasDisc:S.order ? S.order.disc > 0 : false, orderDisc:S.order ? money(S.order.disc, curLang) : '',
      orderCode:S.order ? S.order.code : [],
      orderLines:S.order ? S.order.lines.map(l => ({ name:l.p.name, ml:l.v.ml, qty:l.qty, total:money(l.total, curLang), img:l.p.img })) : [],
      waResend:S.order ? this.waOrder(S.order) : '#',

      pays:PAYS.map(p => {
        const isSelected = S.pay === p.id;
        return {
          ...p,
          isSelected,
          pick:() => this.setState({ pay:p.id }),
          style:'display:flex;gap:12px;align-items:center;width:100%;text-align:left;padding:12px 14px;border-radius:18px;cursor:pointer;transition:all .2s;' + (isSelected ? 'border:1.5px solid var(--gold);background:var(--surf3);box-shadow:0 4px 14px -4px rgba(168,124,47,.25);' : 'border:1.5px solid var(--line);background:transparent;'),
          dot:isSelected ? 'radio_button_checked' : 'radio_button_unchecked',
          dotColor:isSelected ? 'var(--gold)' : 'var(--dim)'
        };
      }),
      onCoupon:e => this.setState({ coupon:e.target.value }),
      applyCoupon:() => this.applyCoupon(),
      couponOk:S.couponOk, discLabel:'− ' + money(this.disc(), curLang), hasDisc:this.disc() > 0,
      hasFee:this.fee() > 0, feeLabel:money(this.fee(), curLang),

      trackNow:TRACK[S.track].label, trackNote:TRACK[S.track].note,
      trackPct:(S.track / (TRACK.length - 1) * 100) + '%',
      trackIsLast:S.track >= TRACK.length - 1,
      trackSteps:TRACK.map((t, i) => ({
        label:t.label, note:t.note, icon:t.icon, done:i <= S.track,
        color:i <= S.track ? 'var(--gold)' : 'var(--dim)',
        bg:i === S.track ? 'var(--surf2)' : 'transparent',
        border:i <= S.track ? '1.5px solid var(--gold)' : '1.5px solid var(--line)',
        pick:() => this.setState({ track:i }),
        chipStyle:'height:34px;padding:0 14px;border-radius:999px;border:0;cursor:pointer;font-size:12px;font-weight:700;white-space:nowrap;flex:none;transition:all .25s;' + (i === S.track ? 'background:var(--goldGrad);color:var(--onGold);' : 'background:var(--surf2);color:var(--mut);')
      })),
      trackAdvance:() => this.setState(s => ({ track:Math.min(TRACK.length - 1, s.track + 1) })),
      pushOn:S.push,
      togglePush:() => { this.setState(s => ({ push:!s.push })); this.toast('notifications_active', this.state.push ? 'Alertas desactivadas' : 'Alertas activadas', 'Te avisamos en cada movimiento del envío'); },
      pushStyle:'display:inline-flex;align-items:center;gap:7px;height:40px;padding:0 15px;border-radius:999px;cursor:pointer;font-size:12.5px;font-weight:700;transition:all .25s;' + (S.push ? 'background:var(--goldGrad);color:var(--onGold);border:1px solid transparent;' : 'background:transparent;color:var(--txt);border:1px solid var(--line2);'),
      copySummary:() => this.copySummary(),
      copyLabel:S.copied ? 'Copiado' : 'Copiar resumen',
      copyIcon:S.copied ? 'check' : 'content_copy',

      intents:INTENTS.map(i => ({
        ...i, pick:() => this.setState({ intent:i.id }),
        style:'display:inline-flex;align-items:center;gap:8px;height:46px;padding:0 20px;border-radius:999px;cursor:pointer;font-size:13.5px;font-weight:700;transition:all .28s cubic-bezier(.2,.8,.2,1);' + (S.intent === i.id ? 'background:var(--goldGrad);color:var(--onGold);border:1px solid transparent;box-shadow:0 8px 24px -6px rgba(168,124,47,.7);transform:scale(1.03);' : 'background:var(--surf);color:var(--txt);border:1px solid var(--line2);box-shadow:var(--e1);')
      })),
      isBuyIntent:S.intent === 'comprar', isBookIntent:S.intent !== 'comprar',
      bookTitle:BOOK[S.intent] ? BOOK[S.intent].title : '',
      bookText:BOOK[S.intent] ? BOOK[S.intent].text : '',
      calIntent:CAL + '?intent=' + S.intent,
      waIntent:this.wa(BOOK[S.intent] ? BOOK[S.intent].wa : 'Hola LYOS, quiero información.'),
      waAcademia:this.wa('Hola LYOS Academia, quiero información de los cursos: fechas, inversión y qué incluye.'),
      waBlog:this.wa('Hola LYOS, tengo un tema que me gustaría ver en el blog: '),
      subscribe:() => this.toast('mark_email_read', 'Listo', 'Te avisamos de lanzamientos y novedades'),

      toasts:S.toasts.map(t => ({ ...t, close:() => this.setState(s => ({ toasts:s.toasts.filter(x => x.id !== t.id) })) })),
      installReady:S.installReady,
      install:() => { if (this.prompt) { this.prompt.prompt(); this.prompt = null; this.setState({ installReady:false }); } },
      rootRef:this.root
    };
  }
}
</script>
</body>
</html>
