            <a href="{{ waIntent }}" target="_blank" style="display:flex;align-items:center;justify-content:center;gap:10px;height:52px;border-radius:999px;border:1px solid var(--line2);background:var(--surf);color:var(--txt);font-weight:600;font-size:14.5px;transition:all .25s" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold)">
