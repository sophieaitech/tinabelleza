<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
<!-- Cal.com Embed Engine -->
<script type="text/javascript">
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", "lyospro", {origin:"https://app.cal.com"});
  Cal.config = Cal.config || {};
  Cal.config.forwardQueryParams = true;
</script>
</head>
<body>
<x-dc>
<helmet data-dc-atomics>
<title>LYOS Profesional | Cuidado Capilar &amp; Alisados 0% Formol · Cali, Colombia</title>
<meta name="description" content="Fórmulas de grado salón con Ácido Hialurónico puro y Manteca de Murumuru. Liso espejo, reparación profunda, academia capilar y envíos a todo Colombia.">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#FBF8F2">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="LYOS">

<!-- OpenGraph & Social Media Meta Tags -->
<meta property="og:site_name" content="LYOS Profesional">
<meta property="og:title" content="LYOS Profesional | Fórmulas Capilares 0% Formol &amp; Brillo Espejo">
<meta property="og:description" content="Alisados orgánicos con Ácido Hialurónico y Manteca de Murumuru. 0% humo, 0% formol, avalado por +4.200 salones.">
<meta property="og:image" content="assets/liso-hialuronico.jpg">
<meta property="og:type" content="website">
<meta property="og:locale" content="es_CO">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="LYOS Profesional | Cuidado Capilar de Lujo">
<meta name="twitter:description" content="Liso espejo duradero y reparación botánica sin formol. Envíos a todo Colombia.">
<meta name="twitter:image" content="assets/liso-hialuronico.jpg">

<!-- Schema.org JSON-LD Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HairSalon",
  "name": "LYOS Profesional",
  "image": "assets/liso-hialuronico.jpg",
  "description": "Marca premium de cuidado capilar y alisados sin formol en Cali, Colombia.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Cl. 14 #65-64",
    "addressLocality": "Cali",
    "addressRegion": "Valle del Cauca",
    "addressCountry": "CO"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "670"
  },
  "telephone": "+573135959808",
  "priceRange": "$$"
}
</script>

<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@200..900&family=DM+Sans:opsz,wght@9..40,300..700&family=Kaushan+Script&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0&display=swap" rel="stylesheet">
<style>
:root{
--bg:#FBF8F2;--bg2:#F5EEE2;--surf:#FFFFFF;--surf2:#FAF5EC;--surf3:#F1E7D6;
--line:rgba(28,22,12,.10);--line2:rgba(28,22,12,.19);
--txt:#16120D;--mut:#6A6154;--dim:#9A9184;
--gold:#A87C2F;--goldi:#C9A45C;--gold2:#8A6425;--onGold:#FFFDF7;
--goldGrad:linear-gradient(120deg,#E2C88E,#C39D51 44%,#8A6425);
--goldLine:linear-gradient(90deg,transparent,#C9A45C,transparent);
--plinth:linear-gradient(165deg,#FFFEFB 0%,#F5EDDF 55%,#E8DCC5 100%);
--glass:rgba(251,248,242,.8);
--e1:0 1px 2px rgba(60,45,20,.07);--e2:0 10px 30px -12px rgba(60,45,20,.2);--e3:0 26px 70px -22px rgba(60,45,20,.3);
}
[data-theme="dark"]{
--bg:#0B0A08;--bg2:#100E0B;--surf:#16130F;--surf2:#1E1A14;--surf3:#272118;
--line:rgba(232,214,180,.13);--line2:rgba(232,214,180,.26);
--txt:#F7F2E9;--mut:#A79E90;--dim:#726A5E;
--gold:#D9B679;--goldi:#F1DEB8;--gold2:#F1DEB8;--onGold:#1A1409;
--goldGrad:linear-gradient(120deg,#F1DEB8,#D9B679 46%,#A97C3F);
--glass:rgba(18,15,12,.76);
--e1:0 1px 2px rgba(0,0,0,.5);--e2:0 10px 30px -12px rgba(0,0,0,.7);--e3:0 26px 70px -22px rgba(0,0,0,.85);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--txt);font-family:'DM Sans',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;text-wrap:pretty;overflow-x:hidden;zoom:0.86;transition:background-color .3s ease,color .3s ease}
a{color:var(--gold);text-decoration:none}
a:hover{color:var(--gold2)}
input,button,select,textarea{font:inherit;color:inherit;background:transparent}
.mi{font-family:'Material Symbols Rounded';font-weight:400;font-style:normal;line-height:1;letter-spacing:normal;text-transform:none;display:inline-block;white-space:nowrap;direction:ltr;font-variation-settings:'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24;user-select:none}
.mio{font-variation-settings:'FILL' 0,'wght' 300,'GRAD' 0,'opsz' 24}
.hs{scrollbar-width:none;-ms-overflow-style:none}
.hs::-webkit-scrollbar{display:none}
.desk{display:none!important}
.fab{position:fixed;right:14px;bottom:calc(88px + env(safe-area-inset-bottom));z-index:70;display:flex;flex-direction:column;gap:12px;align-items:flex-end}
.hero{position:relative;overflow:hidden;min-height:clamp(520px,88vh,860px)}
:root{--navPad:84px}
@media(min-width:940px){:root{--navPad:0px}}
@media(min-width:940px){.desk{display:flex!important}.mob{display:none!important}.fab{bottom:28px;right:28px}}
@keyframes mq{to{transform:translateX(-50%)}}
@keyframes fadeup{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
@keyframes ping{0%{opacity:.6;transform:scale(.6)}70%,100%{opacity:0;transform:scale(2.4)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes slidein{from{opacity:0;transform:translateY(26px) scale(.98)}to{opacity:1;transform:none}}
@keyframes kb{from{transform:scale(1.06)}to{transform:scale(1.14)}}
@keyframes swipeHint{0%,100%{transform:translateX(0)}50%{transform:translateX(-7px)}}
@keyframes arrowPulse{0%,100%{transform:translateX(0);opacity:1}50%{transform:translateX(5px);opacity:.5}}
</style>
</helmet>
<div id="app" ref="{{ rootRef }}" data-theme="{{ theme }}" style="min-height:100dvh;background:var(--bg);color:var(--txt);padding-bottom:calc(76px + env(safe-area-inset-bottom));position:relative;overflow:hidden">

<header style="position:sticky;top:0;z-index:60;backdrop-filter:blur(28px) saturate(1.6);-webkit-backdrop-filter:blur(28px) saturate(1.6);background:var(--glass);border-bottom:1px solid var(--line);transition:background-color .3s, border-color .3s">
  <div style="max-width:1320px;margin:0 auto;padding:10px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px">
    
    <!-- BRAND LOGO -->
    <a href="#inicio" aria-label="LYOS Profesional Inicio" style="display:flex;flex-direction:column;line-height:1;padding:4px 0;text-decoration:none;flex:none;transition:transform .2s" style-hover="transform:scale(1.02)">
      <span style="font-family:'Outfit',sans-serif;font-weight:800;font-size:26px;letter-spacing:-.04em;color:var(--txt)">LY<span style="color:var(--gold);background:var(--goldGrad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">O</span>S</span>
      <span style="font-size:8px;letter-spacing:.48em;color:var(--mut);font-weight:700;margin-top:2px">PROFESIONAL</span>
    </a>

    <!-- DESKTOP MINIMALIST NAVIGATION (4 PERSUASIVE ESSENTIALS) -->
    <nav class="desk" style="display:flex;align-items:center;gap:4px;padding:4px 6px;border-radius:999px;background:var(--surf2);border:1px solid var(--line)">
      <a href="#productos" style="padding:7px 16px;border-radius:999px;font-size:13px;font-weight:600;letter-spacing:.01em;color:var(--txt);transition:all .22s;text-decoration:none" style-hover="background:var(--surf);color:var(--gold);box-shadow:var(--e1)"><span data-i18n="nav_products">Productos</span></a>
      <a href="#comparador" style="padding:7px 16px;border-radius:999px;font-size:13px;font-weight:600;letter-spacing:.01em;color:var(--txt);transition:all .22s;text-decoration:none" style-hover="background:var(--surf);color:var(--gold);box-shadow:var(--e1)"><span data-i18n="nav_before_after">Antes &amp; Después</span></a>
      <a href="#resenas" style="padding:7px 16px;border-radius:999px;font-size:13px;font-weight:600;letter-spacing:.01em;color:var(--txt);transition:all .22s;text-decoration:none" style-hover="background:var(--surf);color:var(--gold);box-shadow:var(--e1)"><span data-i18n="nav_success_stories">Casos de Éxito</span></a>
      <a href="#contacto" style="padding:7px 16px;border-radius:999px;font-size:13px;font-weight:600;letter-spacing:.01em;color:var(--txt);transition:all .22s;text-decoration:none" style-hover="background:var(--surf);color:var(--gold);box-shadow:var(--e1)"><span data-i18n="nav_vip_support">Asesoría VIP</span></a>
    </nav>

    <!-- RIGHT RAIL / UTILITY & PRIMARY CTA -->
    <div style="display:flex;align-items:center;gap:8px">
      
      <!-- Instant Search Trigger -->
      <button onClick="{{ openSearch }}" aria-label="Buscar producto" title="Buscar fórmulas y productos" style="width:39px;height:39px;border:1px solid var(--line2);background:var(--surf);border-radius:999px;display:grid;place-items:center;cursor:pointer;color:var(--txt);transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold);transform:translateY(-1px)">
        <span class="mi mio" style="font-size:19px">search</span>
      </button>

      <!-- Theme Toggle (Luna / Sol) -->
      <button onClick="{{ toggleTheme }}" aria-label="Cambiar tema claro/oscuro" title="Cambiar tema claro / oscuro" style="width:39px;height:39px;border:1px solid var(--line2);background:var(--surf);border-radius:999px;display:grid;place-items:center;cursor:pointer;color:var(--txt);transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf2);border-color:var(--gold);transform:translateY(-1px)">
        <span class="mi mio" style="font-size:19px;color:var(--gold)">{{ themeIcon }}</span>
      </button>
      
      <!-- Multi-Language & Currency Selector -->
      <div style="position:relative">
        <button onClick="{{ toggleLangMenu }}" aria-label="Cambiar idioma y divisa" style="height:39px;padding:0 10px 0 6px;border:1px solid var(--line2);background:var(--surf);border-radius:999px;display:flex;align-items:center;gap:6px;cursor:pointer;font-size:12px;font-weight:700;color:var(--txt);transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf2);border-color:var(--gold);transform:translateY(-1px)">
          <img src="{{ activeLang.flagSrc }}" alt="{{ activeLang.name }}" width="20" height="20" style="width:20px;height:20px;border-radius:50%;object-fit:cover;flex:none;box-shadow:0 1px 4px rgba(0,0,0,.2);border:1px solid var(--line2);display:block" />
          <span style="font-weight:800;font-size:11.5px;letter-spacing:.04em;color:var(--txt)">{{ activeLang.code }}</span>
          <span style="font-size:9.5px;color:var(--gold);font-weight:800;padding:1px 6px;border-radius:999px;background:var(--surf3);letter-spacing:.03em;border:1px solid rgba(212,175,55,.2)">{{ activeLang.curr }}</span>
          <span class="mi" style="font-size:15px;color:var(--mut);margin-left:-3px">expand_more</span>
        </button>

        <sc-if value="{{ langMenuOpen }}" hint-placeholder-val="{{ false }}">
          <div onClick="{{ stop }}" style="position:absolute;top:calc(100% + 8px);right:0;width:268px;background:var(--surf);backdrop-filter:blur(28px);-webkit-backdrop-filter:blur(28px);border:1.5px solid var(--line2);border-radius:24px;padding:10px;box-shadow:0 22px 55px -12px rgba(0,0,0,.45),var(--e3);z-index:90;animation:slidein .25s cubic-bezier(.2,.8,.2,1);display:grid;gap:4px">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:6px 10px 8px;border-bottom:1px solid var(--line);margin-bottom:3px">
              <span style="display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)">
                <span class="mi" style="font-size:13px">public</span>
                <span>Idioma &amp; Moneda</span>
              </span>
              <span style="font-size:9.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--mut)">
                Divisa
              </span>
            </div>
            <sc-for list="{{ langOptions }}" as="lo" hint-placeholder-count="4">
              <button onClick="{{ lo.pick }}" style="display:flex;align-items:center;justify-content:space-between;width:100%;padding:9px 11px;border-radius:16px;border:1.5px solid {{ lo.active ? 'var(--gold)' : 'transparent' }};background:{{ lo.active ? 'var(--surf3)' : 'transparent' }};cursor:pointer;color:var(--txt);transition:all .2s;text-align:left" style-hover="background:var(--surf2);transform:translateX(2px)">
                <span style="display:flex;align-items:center;gap:10px;min-width:0">
                  <img src="{{ lo.flagSrc }}" alt="{{ lo.name }}" width="22" height="22" style="width:22px;height:22px;border-radius:50%;object-fit:cover;flex:none;box-shadow:0 2px 6px rgba(0,0,0,.2);border:1px solid var(--line2);display:block" />
                  <span style="display:flex;flex-direction:column;line-height:1.2">
                    <span style="font-size:13.5px;font-weight:{{ lo.active ? '800' : '600' }};color:var(--txt)">{{ lo.name }}</span>
                    <span style="font-size:10.5px;color:var(--mut);font-weight:600">{{ lo.region }}</span>
                  </span>
                </span>
                <div style="display:flex;align-items:center;gap:6px">
                  <span style="font-size:11px;font-weight:800;padding:3px 8px;border-radius:999px;background:{{ lo.active ? 'var(--goldGrad)' : 'var(--surf2)' }};color:{{ lo.active ? 'var(--onGold)' : 'var(--mut)' }};border:1px solid {{ lo.active ? 'transparent' : 'var(--line2)' }};box-shadow:{{ lo.active ? '0 3px 8px -2px rgba(168,124,47,.5)' : 'none' }}">
                    {{ lo.curr }}
                  </span>
                </div>
              </button>
            </sc-for>
          </div>
        </sc-if>
      </div>

      <!-- Primary High-Impact CTA Button (Tienda / Comprar) -->
      <a href="#productos" class="desk" style="height:39px;padding:0 18px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:700;font-size:12.5px;letter-spacing:.02em;display:flex;align-items:center;gap:7px;transition:all .25s;box-shadow:0 6px 18px -4px rgba(168,124,47,.5);white-space:nowrap;text-decoration:none" style-hover="filter:brightness(1.08);transform:translateY(-1px);box-shadow:0 10px 24px -4px rgba(168,124,47,.7)">
        <span class="mi" style="font-size:16px">storefront</span>
        <span data-i18n="nav_shop">Tienda LYOS</span>
      </a>

      <!-- VIP Cart Trigger with Counter Badge -->
      <button onClick="{{ openCart }}" aria-label="Ver carrito" title="Carrito de compras" style="position:relative;width:39px;height:39px;border:1px solid var(--line2);background:var(--surf);border-radius:999px;display:grid;place-items:center;cursor:pointer;color:var(--txt);transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf2);border-color:var(--gold);transform:translateY(-1px)">
        <span class="mi mio" style="font-size:20px">shopping_bag</span>
        <sc-if value="{{ hasCart }}" hint-placeholder-val="{{ false }}">
          <span style="position:absolute;top:-3px;right:-3px;min-width:18px;height:18px;padding:0 4px;border-radius:999px;background:var(--gold);color:var(--onGold);font-size:10.5px;font-weight:800;display:grid;place-items:center;border:2px solid var(--bg);box-shadow:0 2px 6px rgba(168,124,47,.5)">{{ cartCount }}</span>
        </sc-if>
      </button>

    </div>
  </div>
</header>

<section id="inicio">
  <sc-if value="{{ heroA }}" hint-placeholder-val="{{ true }}">
    <div class="hero">
      <img src="assets/equipo-gold.jpg" alt="Equipo LYOS Profesional" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 42%;animation:kb 22s ease-in-out infinite alternate" />
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,11,7,.34) 0%,rgba(14,11,7,.06) 34%,rgba(14,11,7,.5) 74%,rgba(14,11,7,.9) 100%)"></div>
      <div style="position:absolute;left:0;right:0;bottom:0;padding:clamp(30px,5vw,72px) clamp(20px,4vw,56px) calc(clamp(30px,5vw,72px) + var(--navPad) + env(safe-area-inset-bottom))">
        <div style="max-width:1320px;margin:0 auto;text-align:center">
          <span style="display:inline-flex;align-items:center;gap:9px;padding:8px 17px;border-radius:999px;border:1px solid rgba(241,222,184,.4);background:rgba(14,11,7,.42);backdrop-filter:blur(12px);font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;font-weight:700;color:#F1DEB8"><span class="mi" style="font-size:15px">verified</span><span data-i18n="hero_badge">Línea capilar premium · Cali</span></span>
          <h1 data-i18n="hero_title" style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(46px,11vw,148px);line-height:.86;letter-spacing:-.055em;margin:16px 0 0;color:#FFFDF8;text-shadow:0 18px 50px rgba(0,0,0,.4)">SOMOS LYOS</h1>
          <p data-i18n="hero_desc" style="max-width:60ch;margin:16px auto 0;font-size:clamp(14px,1.6vw,18px);line-height:1.6;color:rgba(255,253,248,.86)">Especialistas en cuidado capilar y academia de formación profesional, con un portafolio de productos de alta calidad.</p>
          <div style="display:flex;flex-wrap:wrap;gap:11px;justify-content:center;margin-top:28px">
            <a href="#productos" style="display:inline-flex;align-items:center;gap:9px;height:56px;padding:0 30px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:700;font-size:15px;box-shadow:0 16px 40px -14px rgba(0,0,0,.6)" style-hover="filter:brightness(1.08);transform:translateY(-2px)"><span class="mi" style="font-size:20px">grid_view</span><span data-i18n="hero_btn1">Ver portafolio de productos</span></a>
            <a href="{{ waLink }}" target="_blank" style="display:inline-flex;align-items:center;gap:9px;height:56px;padding:0 26px;border-radius:999px;border:1px solid rgba(255,253,248,.42);background:rgba(255,253,248,.1);backdrop-filter:blur(14px);color:#FFFDF8;font-weight:600;font-size:15px" style-hover="background:rgba(255,253,248,.2)"><span class="mi" style="font-size:20px">chat</span><span data-i18n="hero_btn2">Asesoría por WhatsApp</span></a>
          </div>
        </div>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{ heroB }}" hint-placeholder-val="{{ false }}">
    <div style="position:relative;background:var(--bg);overflow:hidden">
      <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));align-items:stretch;min-height:clamp(500px,80vh,780px)">
        <div style="padding:clamp(34px,5vw,72px) clamp(20px,4vw,50px) calc(clamp(34px,5vw,72px) + var(--navPad) + env(safe-area-inset-bottom));display:flex;flex-direction:column;justify-content:center">
          <span style="display:inline-flex;align-self:flex-start;align-items:center;gap:8px;padding:7px 15px;border-radius:999px;border:1px solid var(--line2);background:var(--surf);font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;font-weight:700;color:var(--gold)">El nuevo estándar</span>
          <h1 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:clamp(40px,6.4vw,84px);line-height:.94;letter-spacing:-.05em;margin:20px 0 0">Cuidado capilar<br><span style="font-family:'Kaushan Script',cursive;font-weight:400;font-size:.82em;letter-spacing:0;background:var(--goldGrad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">de uso profesional</span></h1>
          <p style="max-width:44ch;font-size:clamp(15px,1.5vw,17.5px);line-height:1.65;color:var(--mut);margin:22px 0 0">Fórmulas avanzadas creadas para resaltar la esencia única de cada cabello. Desde el más liso hasta el rizo más rebelde.</p>
          <div style="display:flex;flex-wrap:wrap;gap:11px;margin-top:30px">
            <a href="#productos" style="display:inline-flex;align-items:center;gap:9px;height:56px;padding:0 28px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:700;font-size:15px;box-shadow:0 14px 34px -14px rgba(168,124,47,.7)" style-hover="filter:brightness(1.08);transform:translateY(-2px)"><span class="mi" style="font-size:20px">shopping_bag</span>Comprar la línea</a>
            <a href="#resenas" style="display:inline-flex;align-items:center;gap:9px;height:56px;padding:0 24px;border-radius:999px;border:1px solid var(--line2);color:var(--txt);font-weight:600;font-size:15px" style-hover="border-color:var(--gold);color:var(--gold)"><span class="mi mio" style="font-size:20px">reviews</span>Ver reseñas</a>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:26px;margin-top:38px;padding-top:26px;border-top:1px solid var(--line)">
            <div style="display:grid;gap:2px"><span style="font-family:'Outfit',sans-serif;font-size:26px;font-weight:700;color:var(--gold);letter-spacing:-.03em">4.9 ★</span><span style="font-size:11.5px;color:var(--mut)">670 reseñas</span></div>
            <div style="display:grid;gap:2px"><span style="font-family:'Outfit',sans-serif;font-size:26px;font-weight:700;color:var(--gold);letter-spacing:-.03em">+4.200</span><span style="font-size:11.5px;color:var(--mut)">profesionales</span></div>
            <div style="display:grid;gap:2px"><span style="font-family:'Outfit',sans-serif;font-size:26px;font-weight:700;color:var(--gold);letter-spacing:-.03em">24 h</span><span style="font-size:11.5px;color:var(--mut)">despacho</span></div>
          </div>
        </div>
        <div style="position:relative;min-height:340px;overflow:hidden">
          <img src="assets/cristina-wide.jpg" alt="Cristina Gutiérrez, CEO LYOS" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:66% 24%" />
          <div style="position:absolute;inset:0;background:linear-gradient(96deg,var(--bg) 0%,rgba(251,248,242,.28) 26%,transparent 52%)"></div>
        </div>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{ heroC }}" hint-placeholder-val="{{ false }}">
    <div class="hero" style="background:#0C0A07;display:grid;place-items:center">
      <img src="assets/equipo-dark.jpg" alt="Equipo LYOS Profesional" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 44%;opacity:.7" />
      <div style="position:absolute;inset:0;background:radial-gradient(78% 62% at 50% 34%,rgba(201,164,92,.24),transparent 64%),linear-gradient(180deg,rgba(12,10,7,.7),rgba(12,10,7,.42) 40%,rgba(12,10,7,.95))"></div>
      <div style="position:relative;text-align:center;padding:clamp(30px,5vw,60px) 22px calc(clamp(30px,5vw,60px) + var(--navPad) + env(safe-area-inset-bottom));max-width:1000px">
        <span style="display:block;height:1px;width:120px;margin:0 auto;background:var(--goldLine)"></span>
        <span style="display:block;margin-top:22px;font-size:10.5px;letter-spacing:.42em;text-transform:uppercase;font-weight:700;color:#C9A45C">Cali · Colombia · Desde 2024</span>
        <h1 style="font-family:'Outfit',sans-serif;font-weight:300;font-size:clamp(38px,7.4vw,96px);line-height:1;letter-spacing:-.045em;margin:20px 0 0;color:#FFFDF8">La excelencia<br><em style="font-style:normal;font-weight:700;background:linear-gradient(100deg,#F1DEB8,#C9A45C 46%,#8A6425);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">no es casualidad</em></h1>
        <p style="max-width:56ch;margin:22px auto 0;font-size:clamp(14px,1.5vw,17px);line-height:1.7;color:rgba(255,253,248,.78)">Es el resultado de la preparación constante. Cada fórmula, cada certificación y cada entrenamiento elevan el estándar de calidad, servicio e innovación.</p>
        <span style="display:block;height:1px;width:120px;margin:26px auto 0;background:var(--goldLine)"></span>
        <div style="display:flex;flex-wrap:wrap;gap:11px;justify-content:center;margin-top:26px">
          <a href="#productos" style="display:inline-flex;align-items:center;gap:9px;height:54px;padding:0 30px;border-radius:999px;background:linear-gradient(120deg,#F1DEB8,#C9A45C 46%,#8A6425);color:#1A1409;font-weight:700;font-size:15px" style-hover="filter:brightness(1.08);transform:translateY(-2px)"><span class="mi" style="font-size:19px">auto_awesome</span>Descubrir la línea</a>
        </div>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{ heroD }}" hint-placeholder-val="{{ false }}">
    <div style="padding:clamp(16px,2.4vw,30px);background:var(--bg2)">
      <div class="hero" style="max-width:1320px;margin:0 auto;border-radius:clamp(26px,3.4vw,44px);box-shadow:var(--e3)">
        <img src="assets/equipo-blanco.jpg" alt="Equipo LYOS Profesional" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 46%" />
        <div style="position:absolute;inset:0;background:linear-gradient(112deg,rgba(12,10,7,.82) 0%,rgba(12,10,7,.44) 44%,rgba(12,10,7,.12) 72%)"></div>
        <div style="position:absolute;left:0;top:0;bottom:0;display:flex;align-items:center;padding:clamp(24px,4vw,64px) clamp(24px,4vw,64px) calc(clamp(24px,4vw,64px) + var(--navPad) + env(safe-area-inset-bottom));max-width:min(100%,660px)">
          <div style="padding:clamp(24px,3vw,38px);border-radius:30px;background:rgba(20,16,11,.42);backdrop-filter:blur(26px) saturate(1.3);border:1px solid rgba(241,222,184,.24);box-shadow:0 30px 70px -24px rgba(0,0,0,.7)">
            <span style="display:inline-flex;align-items:center;gap:8px;padding:7px 14px;border-radius:999px;border:1px solid rgba(241,222,184,.34);font-size:10px;letter-spacing:.22em;text-transform:uppercase;font-weight:700;color:#F1DEB8">Portafolio profesional</span>
            <h1 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:clamp(34px,5.2vw,64px);line-height:.98;letter-spacing:-.045em;margin:18px 0 0;color:#FFFDF8">Somos LYOS<br>Profesional</h1>
            <p style="font-size:clamp(14px,1.4vw,16.5px);line-height:1.65;color:rgba(255,253,248,.82);margin:14px 0 0;max-width:42ch">Alisados, shampoo, tratamiento y termoprotección de uso profesional. Compra directo y te atendemos por WhatsApp en minutos.</p>
            <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:24px">
              <a href="#productos" style="display:inline-flex;align-items:center;gap:9px;height:52px;padding:0 26px;border-radius:999px;background:linear-gradient(120deg,#F1DEB8,#C9A45C 46%,#8A6425);color:#1A1409;font-weight:700;font-size:14.5px" style-hover="filter:brightness(1.08)"><span class="mi" style="font-size:19px">shopping_bag</span>Comprar ahora</a>
              <a href="{{ waLink }}" target="_blank" style="display:inline-flex;align-items:center;gap:9px;height:52px;padding:0 22px;border-radius:999px;border:1px solid rgba(255,253,248,.4);background:rgba(255,253,248,.1);color:#FFFDF8;font-weight:600;font-size:14.5px" style-hover="background:rgba(255,253,248,.2)"><span class="mi" style="font-size:19px">support_agent</span>Hablar con LYOS</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </sc-if>

  <div style="max-width:1320px;margin:0 auto;padding:16px 18px 0;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:center">
    <span style="display:inline-flex;align-items:center;gap:7px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--dim)"><span class="mi mio" style="font-size:16px">palette</span>Elige tu portada</span>
    <div style="display:flex;gap:5px;padding:5px;border-radius:999px;background:var(--surf);border:1px solid var(--line)">
      <sc-for list="{{ heroOpts }}" as="h" hint-placeholder-count="4">
        <button onClick="{{ h.pick }}" style="{{ h.style }}">{{ h.label }}</button>
      </sc-for>
    </div>
  </div>
</section>

<section style="max-width:1320px;margin:0 auto;padding:clamp(44px,6vw,80px) 18px 0">
  <div style="position:relative;border-radius:clamp(28px,3.6vw,44px);background:linear-gradient(150deg,var(--surf) 0%,var(--surf2) 55%,var(--surf3) 100%);border:1px solid var(--line2);padding:clamp(28px,4.5vw,60px);box-shadow:var(--e3);overflow:hidden">
    
    <!-- Ambient glowing gold decorative orbs -->
    <div style="position:absolute;top:-80px;left:-60px;width:280px;height:280px;border-radius:999px;background:radial-gradient(circle,rgba(201,164,92,.18) 0%,transparent 70%);filter:blur(30px);pointer-events:none"></div>
    <div style="position:absolute;bottom:-60px;right:-40px;width:340px;height:340px;border-radius:999px;background:radial-gradient(circle,rgba(168,124,47,.14) 0%,transparent 70%);filter:blur(40px);pointer-events:none"></div>

    <div style="position:relative;display:grid;gap:clamp(28px,4vw,56px);grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));align-items:center">
      
      <!-- Video Smartphone / Cinema Mockup Showcase -->
      <div style="position:relative;justify-self:center;width:100%;max-width:360px">
        <!-- Glow halo behind player -->
        <div style="position:absolute;inset:-16px;border-radius:44px;background:radial-gradient(circle,rgba(201,164,92,.4) 0%,rgba(138,100,37,.15) 55%,transparent 75%);filter:blur(24px);pointer-events:none"></div>
        
        <!-- Luxury frame wrapper -->
        <div style="position:relative;border-radius:36px;padding:9px;background:linear-gradient(150deg,rgba(241,222,184,.65),rgba(138,100,37,.35) 45%,rgba(20,16,11,.9));border:1.5px solid rgba(241,222,184,.45);box-shadow:0 30px 70px -15px rgba(0,0,0,.45);backdrop-filter:blur(10px)">
          
          <!-- Screen container -->
          <div style="position:relative;border-radius:28px;overflow:hidden;background:#000;aspect-ratio:9/16;width:100%;box-shadow:inset 0 0 12px rgba(0,0,0,.9)">
            
            <!-- Live / Real Demo Badge Overlay -->
            <div style="position:absolute;top:14px;left:14px;z-index:10;display:inline-flex;align-items:center;gap:7px;padding:6px 13px;border-radius:999px;background:rgba(14,11,7,.85);backdrop-filter:blur(12px);border:1px solid rgba(241,222,184,.35);box-shadow:0 4px 14px rgba(0,0,0,.4);pointer-events:none">
              <span style="width:8px;height:8px;border-radius:999px;background:#FF3B30;box-shadow:0 0 8px #FF3B30;display:inline-block"></span>
              <span style="color:#F1DEB8;font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase">Demostración Real</span>
            </div>

            <!-- Bottom Floating Quality Badge -->
            <div style="position:absolute;bottom:14px;right:14px;z-index:10;display:inline-flex;align-items:center;gap:6px;padding:6px 13px;border-radius:999px;background:rgba(255,254,250,.92);backdrop-filter:blur(10px);color:#16120D;font-size:10.5px;font-weight:700;box-shadow:0 6px 18px rgba(0,0,0,.25);pointer-events:none">
              <span class="mi" style="font-size:15px;color:var(--gold)">auto_awesome</span>
              <span>100% Sin Formol</span>
            </div>

            <!-- Embedded YouTube Short iframe -->
            <iframe 
              src="https://www.youtube-nocookie.com/embed/OYXxkOPaaqQ?autoplay=0&rel=0&modestbranding=1&playsinline=1" 
              title="Demostración de Resultados LYOS Profesional" 
              style="width:100%;height:100%;border:0;display:block" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen>
            </iframe>
          </div>
        </div>

        <!-- Direct YouTube Link Badge -->
        <div style="display:flex;justify-content:center;margin-top:14px">
          <a href="https://youtube.com/shorts/OYXxkOPaaqQ?feature=share" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:7px;padding:8px 16px;border-radius:999px;background:var(--surf);border:1px solid var(--line2);font-size:12px;font-weight:600;color:var(--txt);transition:all .25s" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold)">
            <span class="mi" style="font-size:16px;color:#FF0000">smart_display</span>
            <span>Ver Short en YouTube</span>
            <span class="mi mio" style="font-size:14px">open_in_new</span>
          </a>
        </div>
      </div>

      <!-- Text & Highlights Showcase Column -->
      <div>
        <div style="display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border-radius:999px;background:var(--surf);border:1px solid var(--line2);box-shadow:var(--e1)">
          <span class="mi" style="font-size:16px;color:var(--gold)">auto_awesome</span>
          <span style="font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:800">Resultados en Vivo · Video de Marca</span>
        </div>

        <h2 data-en="Excellence you can see in every detail" style="font-family:'Outfit',sans-serif;font-size:clamp(30px,4.6vw,52px);font-weight:800;letter-spacing:-.045em;line-height:1.06;margin:16px 0 0">
          La excelencia y el brillo<br>
          <span style="font-family:'Kaushan Script',cursive;font-weight:400;font-size:.92em;letter-spacing:0;background:var(--goldGrad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">se notan en cada detalle</span>
        </h2>

        <p style="font-size:15.5px;line-height:1.7;color:var(--mut);margin:18px 0 0;max-width:52ch">
          Cada entrenamiento, cada certificación y cada aplicación forman parte de un estándar innegociable: fórmulas de alta pureza diseñadas para entregar un <strong>liso espejo sedoso y saludable</strong> sin saturación ni vapores tóxicos.
        </p>

        <!-- Feature Grid Highlights -->
        <div style="display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));margin-top:26px">
          
          <div style="display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border-radius:20px;background:var(--surf);border:1px solid var(--line);box-shadow:var(--e1)">
            <div style="width:38px;height:38px;border-radius:12px;background:var(--surf2);border:1px solid var(--line2);display:grid;place-items:center;flex:none">
              <span class="mi" style="font-size:20px;color:var(--gold)">verified</span>
            </div>
            <div>
              <span style="display:block;font-size:13.5px;font-weight:700;color:var(--txt)">Formación Global</span>
              <span style="display:block;font-size:12px;color:var(--mut);line-height:1.45;margin-top:2px">Metodología internacional y certificaciones de academia.</span>
            </div>
          </div>

          <div style="display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border-radius:20px;background:var(--surf);border:1px solid var(--line);box-shadow:var(--e1)">
            <div style="width:38px;height:38px;border-radius:12px;background:var(--surf2);border:1px solid var(--line2);display:grid;place-items:center;flex:none">
              <span class="mi" style="font-size:20px;color:var(--gold)">biotech</span>
            </div>
            <div>
              <span style="display:block;font-size:13.5px;font-weight:700;color:var(--txt)">Tecnología Avanzada</span>
              <span style="display:block;font-size:12px;color:var(--mut);line-height:1.45;margin-top:2px">Ácido Hialurónico &amp; Manteca de Murumuru 100% libre de formol.</span>
            </div>
          </div>

          <div style="display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border-radius:20px;background:var(--surf);border:1px solid var(--line);box-shadow:var(--e1)">
            <div style="width:38px;height:38px;border-radius:12px;background:var(--surf2);border:1px solid var(--line2);display:grid;place-items:center;flex:none">
              <span class="mi" style="font-size:20px;color:var(--gold)">workspace_premium</span>
            </div>
            <div>
              <span style="display:block;font-size:13.5px;font-weight:700;color:var(--txt)">Rendimiento Profesional</span>
              <span style="display:block;font-size:12px;color:var(--mut);line-height:1.45;margin-top:2px">Mayor rentabilidad por litro y fidelización en salón.</span>
            </div>
          </div>

        </div>

        <!-- Action CTAs -->
        <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:30px;padding-top:24px;border-top:1px solid var(--line)">
          <a href="#productos" style="display:inline-flex;align-items:center;gap:9px;height:52px;padding:0 28px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:700;font-size:14.5px;box-shadow:0 12px 30px -10px rgba(168,124,47,.7);transition:all .25s" style-hover="filter:brightness(1.08);transform:translateY(-2px)">
            <span class="mi" style="font-size:20px">shopping_bag</span>
            <span>Ver Portafolio Completo</span>
          </a>
          <a href="{{ waLink }}" target="_blank" style="display:inline-flex;align-items:center;gap:9px;height:52px;padding:0 24px;border-radius:999px;border:1px solid var(--line2);background:var(--surf);color:var(--txt);font-weight:600;font-size:14.5px;transition:all .25s" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold)">
            <span class="mi" style="font-size:20px;color:#25D366">chat</span>
            <span>Asesoría por WhatsApp</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>



<div style="overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--bg2);padding:14px 0;margin-top:clamp(40px,6vw,68px)">
  <div style="display:flex;width:max-content;animation:mq 36s linear infinite">
    <div style="display:flex;gap:34px;padding-right:34px;align-items:center">
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--gold);font-weight:700">LIBRE DE FORMOL</span><span style="color:var(--dim)">◆</span>
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--mut);font-weight:600">ÁCIDO HIALURÓNICO</span><span style="color:var(--dim)">◆</span>
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--gold);font-weight:700">SIN SAL NI PARABENOS</span><span style="color:var(--dim)">◆</span>
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--mut);font-weight:600">MANTEQUILLA DE MURUMURU</span><span style="color:var(--dim)">◆</span>
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--gold);font-weight:700">USO PROFESIONAL</span><span style="color:var(--dim)">◆</span>
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--mut);font-weight:600">TECNOLOGÍA BRASILEÑA Y COREANA</span><span style="color:var(--dim)">◆</span>
    </div>
    <div style="display:flex;gap:34px;padding-right:34px;align-items:center">
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--gold);font-weight:700">LIBRE DE FORMOL</span><span style="color:var(--dim)">◆</span>
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--mut);font-weight:600">ÁCIDO HIALURÓNICO</span><span style="color:var(--dim)">◆</span>
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--gold);font-weight:700">SIN SAL NI PARABENOS</span><span style="color:var(--dim)">◆</span>
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--mut);font-weight:600">MANTEQUILLA DE MURUMURU</span><span style="color:var(--dim)">◆</span>
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--gold);font-weight:700">USO PROFESIONAL</span><span style="color:var(--dim)">◆</span>
      <span style="font-size:11.5px;letter-spacing:.26em;color:var(--mut);font-weight:600">TECNOLOGÍA BRASILEÑA Y COREANA</span><span style="color:var(--dim)">◆</span>
    </div>
  </div>
</div>

<section id="productos" style="position:relative;max-width:1320px;margin:0 auto;padding:clamp(40px,5.2vw,72px) 18px 0">
  
  <!-- Subtle ambient decorative glow -->
  <div style="position:absolute;top:0;left:50%;transform:translateX(-50%);width:min(900px,95vw);height:240px;background:radial-gradient(ellipse,rgba(201,164,92,.12) 0%,rgba(138,100,37,.02) 50%,transparent 70%);filter:blur(50px);pointer-events:none"></div>

  <!-- Minimalist Luxury Editorial Header -->
  <div style="position:relative;z-index:2;display:flex;flex-wrap:wrap;align-items:flex-end;gap:18px;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:20px">
    <div style="max-width:720px">
      
      <!-- Sleek Meta Row -->
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:10px">
        <span style="font-size:10.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--gold);font-weight:800;display:inline-flex;align-items:center;gap:6px">
          <span style="width:6px;height:6px;border-radius:999px;background:var(--gold);display:inline-block"></span>
          PORTAFOLIO OFICIAL · 0% FORMOL
        </span>
        <span style="color:var(--dim);font-size:11px">·</span>
        <div style="display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--txt);font-weight:700">
          <span style="color:var(--gold);letter-spacing:1px;font-size:13px">★★★★★</span>
          <span>4.9</span>
          <span style="font-size:11.5px;color:var(--mut);font-weight:500">(+4.200 salones)</span>
        </div>
      </div>

      <!-- Main Title -->
      <h2 data-en="The LYOS line" style="font-family:'Outfit',sans-serif;font-size:clamp(30px,4.5vw,48px);font-weight:800;letter-spacing:-.04em;line-height:1.06;margin:0;color:var(--txt)">
        La Colección Profesional
      </h2>
      
      <!-- Subtitle -->
      <p data-en="Two clicks to buy. We confirm and finish the order on WhatsApp." style="font-size:14.5px;color:var(--mut);margin:8px 0 0;line-height:1.6;max-width:54ch">
        Fórmulas de grado salón con <strong>Ácido Hialurónico puro y Manteca de Murumuru</strong> para un liso espejo de máxima duración.
      </p>
    </div>

    <!-- Layout Switcher (Editorial / Galería) -->
    <div style="display:flex;gap:4px;padding:4px;border-radius:999px;background:var(--surf);border:1.5px solid var(--line2);box-shadow:var(--e1)">
      <button onClick="{{ setEditorial }}" style="{{ edStyle }}"><span class="mi mio" style="font-size:17px">view_agenda</span>Editorial</button>
      <button onClick="{{ setGallery }}" style="{{ glStyle }}"><span class="mi mio" style="font-size:17px">grid_view</span>Galería</button>
    </div>
  </div>

  <!-- Luxury Minimalist Categories Navigation Bar -->
  <div style="margin:20px 0 28px;position:relative">
    <div class="hs" style="display:flex;gap:8px;overflow-x:auto;padding:4px 2px 10px;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;align-items:center">
      <sc-for list="{{ cats }}" as="c" hint-placeholder-count="6">
        <button onClick="{{ c.pick }}" style="{{ c.pillStyle }}" style-hover="{{ c.pillHover }}">
          <span class="mi" style="{{ c.pillIconStyle }}">{{ c.icon }}</span>
          <span>{{ c.label }}</span>
          <span style="{{ c.countStyle }}">{{ c.count }}</span>
        </button>
      </sc-for>
    </div>
  </div>

  <!-- VIEW 1: EDITORIAL SHOWCASE (Upgraded & Rich in Social Proof) -->
  <sc-if value="{{ isEditorial }}" hint-placeholder-val="{{ true }}">
    <div style="display:grid;gap:clamp(20px,2.8vw,32px)">
      <sc-for list="{{ products }}" as="p" hint-placeholder-count="4">
        <article style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:0;border-radius:clamp(26px,3vw,38px);overflow:hidden;background:linear-gradient(150deg,var(--surf) 0%,var(--surf2) 100%);border:1.5px solid var(--line2);box-shadow:var(--e2);transition:box-shadow .4s,border-color .4s,transform .4s" style-hover="box-shadow:var(--e3);border-color:var(--gold);transform:translateY(-4px)">
          
          <!-- Image Column with Plinth & Floating Badges -->
          <div style="order:{{ p.imgOrder }};position:relative;background:var(--plinth);min-height:clamp(300px,36vw,440px);display:grid;place-items:center;overflow:hidden">
            <button onClick="{{ p.open }}" style="width:100%;height:100%;border:0;padding:0;background:transparent;cursor:pointer;display:grid;place-items:center">
              <img src="{{ p.img }}" alt="{{ p.name }}" loading="lazy" style="width:100%;height:100%;max-height:440px;object-fit:contain;padding:clamp(24px,3.4vw,44px);mix-blend-mode:multiply;transition:transform .6s cubic-bezier(.2,.8,.2,1)" style-hover="transform:scale(1.06)" />
            </button>
            
            <!-- Top Badge (Más vendido / Premium) -->
            <span style="position:absolute;top:18px;left:18px;padding:7px 15px;border-radius:999px;background:rgba(14,11,7,.88);backdrop-filter:blur(10px);border:1px solid rgba(241,222,184,.3);color:#F1DEB8;font-size:10px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;box-shadow:0 6px 16px rgba(0,0,0,.4)">
              {{ p.badge }}
            </span>

            <!-- Top Right Heart Button -->
            <button onClick="{{ p.fav }}" aria-label="Favorito" style="position:absolute;top:16px;right:16px;width:42px;height:42px;border-radius:999px;border:1px solid var(--line2);background:var(--surf);backdrop-filter:blur(10px);display:grid;place-items:center;cursor:pointer;color:{{ p.favColor }};box-shadow:var(--e1);transition:all .25s" style-hover="transform:scale(1.15)">
              <span class="mi" style="font-size:22px">{{ p.favIcon }}</span>
            </button>

            <!-- Bottom Floating Quick-View Tag -->
            <button onClick="{{ p.open }}" style="position:absolute;bottom:18px;right:18px;display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:999px;background:rgba(255,254,250,.92);backdrop-filter:blur(12px);color:#16120D;font-size:12px;font-weight:800;box-shadow:0 8px 20px rgba(0,0,0,.25);border:0;cursor:pointer;transition:all .2s" style-hover="transform:scale(1.05)">
              <span class="mi mio" style="font-size:17px;color:var(--gold)">zoom_in</span>
              <span>Ver Ficha Técnica</span>
            </button>
          </div>

          <!-- Content Column with High Social Proof -->
          <div style="padding:clamp(26px,3.6vw,46px);display:flex;flex-direction:column;justify-content:center">
            
            <!-- Social Proof Row: 5 Stars + Real Customer Avatars -->
            <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px">
              <div style="display:flex;align-items:center;gap:8px">
                <span style="color:var(--gold);letter-spacing:1.5px;font-size:15px">★★★★★</span>
                <span style="font-size:13.5px;font-weight:800;color:var(--txt)">{{ p.rating }}</span>
                <span style="font-size:12.5px;color:var(--mut)">· ({{ p.reviews }} reseñas reales)</span>
              </div>
              <span style="display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:800;letter-spacing:.08em;color:var(--gold);padding:4px 10px;border-radius:999px;background:var(--surf3)">
                <span class="mi" style="font-size:14px">verified</span> ELECCIÓN #1 EN SALÓN
              </span>
            </div>

            <!-- Product Title -->
            <h3 style="font-family:'Outfit',sans-serif;font-size:clamp(24px,3.2vw,36px);font-weight:800;letter-spacing:-.035em;line-height:1.06;margin:14px 0 0;color:var(--txt)">
              {{ p.name }}
            </h3>

            <!-- Product Description -->
            <p style="font-size:14.5px;line-height:1.68;color:var(--mut);margin:12px 0 0;max-width:52ch">
              {{ p.desc }}
            </p>

            <!-- Tags Pills -->
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:18px">
              <sc-for list="{{ p.tags }}" as="t" hint-placeholder-count="0">
                <span style="padding:7px 14px;border-radius:999px;background:var(--surf2);border:1px solid var(--line2);font-size:11.5px;font-weight:700;color:var(--gold)">
                  {{ t }}
                </span>
              </sc-for>
            </div>

            <!-- Price & Action Footer -->
            <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:18px;justify-content:space-between;margin-top:26px;padding-top:22px;border-top:1px solid var(--line)">
              <div style="display:grid;gap:3px">
                <span style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--mut);font-weight:700">{{ p.sizeLabel }}</span>
                <span style="font-family:'Outfit',sans-serif;font-size:clamp(26px,3vw,34px);font-weight:800;letter-spacing:-.03em;line-height:1;color:var(--txt)">{{ p.priceLabel }}</span>
              </div>
              
              <div style="display:flex;gap:10px;align-items:center">
                <button onClick="{{ p.buy }}" style="height:54px;padding:0 26px;border:0;border-radius:999px;background:{{ p.ctaBg }};color:{{ p.ctaFg }};font-weight:700;font-size:14.5px;cursor:pointer;display:flex;align-items:center;gap:9px;box-shadow:{{ p.ctaShadow }};white-space:nowrap;transition:all .25s" style-hover="filter:brightness(1.08);transform:translateY(-2px)">
                  <span class="mi" style="font-size:20px">{{ p.ctaIcon }}</span>
                  <span>{{ p.ctaLabel }}</span>
                </button>
                <button onClick="{{ p.add }}" aria-label="Añadir al carrito" style="width:54px;height:54px;flex:none;border:1.5px solid var(--line2);background:var(--surf);border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--txt);transition:all .25s" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold);transform:scale(1.05)">
                  <span class="mi mio" style="font-size:22px">add_shopping_cart</span>
                </button>
              </div>
            </div>

          </div>
        </article>
      </sc-for>
    </div>
  </sc-if>

  <!-- VIEW 2: GALLERY SHOWCASE (Grid View) -->
  <sc-if value="{{ isGallery }}" hint-placeholder-val="{{ false }}">
    <div style="display:grid;gap:clamp(16px,2vw,24px);grid-template-columns:repeat(auto-fill,minmax(clamp(260px,30%,380px),1fr))">
      <sc-for list="{{ products }}" as="p" hint-placeholder-count="3">
        <article style="display:flex;flex-direction:column;border-radius:30px;overflow:hidden;background:var(--surf);border:1.5px solid var(--line);box-shadow:var(--e1);transition:transform .4s cubic-bezier(.2,.8,.2,1),box-shadow .4s,border-color .4s" style-hover="transform:translateY(-7px);box-shadow:var(--e3);border-color:var(--gold)">
          
          <!-- Image Box -->
          <div style="position:relative;background:var(--plinth);aspect-ratio:1/1;display:grid;place-items:center;overflow:hidden">
            <button onClick="{{ p.open }}" style="width:100%;height:100%;border:0;padding:0;cursor:pointer;background:transparent;display:grid;place-items:center">
              <img src="{{ p.img }}" alt="{{ p.name }}" loading="lazy" style="width:100%;height:100%;object-fit:contain;padding:clamp(20px,2.6vw,34px);mix-blend-mode:multiply;transition:transform .6s cubic-bezier(.2,.8,.2,1)" style-hover="transform:scale(1.06)" />
            </button>
            <span style="position:absolute;top:14px;left:14px;padding:6px 13px;border-radius:999px;background:rgba(14,11,7,.86);color:#F1DEB8;font-size:9.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap">{{ p.badge }}</span>
            <button onClick="{{ p.fav }}" aria-label="Favorito" style="position:absolute;top:12px;right:12px;width:38px;height:38px;border-radius:999px;border:1px solid var(--line2);background:var(--surf);backdrop-filter:blur(10px);display:grid;place-items:center;cursor:pointer;color:{{ p.favColor }};box-shadow:var(--e1);transition:all .25s" style-hover="transform:scale(1.15)">
              <span class="mi" style="font-size:20px">{{ p.favIcon }}</span>
            </button>
          </div>
          
          <!-- Info Details -->
          <div style="padding:22px 22px 24px;display:flex;flex-direction:column;flex:1">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:6px">
              <div style="display:flex;align-items:center;gap:6px;font-size:12.5px"><span style="color:var(--gold);letter-spacing:1px">★★★★★</span><span style="font-weight:700">{{ p.rating }}</span><span style="color:var(--mut)">· {{ p.reviews }}</span></div>
              <span style="font-size:9.5px;font-weight:800;color:var(--gold);letter-spacing:.08em;padding:3px 8px;border-radius:999px;background:var(--surf3)">VERIFICADO</span>
            </div>

            <h3 style="font-family:'Outfit',sans-serif;font-size:20px;font-weight:700;line-height:1.2;letter-spacing:-.025em;margin:10px 0 0;color:var(--txt)">{{ p.name }}</h3>
            <p style="font-size:12.5px;color:var(--dim);margin:6px 0 0;letter-spacing:.04em;font-weight:600">{{ p.sizeLabel }}</p>
            <p style="font-size:13.5px;line-height:1.55;color:var(--mut);margin:10px 0 0">{{ p.short }}</p>
            
            <div style="display:flex;align-items:baseline;gap:8px;margin-top:auto;padding-top:18px">
              <span style="font-family:'Outfit',sans-serif;font-size:23px;font-weight:800;letter-spacing:-.03em;color:var(--txt)">{{ p.priceLabel }}</span>
            </div>
            
            <div style="display:flex;gap:8px;margin-top:14px">
              <button onClick="{{ p.buy }}" style="flex:1;height:50px;border:0;border-radius:999px;background:{{ p.ctaBg }};color:{{ p.ctaFg }};font-weight:700;font-size:13.5px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;transition:all .25s" style-hover="filter:brightness(1.08)"><span class="mi" style="font-size:18px">{{ p.ctaIcon }}</span>{{ p.ctaLabel }}</button>
              <button onClick="{{ p.add }}" aria-label="Añadir al carrito" style="width:50px;height:50px;flex:none;border:1.5px solid var(--line2);background:transparent;border-radius:999px;cursor:pointer;display:grid;place-items:center;color:var(--txt);transition:all .25s" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold)"><span class="mi mio" style="font-size:20px">add_shopping_cart</span></button>
            </div>
          </div>
        </article>
      </sc-for>
    </div>
  </sc-if>

  <!-- ========================================================================= -->
  <!-- COMBOS & KITS DE SALÓN CON DESCUENTO (HIGH CONVERSION BUNDLES)            -->
  <!-- ========================================================================= -->
  <div style="margin-top:clamp(44px,6vw,68px);padding-top:clamp(32px,4vw,48px);border-top:1.5px solid var(--line)">
    
    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:24px">
      <div>
        <div style="display:inline-flex;align-items:center;gap:7px;padding:5px 14px;border-radius:999px;background:rgba(212,175,55,.12);border:1px solid rgba(212,175,55,.3);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:800;margin-bottom:8px">
          <span class="mi" style="font-size:15px">redeem</span>Kits Maestros · Descuento Especial
        </div>
        <h3 style="font-family:'Outfit',sans-serif;font-size:clamp(26px,3.8vw,38px);font-weight:800;letter-spacing:-.035em;margin:0;color:var(--txt)">
          Combos Profesionales Recomendados
        </h3>
        <p style="font-size:14px;color:var(--mut);margin:6px 0 0;max-width:52ch">
          Ahorra comprando las rutinas completas para salón o mantenimiento en casa.
        </p>
      </div>
      
      <span style="font-size:12px;font-weight:700;color:#25D366;display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:999px;background:rgba(37,211,102,.1)">
        <span class="mi" style="font-size:16px">local_shipping</span>Envío Gratis Incluido
      </span>
    </div>

    <!-- 3 Bundle Cards Grid -->
    <div style="display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))">
      <sc-for list="{{ bundles }}" as="b" hint-placeholder-count="3">
        <div style="position:relative;border-radius:28px;background:linear-gradient(150deg,var(--surf) 0%,var(--surf2) 100%);border:1.5px solid var(--line2);box-shadow:var(--e2);padding:24px;display:flex;flex-direction:column;justify-content:space-between;transition:all .3s" style-hover="border-color:var(--gold);transform:translateY(-4px);box-shadow:var(--e3)">
          
          <!-- Top Badge Row -->
          <div>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
              <span style="padding:5px 12px;border-radius:999px;background:var(--surf3);color:var(--gold);font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase">
                {{ b.badge }}
              </span>
              <span style="padding:5px 12px;border-radius:999px;background:rgba(37,211,102,.12);color:#25D366;font-size:11px;font-weight:800;border:1px solid rgba(37,211,102,.3)">
                {{ b.saveLabel }}
              </span>
            </div>

            <!-- Image thumbnail & title -->
            <div style="display:flex;gap:14px;align-items:center;margin-top:16px">
              <span style="width:74px;height:74px;border-radius:18px;background:var(--plinth);overflow:hidden;display:grid;place-items:center;flex:none;border:1px solid var(--line)">
                <img src="{{ b.img }}" alt="" style="width:100%;height:100%;object-fit:contain;padding:4px;mix-blend-mode:multiply" />
              </span>
              <div style="display:flex;flex-direction:column;min-width:0">
                <h4 style="font-family:'Outfit',sans-serif;font-size:18px;font-weight:800;color:var(--txt);margin:0;line-height:1.2">
                  {{ b.name }}
                </h4>
                <span style="font-size:12px;color:var(--mut);margin-top:4px;line-height:1.4">{{ b.short }}</span>
              </div>
            </div>

            <!-- Items List -->
            <div style="display:grid;gap:6px;margin-top:16px;padding:12px;border-radius:16px;background:var(--surf2);border:1px solid var(--line)">
              <sc-for list="{{ b.items }}" as="it" hint-placeholder-count="3">
                <div style="display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--txt)">
                  <span class="mi" style="font-size:15px;color:var(--gold)">check_circle</span>
                  <span>{{ it }}</span>
                </div>
              </sc-for>
            </div>
          </div>

          <!-- Pricing & Action Row -->
          <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:12px">
            <div style="display:flex;align-items:baseline;justify-content:space-between">
              <div style="display:flex;align-items:baseline;gap:8px">
                <span style="font-family:'Outfit',sans-serif;font-size:24px;font-weight:800;color:var(--txt)">{{ b.priceLabel }}</span>
                <span style="font-size:14px;color:var(--dim);text-decoration:line-through;font-weight:600">{{ b.oldPriceLabel }}</span>
              </div>
              <span style="font-size:11px;font-weight:700;color:var(--gold)">Pack Ahorro</span>
            </div>

            <div style="display:flex;gap:8px">
              <button onClick="{{ b.add }}" style="flex:1;height:48px;border:0;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:800;font-size:13.5px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;box-shadow:0 8px 20px -6px rgba(168,124,47,.6);transition:all .25s" style-hover="filter:brightness(1.08);transform:translateY(-1px)">
                <span class="mi" style="font-size:18px">shopping_bag</span>
                <span>Añadir Combo</span>
              </button>
              <a href="{{ b.waLink }}" target="_blank" style="width:48px;height:48px;border-radius:999px;border:1.5px solid var(--line2);background:var(--surf);display:grid;place-items:center;color:#25D366;transition:all .25s" style-hover="border-color:#25D366;transform:scale(1.05)">
                <span class="mi" style="font-size:20px">chat</span>
              </a>
            </div>
          </div>

        </div>
      </sc-for>
    </div>

  </div>

  <!-- Bottom Fast-Service Guarantee Minimalist Strip -->
  <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:clamp(16px,3vw,32px);margin-top:clamp(28px,3.6vw,42px);padding:18px 24px;border-radius:999px;background:var(--surf);border:1px solid var(--line2);box-shadow:var(--e1)">
    <div style="display:flex;gap:8px;align-items:center;font-size:13px;font-weight:700;color:var(--txt)">
      <span class="mi" style="font-size:18px;color:var(--gold)">bolt</span>
      <span>Compra en 2 clics por WhatsApp</span>
    </div>
    <span style="color:var(--line2);display:none;@media(min-width:768px){display:inline}">|</span>
    <div style="display:flex;gap:8px;align-items:center;font-size:13px;font-weight:700;color:var(--txt)">
      <span class="mi" style="font-size:18px;color:var(--gold)">local_shipping</span>
      <span>Envíos gratis desde $150.000</span>
    </div>
    <span style="color:var(--line2);display:none;@media(min-width:768px){display:inline}">|</span>
    <div style="display:flex;gap:8px;align-items:center;font-size:13px;font-weight:700;color:var(--txt)">
      <span class="mi" style="font-size:18px;color:var(--gold)">verified_user</span>
      <span>100% Original &amp; INVIMA</span>
    </div>
    <span style="color:var(--line2);display:none;@media(min-width:768px){display:inline}">|</span>
    <div style="display:flex;gap:8px;align-items:center;font-size:13px;font-weight:700;color:var(--txt)">
      <span class="mi" style="font-size:18px;color:var(--gold)">support_agent</span>
      <span>Asesoría personalizada</span>
    </div>
  </div>
</section>

<!-- ========================================================================= -->
<!-- TEST / DIAGNÓSTICO CAPILAR VIRTUAL EN 3 PASOS (HAIR QUIZ)                 -->
<!-- ========================================================================= -->
<!-- ========================================================================= -->
<!-- TEST / DIAGNÓSTICO CAPILAR VIRTUAL EN 3 PASOS (HAIR QUIZ VIP)             -->
<!-- ========================================================================= -->
<section id="diagnostico" style="position:relative;max-width:1320px;margin:clamp(48px,6.5vw,84px) auto 0;padding:0 18px">
  
  <div style="border-radius:clamp(28px,4vw,44px);background:linear-gradient(165deg,var(--surf) 0%,var(--surf2) 50%,var(--surf3) 100%);border:1.5px solid var(--line2);box-shadow:0 24px 60px -15px rgba(168,124,47,.16),var(--e3);padding:clamp(22px,4vw,48px);position:relative;overflow:hidden">
    
    <!-- Ambient gold glow effect -->
    <div style="position:absolute;top:-60px;right:-60px;width:340px;height:340px;background:radial-gradient(circle,rgba(201,164,92,.22) 0%,transparent 70%);filter:blur(50px);pointer-events:none"></div>
    <div style="position:absolute;bottom:-60px;left:-60px;width:300px;height:300px;background:radial-gradient(circle,rgba(168,124,47,.14) 0%,transparent 70%);filter:blur(45px);pointer-events:none"></div>

    <!-- Section Header with High Impact Styling -->
    <div style="text-align:center;max-width:760px;margin:0 auto;position:relative;z-index:2">
      <div style="display:inline-flex;align-items:center;gap:8px;padding:7px 18px;border-radius:999px;background:var(--surf);border:1.5px solid var(--line2);font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:800;margin-bottom:14px;box-shadow:var(--e1)">
        <span class="mi" style="font-size:16px;color:var(--gold)">auto_fix_high</span>
        <span>Asesor Virtual Inteligente · Tricología de Precisión</span>
      </div>
      <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(28px,4.4vw,46px);font-weight:800;letter-spacing:-.04em;line-height:1.06;margin:0;color:var(--txt)">
        Descubre tu Rutina Capilar Ideal
      </h2>
      <p style="font-size:14.5px;color:var(--mut);margin:10px auto 0;line-height:1.6;max-width:54ch">
        Diagnóstico profesional en 3 pasos para recomendarte la fórmula exacta sin formol que transformará tu fibra capilar.
      </p>
    </div>

    <!-- Mobile-First Interactive Progress Control Bar -->
    <div style="max-width:680px;margin:28px auto 0;position:relative;z-index:2">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
        <sc-if value="{{ canQuizPrev }}" hint-placeholder-val="{{ false }}">
          <button onClick="{{ quizPrev }}" aria-label="Volver al paso anterior" style="border:1px solid var(--line2);background:var(--surf);border-radius:999px;padding:6px 14px;color:var(--txt);font-size:12px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .2s;box-shadow:var(--e1)" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold);transform:translateX(-2px)">
            <span class="mi mio" style="font-size:16px">arrow_back</span>
            <span>Paso anterior</span>
          </button>
        </sc-if>
        <sc-if value="{{ isQuizStep1 }}" hint-placeholder-val="{{ true }}">
          <span style="font-size:11.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);display:inline-flex;align-items:center;gap:6px">
            <span style="width:7px;height:7px;border-radius:999px;background:var(--gold);display:inline-block"></span>
            <span>Inicio del Diagnóstico</span>
          </span>
        </sc-if>

        <span style="font-size:11.5px;font-weight:800;letter-spacing:.08em;padding:4px 12px;border-radius:999px;background:var(--surf3);color:var(--gold);border:1px solid rgba(212,175,55,.25);margin-left:auto">
          {{ isQuizResult ? 'COMPLETADO ✨' : 'PASO ' + quizStep + ' DE 3 · ' + quizStepPct }}
        </span>
      </div>

      <!-- Animated Progress Track -->
      <div style="width:100%;height:8px;border-radius:999px;background:var(--surf3);overflow:hidden;border:1px solid var(--line);box-shadow:inset 0 1px 3px rgba(0,0,0,.1)">
        <div style="height:100%;width:{{ quizStepPct }};background:var(--goldGrad);border-radius:999px;transition:width .4s cubic-bezier(.2,.8,.2,1);box-shadow:0 0 12px rgba(201,164,92,.65)"></div>
      </div>
    </div>

    <!-- QUIZ STEP 1: Tipo de Cabello -->
    <sc-if value="{{ isQuizStep1 }}" hint-placeholder-val="{{ true }}">
      <div style="max-width:720px;margin:32px auto 0;position:relative;z-index:2;animation:fadeup .32s ease-out">
        <div style="text-align:center;margin-bottom:22px">
          <span style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:800;display:block">PASO 1</span>
          <h3 style="font-family:'Outfit',sans-serif;font-size:clamp(20px,3vw,25px);font-weight:800;color:var(--txt);margin:4px 0 0">¿Cuál es el tipo o estado actual de tu cabello?</h3>
          <p style="font-size:13px;color:var(--mut);margin:4px 0 0">Selecciona la textura que mejor describe tu hebra para calibrar los activos botánicos</p>
        </div>
        
        <div style="display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,310px),1fr))">
          <sc-for list="{{ quizHairOptions }}" as="ho" hint-placeholder-count="4">
            <button onClick="{{ ho.pick }}" style="{{ ho.style }}" style-hover="border-color:var(--gold);background:var(--surf2);transform:translateY(-3px);box-shadow:0 10px 24px -6px rgba(168,124,47,.3)">
              <div style="display:flex;align-items:center;gap:14px;min-width:0">
                <div style="{{ ho.iconStyle }}">
                  <span class="mi" style="font-size:22px">{{ ho.icon }}</span>
                </div>
                <div style="display:flex;flex-direction:column">
                  <span style="font-family:'Outfit',sans-serif;font-size:15.5px;font-weight:800;color:var(--txt)">{{ ho.title }}</span>
                  <span style="font-size:12.5px;color:var(--mut);margin-top:2px;line-height:1.35">{{ ho.desc }}</span>
                </div>
              </div>
              <span class="mi" style="font-size:22px;color:{{ ho.checkColor }};flex:none">
                {{ ho.checkIcon }}
              </span>
            </button>
          </sc-for>
        </div>
      </div>
    </sc-if>

    <!-- QUIZ STEP 2: Objetivo -->
    <sc-if value="{{ isQuizStep2 }}" hint-placeholder-val="{{ false }}">
      <div style="max-width:720px;margin:32px auto 0;position:relative;z-index:2;animation:fadeup .32s ease-out">
        <div style="text-align:center;margin-bottom:22px">
          <span style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:800;display:block">PASO 2</span>
          <h3 style="font-family:'Outfit',sans-serif;font-size:clamp(20px,3vw,25px);font-weight:800;color:var(--txt);margin:4px 0 0">¿Qué resultado buscas lograr principalmente?</h3>
          <p style="font-size:13px;color:var(--mut);margin:4px 0 0">Definiremos el protocolo de sellado, nutrición o termoprotección ideal</p>
        </div>
        
        <div style="display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,310px),1fr))">
          <sc-for list="{{ quizGoalOptions }}" as="go" hint-placeholder-count="3">
            <button onClick="{{ go.pick }}" style="{{ go.style }}" style-hover="border-color:var(--gold);background:var(--surf2);transform:translateY(-3px);box-shadow:0 10px 24px -6px rgba(168,124,47,.3)">
              <div style="display:flex;align-items:center;gap:14px;min-width:0">
                <div style="{{ go.iconStyle }}">
                  <span class="mi" style="font-size:22px">{{ go.icon }}</span>
                </div>
                <div style="display:flex;flex-direction:column">
                  <span style="font-family:'Outfit',sans-serif;font-size:15.5px;font-weight:800;color:var(--txt)">{{ go.title }}</span>
                  <span style="font-size:12.5px;color:var(--mut);margin-top:2px;line-height:1.35">{{ go.desc }}</span>
                </div>
              </div>
              <span class="mi" style="font-size:22px;color:{{ go.checkColor }};flex:none">
                {{ go.checkIcon }}
              </span>
            </button>
          </sc-for>
        </div>
      </div>
    </sc-if>

    <!-- QUIZ STEP 3: Perfil / Aplicación -->
    <sc-if value="{{ isQuizStep3 }}" hint-placeholder-val="{{ false }}">
      <div style="max-width:720px;margin:32px auto 0;position:relative;z-index:2;animation:fadeup .32s ease-out">
        <div style="text-align:center;margin-bottom:22px">
          <span style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:800;display:block">PASO 3</span>
          <h3 style="font-family:'Outfit',sans-serif;font-size:clamp(20px,3vw,25px);font-weight:800;color:var(--txt);margin:4px 0 0">¿Para qué uso requieres los productos?</h3>
          <p style="font-size:13px;color:var(--mut);margin:4px 0 0">Adaptamos el tamaño, rendimiento y formato de aplicación a tu medida</p>
        </div>
        
        <div style="display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,310px),1fr))">
          <sc-for list="{{ quizProfileOptions }}" as="po" hint-placeholder-count="2">
            <button onClick="{{ po.pick }}" style="{{ po.style }}" style-hover="border-color:var(--gold);background:var(--surf2);transform:translateY(-3px);box-shadow:0 10px 24px -6px rgba(168,124,47,.3)">
              <div style="display:flex;align-items:center;gap:14px;min-width:0">
                <div style="{{ po.iconStyle }}">
                  <span class="mi" style="font-size:22px">{{ po.icon }}</span>
                </div>
                <div style="display:flex;flex-direction:column">
                  <span style="font-family:'Outfit',sans-serif;font-size:15.5px;font-weight:800;color:var(--txt)">{{ po.title }}</span>
                  <span style="font-size:12.5px;color:var(--mut);margin-top:2px;line-height:1.35">{{ po.desc }}</span>
                </div>
              </div>
              <span class="mi" style="font-size:22px;color:{{ po.checkColor }};flex:none">
                {{ po.checkIcon }}
              </span>
            </button>
          </sc-for>
        </div>
      </div>
    </sc-if>

    <!-- QUIZ STEP 4: LUXURY TRICHOLOGICAL PRESCRIPTION CARD (RESULT) -->
    <sc-if value="{{ isQuizResult }}" hint-placeholder-val="{{ false }}">
      <div style="max-width:720px;margin:32px auto 0;border-radius:32px;background:var(--surf);border:2px solid var(--gold);box-shadow:0 24px 60px -12px rgba(168,124,47,.3),var(--e3);padding:clamp(22px,3.8vw,36px);position:relative;z-index:2;animation:slidein .36s cubic-bezier(.2,.8,.2,1)">
        
        <!-- Header Strip -->
        <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;padding-bottom:16px;border-bottom:1px solid var(--line)">
          <div style="display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:999px;background:var(--surf3);font-size:10.5px;letter-spacing:.16em;font-weight:800;color:var(--gold)">
            <span class="mi" style="font-size:15px">verified</span>PRESCRIPCIÓN TRICOLÓGICA LYOS
          </div>
          <button onClick="{{ quizReset }}" style="border:0;background:transparent;color:var(--mut);font-size:12.5px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .2s" style-hover="color:var(--gold)">
            <span class="mi" style="font-size:16px">refresh</span>Repetir o Cambiar Respuestas
          </button>
        </div>

        <!-- Diagnostic Summary Tags Grid -->
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:16px">
          <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:var(--surf2);border:1px solid var(--line2);font-size:11.5px;font-weight:700;color:var(--txt)">
            <span class="mi" style="font-size:15px;color:var(--gold)">waves</span>Fibra: <strong style="color:var(--gold)">{{ quizResult.hairLabel }}</strong>
          </span>
          <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:var(--surf2);border:1px solid var(--line2);font-size:11.5px;font-weight:700;color:var(--txt)">
            <span class="mi" style="font-size:15px;color:var(--gold)">auto_awesome</span>Objetivo: <strong style="color:var(--gold)">{{ quizResult.goalLabel }}</strong>
          </span>
          <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:var(--surf2);border:1px solid var(--line2);font-size:11.5px;font-weight:700;color:var(--txt)">
            <span class="mi" style="font-size:15px;color:var(--gold)">storefront</span>Uso: <strong style="color:var(--gold)">{{ quizResult.profileLabel }}</strong>
          </span>
        </div>

        <!-- Main Product Bundle Spotlight Card -->
        <div style="display:flex;flex-wrap:wrap;gap:20px;align-items:center;margin-top:22px;padding:18px;border-radius:24px;background:linear-gradient(150deg,var(--surf2) 0%,var(--surf3) 100%);border:1.5px solid var(--line2)">
          <span style="width:104px;height:104px;border-radius:22px;background:var(--plinth);overflow:hidden;display:grid;place-items:center;flex:none;border:1.5px solid var(--line2);box-shadow:var(--e1)">
            <img src="{{ quizResult.img }}" alt="" style="width:100%;height:100%;object-fit:contain;padding:6px;mix-blend-mode:multiply" />
          </span>
          <div style="flex:1;min-width:min(100%,260px)">
            <span style="display:inline-block;padding:3px 10px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 4px 10px rgba(168,124,47,.4)">{{ quizResult.badge }}</span>
            <h4 style="font-family:'Outfit',sans-serif;font-size:22px;font-weight:800;color:var(--txt);margin:6px 0 0;line-height:1.15">{{ quizResult.title }}</h4>
            <p style="font-size:13px;color:var(--mut);margin:6px 0 0;line-height:1.45">{{ quizResult.desc }}</p>
          </div>
        </div>

        <!-- Included Checklist -->
        <div style="margin-top:18px;display:grid;gap:8px">
          <span style="font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--mut)">Fórmulas incluidas en tu rutina recomendada:</span>
          <sc-for list="{{ quizResult.items }}" as="it" hint-placeholder-count="3">
            <div style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:var(--txt)">
              <span class="mi" style="font-size:17px;color:var(--gold)">check_circle</span>
              <span>{{ it.name }}</span>
            </div>
          </sc-for>
        </div>

        <!-- Price & Savings Ribbon -->
        <div style="margin-top:20px;padding:16px 20px;border-radius:20px;background:var(--surf2);border:1px solid var(--line2);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px">
          <div>
            <span style="display:block;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--mut);font-weight:700">Precio especial recomendado</span>
            <div style="display:flex;align-items:baseline;gap:8px;margin-top:2px">
              <span style="font-family:'Outfit',sans-serif;font-size:26px;font-weight:800;letter-spacing:-.03em;color:var(--txt)">{{ quizResult.priceLabel }}</span>
              <span style="font-size:14px;color:var(--dim);text-decoration:line-through;font-weight:600">{{ quizResult.oldPriceLabel }}</span>
            </div>
          </div>
          <span style="font-size:11.5px;font-weight:800;color:#25D366;padding:6px 14px;border-radius:999px;background:rgba(37,211,102,.12);border:1px solid rgba(37,211,102,.25)">
            {{ quizResult.saveLabel }}
          </span>
        </div>

        <!-- Action CTAs Row -->
        <div style="display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));margin-top:20px">
          <button onClick="{{ quizResult.add }}" style="height:54px;border:0;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:800;font-size:14.5px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px;box-shadow:0 12px 28px -6px rgba(168,124,47,.7);transition:all .25s" style-hover="filter:brightness(1.08);transform:translateY(-2px)">
            <span class="mi" style="font-size:20px">shopping_bag</span>
            <span>Añadir Rutina al Carrito</span>
          </button>
          <a href="{{ quizResult.waLink }}" target="_blank" style="height:54px;border-radius:999px;background:#25D366;color:#fff;font-weight:800;font-size:14px;display:inline-flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 10px 24px -6px rgba(37,211,102,.6);transition:all .25s;text-decoration:none" style-hover="filter:brightness(1.08);transform:translateY(-2px)">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="#fff" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.92 1.16-.15.2-.3.22-.6.07-.3-.15-1.12-.41-2.14-1.32-.79-.71-1.32-1.58-1.47-1.88-.15-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.08 3.3 5.05 4.5.7.3 1.25.48 1.68.62.71.22 1.35.19 1.86.12.57-.09 1.75-.71 2-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c0 5.19-4.23 9.41-9.43 9.41zm8.02-17.44A11.32 11.32 0 0 0 12.04 1C5.8 1 .73 6.07.73 12.3c0 1.99.52 3.94 1.51 5.66L.5 23.5l5.68-1.49a11.3 11.3 0 0 0 5.86 1.6h.01c6.23 0 11.3-5.07 11.3-11.3 0-3.02-1.18-5.86-3.29-7.98z"/></svg>
            <span>Pedir por WhatsApp con Asesoría</span>
          </a>
        </div>

        <!-- Micro Guarantees Footer -->
        <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:center;margin-top:18px;font-size:11.5px;color:var(--mut);font-weight:600">
          <span style="display:inline-flex;align-items:center;gap:5px"><span class="mi" style="font-size:15px;color:var(--gold)">local_shipping</span>Envío Gratis desde $150.000</span>
          <span style="display:inline-flex;align-items:center;gap:5px"><span class="mi" style="font-size:15px;color:var(--gold)">verified_user</span>100% 0% Formol INVIMA</span>
          <span style="display:inline-flex;align-items:center;gap:5px"><span class="mi" style="font-size:15px;color:var(--gold)">support_agent</span>Asesoría Técnica Continua</span>
        </div>

      </div>
    </sc-if>

  </div>
</section>

<!-- ========================================================================= -->
<!-- COMPARADOR INTERACTIVO ANTES VS. DESPUÉS (BEFORE & AFTER SLIDER)          -->
<!-- ========================================================================= -->
<section id="comparador" style="position:relative;max-width:1320px;margin:clamp(48px,6.5vw,84px) auto 0;padding:0 18px">
  <div style="text-align:center;max-width:760px;margin:0 auto 24px">
    <div style="display:inline-flex;align-items:center;gap:7px;padding:6px 16px;border-radius:999px;background:var(--surf);border:1.5px solid var(--line2);box-shadow:var(--e1);margin-bottom:10px">
      <span class="mi" style="font-size:16px;color:var(--gold)">compare</span>
      <span style="font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:800">Transformación Real · 100% Sin Filtros</span>
    </div>
    <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(28px,4.2vw,44px);font-weight:800;letter-spacing:-.04em;line-height:1.06;margin:0;color:var(--txt)">
      Comprueba el Efecto Espejo LYOS
    </h2>
    <p style="font-size:14.5px;color:var(--mut);margin:8px auto 0;line-height:1.6;max-width:54ch">
      Arrastra la barra central para comparar la fibra con frizz vs. el sellado espejo con <strong>Ácido Hialurónico y Murumuru</strong>.
    </p>
  </div>

  <!-- Interactive Split Drag Stage -->
  <div style="position:relative;max-width:960px;margin:0 auto;border-radius:32px;overflow:hidden;border:2px solid var(--line2);box-shadow:0 24px 60px -15px rgba(0,0,0,.25),var(--e3);background:#000;aspect-ratio:16/9;min-height:340px;user-select:none">
    
    <!-- Image 1: Before (Untreated / Frizz background) -->
    <div style="position:absolute;inset:0;width:100%;height:100%;background:url('assets/antes-frizz.jpg') center center/cover no-repeat">
      <span style="position:absolute;bottom:20px;left:20px;z-index:5;padding:7px 16px;border-radius:999px;background:rgba(14,11,7,.85);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.2);color:#FFFDF8;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 4px 14px rgba(0,0,0,.4);pointer-events:none">
        ANTES: Fibra con Frizz &amp; Volumen
      </span>
    </div>

    <!-- Image 2: After (Smooth Mirror Hair overlay with clip-path) -->
    <div style="position:absolute;inset:0;width:100%;height:100%;clip-path:inset(0 0 0 {{ beforeAfterPos }}%);background:url('assets/despues-liso.jpg') center center/cover no-repeat">
      <span style="position:absolute;bottom:20px;right:20px;z-index:5;padding:7px 16px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 6px 20px rgba(0,0,0,.45);pointer-events:none">
        DESPUÉS: Liso Hialurónico ✨
      </span>
    </div>

    <!-- Divider Line with Golden Central Drag Handle -->
    <div style="position:absolute;top:0;bottom:0;left:{{ beforeAfterPos }}%;width:3px;background:linear-gradient(180deg,rgba(255,255,255,.3),#E2C88E 25%,#C39D51 75%,rgba(255,255,255,.3));transform:translateX(-50%);pointer-events:none;z-index:10;box-shadow:0 0 12px rgba(201,164,92,.8)">
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:46px;height:46px;border-radius:999px;background:var(--surf);border:2.5px solid var(--gold);box-shadow:0 8px 26px rgba(0,0,0,.5);display:grid;place-items:center;color:var(--gold);cursor:ew-resize">
        <span class="mi" style="font-size:22px">compare_arrows</span>
      </div>
    </div>

    <!-- Invisible Range Input Controller overlay for smooth touch/mouse scrubbing -->
    <input type="range" min="0" max="100" value="{{ beforeAfterPos }}" onInput="{{ onBeforeAfterInput }}" aria-label="Deslizar comparativa antes y después" style="position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0;z-index:20" />
  </div>

  <!-- Action CTAs Row -->
  <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:12px;margin-top:22px">
    <a href="#productos" style="display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 24px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:700;font-size:13.5px;text-decoration:none;box-shadow:0 8px 24px -6px rgba(168,124,47,.65);transition:all .25s" style-hover="filter:brightness(1.08);transform:translateY(-2px);color:var(--onGold)">
      <span class="mi" style="font-size:19px;color:var(--onGold)">shopping_bag</span>
      <span style="color:var(--onGold)">Comprar Liso Hialurónico Oficial</span>
    </a>
    <a href="#contacto" style="display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 22px;border-radius:999px;border:1.5px solid var(--line2);background:var(--surf);color:var(--txt);font-weight:700;font-size:13.5px;text-decoration:none;transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold);transform:translateY(-1px)">
      <span class="mi" style="font-size:19px;color:var(--gold)">support_agent</span>
      <span>Asesoría Personalizada</span>
    </a>
  </div>
</section>

<!-- ========================================================================= -->
<!-- SESIÓN VIP 1-A-1 & CONSULTORÍA DIRECTA LYOS (DARK PRO LUXURY EXPERIENCE)  -->
<!-- ========================================================================= -->
<section id="agendar" style="position:relative;margin-top:clamp(56px,8vw,104px);padding:clamp(60px,8vw,100px) 0;background:radial-gradient(circle at 50% -10%,#241A0E 0%,#110E0A 36%,#070604 100%);border-top:1.5px solid rgba(212,175,55,.35);border-bottom:1.5px solid rgba(212,175,55,.35);color:#FBF8F2;overflow:hidden;box-shadow:0 30px 90px -20px rgba(0,0,0,.85)">
  
  <!-- Subtle ambient decorative glow spheres in gold -->
  <div style="position:absolute;top:0;left:50%;transform:translateX(-50%);width:min(1000px,96vw);height:420px;background:radial-gradient(ellipse,rgba(212,175,55,.22) 0%,rgba(168,124,47,.08) 45%,transparent 70%);filter:blur(60px);pointer-events:none"></div>
  <div style="position:absolute;bottom:0;right:5%;width:420px;height:420px;background:radial-gradient(circle,rgba(212,175,55,.12) 0%,transparent 70%);filter:blur(50px);pointer-events:none"></div>

  <div style="max-width:1320px;margin:0 auto;padding:0 18px;position:relative;z-index:2">
    
    <!-- Section Header with Ultra-Luxury Dark Styling -->
    <div style="text-align:center;max-width:860px;margin:0 auto">
      <div style="display:inline-flex;align-items:center;gap:9px;padding:8px 20px;border-radius:999px;background:rgba(18,14,10,.85);border:1.5px solid rgba(212,175,55,.45);box-shadow:0 8px 24px -4px rgba(0,0,0,.6),0 0 20px rgba(212,175,55,.25);margin-bottom:20px;backdrop-filter:blur(14px)">
        <span style="width:9px;height:9px;border-radius:999px;background:#25D366;box-shadow:0 0 12px #25D366;animation:ping 2.2s ease-out infinite;display:inline-block"></span>
        <span style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#F1DEB8;font-weight:800">SESIÓN 1 A 1 DIRECTA · AGENDA VIP ABIERTA</span>
      </div>
      
      <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(34px,5.6vw,60px);font-weight:800;letter-spacing:-.045em;line-height:1.04;margin:0;color:#FFFDF8">
        Comunícate con el Equipo de<br>
        <span style="font-family:'Kaushan Script',cursive;font-weight:400;font-size:.96em;letter-spacing:0;background:linear-gradient(120deg,#FFF6DD,#E2C88E 38%,#D4AF37 70%,#F5EDDF);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">LYOS Profesional &amp; Tina Belleza</span>
      </h2>
      
      <p style="font-size:clamp(15px,1.5vw,17px);color:#C8BFA8;margin:18px auto 0;line-height:1.68;max-width:62ch">
        Agenda tu sesión personalizada de <strong>45 min a 3 horas</strong>. Analizamos tus casos en salón, resolvemos compatibilidad de fórmulas sin formol, estructuramos tu pedido mayorista con precios de fábrica o te guiamos en la certificación oficial.
      </p>
    </div>

    <!-- 3 High Value Pillars Grid -->
    <div style="display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));margin-top:40px;align-items:stretch">
      
      <!-- Pillar 1: Tricología & Protocolos -->
      <div style="padding:24px 26px;border-radius:26px;background:rgba(18,14,10,.75);border:1.5px solid rgba(212,175,55,.22);backdrop-filter:blur(16px);box-shadow:0 14px 34px -10px rgba(0,0,0,.7);display:flex;flex-direction:column;gap:12px;transition:all .3s" style-hover="border-color:rgba(212,175,55,.6);transform:translateY(-3px)">
        <div style="display:flex;align-items:center;justify-content:space-between">
          <div style="width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,#D4AF37,#8E651E);display:grid;place-items:center;color:#100E0B;box-shadow:0 8px 18px -4px rgba(212,175,55,.5)">
            <span class="mi" style="font-size:24px">science</span>
          </div>
          <span style="font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#F1DEB8;font-weight:800;padding:4px 10px;border-radius:999px;background:rgba(212,175,55,.14);border:1px solid rgba(212,175,55,.25)">Técnica &amp; Salón</span>
        </div>
        <h3 style="font-family:'Outfit',sans-serif;font-size:19px;font-weight:800;letter-spacing:-.025em;color:#FFFDF8;margin:4px 0 0">
          Diagnóstico y Protocolo Capilar
        </h3>
        <p style="font-size:13.5px;line-height:1.6;color:#B9B09C;margin:0">
          ¿Dudas con cabellos decolorados o crespos difíciles? Te indicamos la curva térmica precisa, número de pasadas y sellado espejo para resultados sin formol garantizados.
        </p>
      </div>

      <!-- Pillar 2: Precios Mayoristas & Negocio -->
      <div style="padding:24px 26px;border-radius:26px;background:rgba(18,14,10,.75);border:1.5px solid rgba(212,175,55,.22);backdrop-filter:blur(16px);box-shadow:0 14px 34px -10px rgba(0,0,0,.7);display:flex;flex-direction:column;gap:12px;transition:all .3s" style-hover="border-color:rgba(212,175,55,.6);transform:translateY(-3px)">
        <div style="display:flex;align-items:center;justify-content:space-between">
          <div style="width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,#D4AF37,#8E651E);display:grid;place-items:center;color:#100E0B;box-shadow:0 8px 18px -4px rgba(212,175,55,.5)">
            <span class="mi" style="font-size:24px">inventory_2</span>
          </div>
          <span style="font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#F1DEB8;font-weight:800;padding:4px 10px;border-radius:999px;background:rgba(212,175,55,.14);border:1px solid rgba(212,175,55,.25)">Mayoristas &amp; Spas</span>
        </div>
        <h3 style="font-family:'Outfit',sans-serif;font-size:19px;font-weight:800;letter-spacing:-.025em;color:#FFFDF8;margin:4px 0 0">
          Distribución &amp; Márgenes VIP
        </h3>
        <p style="font-size:13.5px;line-height:1.6;color:#B9B09C;margin:0">
          Precios de escala directa de fábrica, protección de zonas y material publicitario para que tu negocio o peluquería genere hasta un 300% de rentabilidad neta.
        </p>
      </div>

      <!-- Pillar 3: Academia & Formación -->
      <div style="padding:24px 26px;border-radius:26px;background:rgba(18,14,10,.75);border:1.5px solid rgba(212,175,55,.22);backdrop-filter:blur(16px);box-shadow:0 14px 34px -10px rgba(0,0,0,.7);display:flex;flex-direction:column;gap:12px;transition:all .3s" style-hover="border-color:rgba(212,175,55,.6);transform:translateY(-3px)">
        <div style="display:flex;align-items:center;justify-content:space-between">
          <div style="width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,#D4AF37,#8E651E);display:grid;place-items:center;color:#100E0B;box-shadow:0 8px 18px -4px rgba(212,175,55,.5)">
            <span class="mi" style="font-size:24px">school</span>
          </div>
          <span style="font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#F1DEB8;font-weight:800;padding:4px 10px;border-radius:999px;background:rgba(212,175,55,.14);border:1px solid rgba(212,175,55,.25)">Academia &amp; Aval</span>
        </div>
        <h3 style="font-family:'Outfit',sans-serif;font-size:19px;font-weight:800;letter-spacing:-.025em;color:#FFFDF8;margin:4px 0 0">
          Masterclass &amp; Certificación
        </h3>
        <p style="font-size:13.5px;line-height:1.6;color:#B9B09C;margin:0">
          Conoce las fechas de las formaciones intensivas presenciales en Cali o la modalidad virtual con certificación oficial, tricología y acompañamiento continuo.
        </p>
      </div>

    </div>

    <!-- MAIN CAL.COM EMBEDDED LUXURY COCKPIT -->
    <div style="max-width:1120px;margin:36px auto 0;border-radius:32px;background:linear-gradient(160deg,#14100B 0%,#090805 100%);border:2px solid rgba(212,175,55,.45);box-shadow:0 30px 90px -15px rgba(0,0,0,.95),0 0 35px rgba(212,175,55,.18);padding:clamp(16px,2.8vw,28px);position:relative">
      
      <!-- Cockpit Bar Header -->
      <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;padding-bottom:16px;border-bottom:1px solid rgba(212,175,55,.2);margin-bottom:18px">
        <div style="display:flex;align-items:center;gap:10px">
          <div style="width:38px;height:38px;border-radius:999px;background:rgba(212,175,55,.15);border:1px solid rgba(212,175,55,.4);display:grid;place-items:center;color:#D4AF37">
            <span class="mi" style="font-size:21px">calendar_month</span>
          </div>
          <div>
            <span style="display:block;font-family:'Outfit',sans-serif;font-size:16px;font-weight:800;color:#FFFDF8;letter-spacing:-.015em">
              Elige tu Horario de Comunicación
            </span>
            <span style="display:block;font-size:11.5px;color:#A79E90">
              Duración: 45 min · 2 horas · 3 horas · Zona Horaria: America/Bogota (Detectada)
            </span>
          </div>
        </div>

        <div style="display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:999px;background:rgba(37,211,102,.12);border:1px solid rgba(37,211,102,.3);font-size:11px;font-weight:800;color:#25D366">
          <span style="width:7px;height:7px;border-radius:999px;background:#25D366;box-shadow:0 0 8px #25D366"></span>
          <span>SIN COSTO · CUPOS EN VIVO</span>
        </div>
      </div>

      <!-- Cal.com Interactive Embed Stage -->
      <div style="position:relative;width:100%;min-height:clamp(620px,78vh,760px);border-radius:22px;overflow:hidden;background:#0B0A08;border:1px solid rgba(232,214,180,.14);box-shadow:inset 0 2px 24px rgba(0,0,0,.8)">
        
        <!-- Cal inline embed code begins -->
        <div style="width:100%;height:100%;min-height:clamp(620px,78vh,760px);overflow:scroll" id="my-cal-inline-lyospro"></div>
        <!-- Cal inline embed code ends -->

      </div>

      <!-- Trust Bar & WhatsApp Backup Strip -->
      <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;margin-top:20px;padding-top:16px;border-top:1px solid rgba(212,175,55,.18)">
        
        <div style="display:flex;flex-wrap:wrap;gap:18px;align-items:center;font-size:12.5px;color:#C8BFA8;font-weight:600">
          <span style="display:inline-flex;align-items:center;gap:6px">
            <span class="mi" style="font-size:17px;color:#D4AF37">verified_user</span>
            <span>Confirmación instantánea con enlace de videollamada</span>
          </span>
          <span style="display:inline-flex;align-items:center;gap:6px">
            <span class="mi" style="font-size:17px;color:#D4AF37">support_agent</span>
            <span>Atención directa por Tina Belleza &amp; Especialistas LYOS</span>
          </span>
        </div>

        <a href="{{ waLink }}" target="_blank" style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:999px;background:#25D366;color:#fff;font-size:13px;font-weight:800;box-shadow:0 8px 22px -6px rgba(37,211,102,.6);transition:all .25s" style-hover="filter:brightness(1.08);transform:scale(1.03)">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="#fff" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.92 1.16-.15.2-.3.22-.6.07-.3-.15-1.12-.41-2.14-1.32-.79-.71-1.32-1.58-1.47-1.88-.15-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.08 3.3 5.05 4.5.7.3 1.25.48 1.68.62.71.22 1.35.19 1.86.12.57-.09 1.75-.71 2-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c0 5.19-4.23 9.41-9.43 9.41zm8.02-17.44A11.32 11.32 0 0 0 12.04 1C5.8 1 .73 6.07.73 12.3c0 1.99.52 3.94 1.51 5.66L.5 23.5l5.68-1.49a11.3 11.3 0 0 0 5.86 1.6h.01c6.23 0 11.3-5.07 11.3-11.3 0-3.02-1.18-5.86-3.29-7.98z"/></svg>
          <span>¿Urgente? Escríbenos por WhatsApp</span>
        </a>

      </div>

    </div>

  </div>
</section>

<section id="resenas" style="position:relative;margin-top:clamp(52px,7.5vw,96px);padding:clamp(52px,7.5vw,96px) 0;background:linear-gradient(180deg,var(--bg) 0%,var(--bg2) 50%,var(--bg) 100%);border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden">
  
  <!-- Subtle ambient gold glow -->
  <div style="position:absolute;top:15%;left:50%;transform:translateX(-50%);width:min(1000px,96vw);height:360px;background:radial-gradient(ellipse,rgba(201,164,92,.16) 0%,rgba(138,100,37,.03) 50%,transparent 70%);filter:blur(60px);pointer-events:none"></div>

  <div style="max-width:1320px;margin:0 auto;padding:0 18px;position:relative;z-index:2">
    
    <!-- Section Header with Google Social Proof Badge -->
    <div style="text-align:center;max-width:800px;margin:0 auto">
      <div style="display:inline-flex;align-items:center;gap:9px;padding:7px 18px;border-radius:999px;background:var(--surf);border:1px solid var(--line2);box-shadow:var(--e1);margin-bottom:16px">
        <!-- Google Multi-color G Icon -->
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/></svg>
        <span style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:800">Google Reviews · Calificación 4.9 / 5.0</span>
      </div>

      <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(32px,5.2vw,58px);font-weight:800;letter-spacing:-.045em;line-height:1.04;margin:0;color:var(--txt)">
        Lo que dicen<br>
        <span style="font-family:'Kaushan Script',cursive;font-weight:400;font-size:.94em;letter-spacing:0;background:var(--goldGrad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">las profesionales del país</span>
      </h2>

      <p style="font-size:15.5px;color:var(--mut);margin:16px auto 0;line-height:1.65;max-width:56ch">
        Más de 4.200 salones, coloristas y estilistas independientes certifican el brillo espejo, cero formol y alta rentabilidad de las fórmulas LYOS.
      </p>
    </div>

    <!-- 4 Minimalist Metric Badges (Modern Luxury Horizontal Strip) -->
    <div style="display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));margin-top:clamp(30px,4.2vw,48px)">
      
      <!-- Metric 1 -->
      <div style="padding:18px 20px;border-radius:24px;background:var(--surf);border:1.5px solid var(--line2);box-shadow:var(--e1);display:flex;align-items:center;gap:14px;transition:all .25s" style-hover="border-color:var(--gold);transform:translateY(-2px)">
        <div style="width:46px;height:46px;border-radius:16px;background:var(--surf3);color:var(--gold);display:grid;place-items:center;flex:none;box-shadow:var(--e1)">
          <span class="mi" style="font-size:24px">star</span>
        </div>
        <div>
          <span style="font-family:'Outfit',sans-serif;font-size:24px;font-weight:800;letter-spacing:-.03em;color:var(--txt);line-height:1">4.9 / 5.0</span>
          <span style="display:block;font-size:11.5px;color:var(--mut);font-weight:600;margin-top:3px">Calificación Global Google</span>
        </div>
      </div>

      <!-- Metric 2 -->
      <div style="padding:18px 20px;border-radius:24px;background:var(--surf);border:1.5px solid var(--line2);box-shadow:var(--e1);display:flex;align-items:center;gap:14px;transition:all .25s" style-hover="border-color:var(--gold);transform:translateY(-2px)">
        <div style="width:46px;height:46px;border-radius:16px;background:var(--surf3);color:var(--gold);display:grid;place-items:center;flex:none;box-shadow:var(--e1)">
          <span class="mi" style="font-size:24px">storefront</span>
        </div>
        <div>
          <span style="font-family:'Outfit',sans-serif;font-size:24px;font-weight:800;letter-spacing:-.03em;color:var(--txt);line-height:1">+4.200</span>
          <span style="display:block;font-size:11.5px;color:var(--mut);font-weight:600;margin-top:3px">Salones &amp; Spas Aliados</span>
        </div>
      </div>

      <!-- Metric 3 -->
      <div style="padding:18px 20px;border-radius:24px;background:var(--surf);border:1.5px solid var(--line2);box-shadow:var(--e1);display:flex;align-items:center;gap:14px;transition:all .25s" style-hover="border-color:var(--gold);transform:translateY(-2px)">
        <div style="width:46px;height:46px;border-radius:16px;background:var(--surf3);color:var(--gold);display:grid;place-items:center;flex:none;box-shadow:var(--e1)">
          <span class="mi" style="font-size:24px">health_and_safety</span>
        </div>
        <div>
          <span style="font-family:'Outfit',sans-serif;font-size:24px;font-weight:800;letter-spacing:-.03em;color:var(--txt);line-height:1">0% Formol</span>
          <span style="display:block;font-size:11.5px;color:var(--mut);font-weight:600;margin-top:3px">Sin humo ni toxicidad</span>
        </div>
      </div>

      <!-- Metric 4 -->
      <div style="padding:18px 20px;border-radius:24px;background:var(--surf);border:1.5px solid var(--line2);box-shadow:var(--e1);display:flex;align-items:center;gap:14px;transition:all .25s" style-hover="border-color:var(--gold);transform:translateY(-2px)">
        <div style="width:46px;height:46px;border-radius:16px;background:var(--surf3);color:var(--gold);display:grid;place-items:center;flex:none;box-shadow:var(--e1)">
          <span class="mi" style="font-size:24px">repeat</span>
        </div>
        <div>
          <span style="font-family:'Outfit',sans-serif;font-size:24px;font-weight:800;letter-spacing:-.03em;color:var(--txt);line-height:1">98.4%</span>
          <span style="display:block;font-size:11.5px;color:var(--mut);font-weight:600;margin-top:3px">Tasa de Recompra Mensual</span>
        </div>
      </div>

    </div>

    <!-- Category Filter Pills -->
    <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:36px">
      <sc-for list="{{ reviewCategories }}" as="rc" hint-placeholder-count="4">
        <button onClick="{{ rc.pick }}" style="{{ rc.style }}" style-hover="border-color:var(--gold);transform:translateY(-1px)">
          <span>{{ rc.label }}</span>
        </button>
      </sc-for>
    </div>

    <!-- Modern Luxury Reviews Grid (3-Column Clean Editorial Design) -->
    <div style="display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(min(100%,350px),1fr));margin-top:26px;align-items:stretch">
      <sc-for list="{{ reviewsList }}" as="rev" hint-placeholder-count="3">
        <article style="padding:28px 26px;border-radius:28px;background:var(--surf);border:1.5px solid var(--line2);box-shadow:var(--e1);display:flex;flex-direction:column;justify-content:space-between;gap:16px;transition:all .3s cubic-bezier(.2,.8,.2,1);position:relative;overflow:hidden" style-hover="border-color:var(--gold);transform:translateY(-4px);box-shadow:0 18px 45px -10px rgba(168,124,47,.22)">
          
          <!-- Top Row: Stylist Monogram + Info & Badge -->
          <div>
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
              <div style="display:flex;align-items:center;gap:12px;min-width:0;flex:1">
                <span style="width:44px;height:44px;border-radius:999px;background:{{ rev.avatarGrad }};display:grid;place-items:center;color:#FFFDF8;font-family:'Outfit',sans-serif;font-weight:800;font-size:15px;flex:none;box-shadow:0 4px 12px rgba(0,0,0,.25);border:2px solid var(--surf)">
                  {{ rev.initials }}
                </span>
                <div style="display:grid;gap:2px;min-width:0">
                  <h4 style="font-family:'Outfit',sans-serif;font-size:15.5px;font-weight:800;color:var(--txt);margin:0;letter-spacing:-.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                    {{ rev.name }}
                  </h4>
                  <span style="font-size:11.5px;color:var(--mut);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                    {{ rev.role }} · <strong style="color:var(--txt)">{{ rev.city }}</strong>
                  </span>
                </div>
              </div>

              <!-- Verified Badge -->
              <sc-if value="{{ rev.isVerified }}" hint-placeholder-val="{{ true }}">
                <span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:800;color:#25D366;padding:4px 10px;border-radius:999px;background:rgba(37,211,102,.12);border:1px solid rgba(37,211,102,.25);white-space:nowrap;flex:none">
                  <span class="mi" style="font-size:13px">verified</span>{{ rev.badge }}
                </span>
              </sc-if>
              <sc-if value="{{ rev.isAcademy }}" hint-placeholder-val="{{ false }}">
                <span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:800;color:var(--gold);padding:4px 10px;border-radius:999px;background:var(--surf3);border:1px solid rgba(212,175,55,.3);white-space:nowrap;flex:none">
                  <span class="mi" style="font-size:13px">school</span>{{ rev.badge }}
                </span>
              </sc-if>
            </div>

            <!-- Stars & Relative Time -->
            <div style="display:flex;align-items:center;justify-content:space-between;margin-top:14px;padding-top:12px;border-top:1px solid var(--line)">
              <div style="color:var(--gold);letter-spacing:2px;font-size:14px">{{ rev.stars }}</div>
              <span style="font-size:11px;color:var(--dim);font-weight:600">{{ rev.date }}</span>
            </div>

            <!-- Highlight Tag Pill -->
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:10px">
              <span style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;padding:4px 10px;border-radius:999px;background:var(--surf2);border:1px solid var(--line2);color:var(--gold)">
                {{ rev.keyTag }}
              </span>
            </div>

            <!-- Quote Text -->
            <p style="font-size:14px;line-height:1.65;color:var(--txt);margin:14px 0 0;font-weight:500">
              "{{ rev.quote }}"
            </p>
          </div>

          <!-- Card Footer: Specific Formula Used -->
          <div style="display:flex;align-items:center;justify-content:space-between;padding-top:12px;border-top:1px solid var(--line);font-size:11.5px;color:var(--mut)">
            <span style="display:inline-flex;align-items:center;gap:5px">
              <span class="mi" style="font-size:15px;color:var(--gold)">science</span>
              <strong style="color:var(--txt);font-weight:700">{{ rev.formula }}</strong>
            </span>
            <span class="mi" style="font-size:16px;color:#25D366" title="Reseña verificada">verified_user</span>
          </div>

        </article>
      </sc-for>
    </div>

    <!-- Bottom Action & Google Verification Strip -->
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:18px;margin-top:40px;padding:22px 28px;border-radius:26px;background:linear-gradient(150deg,var(--surf) 0%,var(--surf2) 100%);border:1.5px solid var(--line2);box-shadow:var(--e2)">
      <div style="display:flex;align-items:center;gap:14px">
        <span style="width:44px;height:44px;border-radius:999px;background:var(--surf3);display:grid;place-items:center;color:var(--gold);flex:none;box-shadow:var(--e1)">
          <span class="mi" style="font-size:22px">rate_review</span>
        </span>
        <div>
          <span style="display:block;font-size:14.5px;font-weight:800;color:var(--txt);letter-spacing:-.01em">¿Eres estilista, dueña de salón o clienta LYOS?</span>
          <span style="display:block;font-size:12px;color:var(--mut);margin-top:2px">Comparte tu resultado por WhatsApp y recibe <strong>10% OFF</strong> en tu siguiente pedido.</span>
        </div>
      </div>

      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px">
        <a href="{{ waLink }}" target="_blank" style="display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 22px;border-radius:999px;background:#25D366;color:#fff;font-size:13.5px;font-weight:800;text-decoration:none;box-shadow:0 8px 20px -6px rgba(37,211,102,.7);transition:all .25s" style-hover="filter:brightness(1.08);transform:translateY(-2px)">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="#fff" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.92 1.16-.15.2-.3.22-.6.07-.3-.15-1.12-.41-2.14-1.32-.79-.71-1.32-1.58-1.47-1.88-.15-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.08 3.3 5.05 4.5.7.3 1.25.48 1.68.62.71.22 1.35.19 1.86.12.57-.09 1.75-.71 2-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c0 5.19-4.23 9.41-9.43 9.41zm8.02-17.44A11.32 11.32 0 0 0 12.04 1C5.8 1 .73 6.07.73 12.3c0 1.99.52 3.94 1.51 5.66L.5 23.5l5.68-1.49a11.3 11.3 0 0 0 5.86 1.6h.01c6.23 0 11.3-5.07 11.3-11.3 0-3.02-1.18-5.86-3.29-7.98z"/></svg>
          <span>Dejar mi Reseña por WhatsApp</span>
        </a>
      </div>
    </div>

  </div>
</section>

<!-- ========================================================================= -->
<!-- CALCULADORA DE RENTABILIDAD PARA SALONES & ESTILISTAS (ROI SIMULATOR)     -->
<!-- ========================================================================= -->
<section id="calculadora" style="position:relative;max-width:1320px;margin:clamp(52px,7.5vw,96px) auto 0;padding:0 18px">
  
  <div style="border-radius:36px;background:linear-gradient(150deg,var(--surf) 0%,var(--surf2) 100%);border:1.5px solid var(--line2);box-shadow:var(--e3);padding:clamp(26px,4vw,52px);position:relative;overflow:hidden">
    
    <div style="display:grid;gap:clamp(28px,4vw,48px);grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));align-items:center">
      
      <!-- Left Column: Sliders Controller -->
      <div>
        <div style="display:inline-flex;align-items:center;gap:7px;padding:6px 16px;border-radius:999px;background:var(--surf3);border:1px solid var(--line);font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:800;margin-bottom:14px">
          <span class="mi" style="font-size:16px">payments</span>Simulador Financiero VIP
        </div>
        
        <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(28px,4.4vw,48px);font-weight:800;letter-spacing:-.04em;line-height:1.06;margin:0;color:var(--txt)">
          Calcula tu Rentabilidad en Salón
        </h2>
        
        <p style="font-size:14.5px;color:var(--mut);margin:10px 0 0;line-height:1.6;max-width:48ch">
          1 Litro de <strong>Liso Hialurónico</strong> rinde hasta 14 aplicaciones profesionales. Descubre tu retorno de inversión mensual estimado.
        </p>

        <!-- Slider 1: Alisados al mes -->
        <div style="margin-top:28px;padding:18px;border-radius:20px;background:var(--surf);border:1px solid var(--line)">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span style="font-size:13px;font-weight:800;color:var(--txt)">Alisados realizados al mes</span>
            <span style="font-family:'Outfit',sans-serif;font-size:20px;font-weight:800;color:var(--gold)">{{ roiClients }} clientes</span>
          </div>
          <input type="range" min="1" max="40" value="{{ roiClients }}" onInput="{{ onRoiClientsInput }}" style="width:100%;margin-top:12px;accent-color:var(--gold);cursor:pointer" />
          <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--dim);margin-top:4px">
            <span>1 aplicación</span>
            <span>20 aplicaciones</span>
            <span>40 aplicaciones</span>
          </div>
        </div>

        <!-- Slider 2: Precio cobrado por servicio -->
        <div style="margin-top:14px;padding:18px;border-radius:20px;background:var(--surf);border:1px solid var(--line)">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span style="font-size:13px;font-weight:800;color:var(--txt)">Cobro promedio por servicio</span>
            <span style="font-family:'Outfit',sans-serif;font-size:20px;font-weight:800;color:var(--gold)">{{ roiPriceLabel }}</span>
          </div>
          <input type="range" min="120000" max="450000" step="10000" value="{{ roiPrice }}" onInput="{{ onRoiPriceInput }}" style="width:100%;margin-top:12px;accent-color:var(--gold);cursor:pointer" />
          <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--dim);margin-top:4px">
            <span>$ 120.000</span>
            <span>$ 280.000</span>
            <span>$ 450.000</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Live Financial KPI Dashboard -->
      <div style="border-radius:28px;background:linear-gradient(160deg,#16120D 0%,#0C0906 100%);border:2px solid rgba(212,175,55,.4);box-shadow:0 24px 60px -15px rgba(0,0,0,.7);padding:clamp(22px,3.4vw,36px);color:#FFFDF8">
        
        <div style="display:flex;align-items:center;justify-content:space-between;padding-bottom:14px;border-bottom:1px solid rgba(212,175,55,.2)">
          <span style="font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#F1DEB8;font-weight:800">PROYECCIÓN MENSUAL ESTIMADA</span>
          <span style="font-size:11px;font-weight:800;padding:4px 10px;border-radius:999px;background:rgba(37,211,102,.2);color:#25D366">+{{ roiMargin }}% ROI</span>
        </div>

        <div style="display:grid;gap:16px;margin:20px 0">
          
          <div>
            <span style="font-size:12px;color:rgba(255,253,248,.7);font-weight:600">Ganancia Neta Mensual en Salón</span>
            <div style="font-family:'Outfit',sans-serif;font-size:clamp(34px,4.6vw,48px);font-weight:800;letter-spacing:-.04em;background:linear-gradient(120deg,#FFF6DD,#E2C88E 40%,#C39D51 80%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;line-height:1.1;margin-top:2px">
              {{ roiNetLabel }}
            </div>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:14px;border-radius:18px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1)">
            <div>
              <span style="font-size:11px;color:#A79E90;display:block">Facturación Bruta</span>
              <span style="font-family:'Outfit',sans-serif;font-size:17px;font-weight:800;color:#FFFDF8;margin-top:2px;display:block">{{ roiGrossLabel }}</span>
            </div>
            <div>
              <span style="font-size:11px;color:#A79E90;display:block">Costo Producto LYOS</span>
              <span style="font-family:'Outfit',sans-serif;font-size:17px;font-weight:800;color:#F1DEB8;margin-top:2px;display:block">{{ roiCostLabel }}</span>
            </div>
          </div>

        </div>

        <div style="display:flex;flex-direction:column;gap:10px;margin-top:22px;padding-top:16px;border-top:1px solid rgba(212,175,55,.2)">
          <a href="{{ roiWaLink }}" target="_blank" style="display:flex;align-items:center;justify-content:center;gap:8px;height:52px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:800;font-size:14px;box-shadow:0 10px 24px -6px rgba(168,124,47,.7);transition:all .25s" style-hover="filter:brightness(1.08);transform:translateY(-1px)">
            <span class="mi" style="font-size:19px">storefront</span>
            <span>Pedir Litro Profesional con Descuento</span>
          </a>
          <a href="{{ waAcademia }}" target="_blank" style="display:flex;align-items:center;justify-content:center;gap:8px;height:48px;border-radius:999px;border:1px solid rgba(255,255,255,.25);background:transparent;color:#FFFDF8;font-weight:700;font-size:13.5px" style-hover="background:rgba(255,255,255,.1)">
            <span class="mi" style="font-size:18px;color:#25D366">school</span>
            <span>Solicitar Asesoría para Mi Salón</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>



<!-- Section: Master Showcase Cards (Academia & Visión Cristina) -->
<section id="mas" style="max-width:1320px;margin:0 auto;padding:clamp(28px,4vw,44px) 18px 0">
  <div style="display:grid;gap:clamp(18px,2.4vw,26px);grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))">
    
    <!-- Card 1: Academia LYOS -->
    <a href="{{ waAcademia }}" target="_blank" style="position:relative;border-radius:32px;overflow:hidden;min-height:clamp(260px,30vw,340px);display:flex;align-items:flex-end;border:1.5px solid var(--line2);box-shadow:var(--e3);color:var(--txt);transition:transform .4s cubic-bezier(.2,.8,.2,1),box-shadow .4s" style-hover="transform:translateY(-6px);box-shadow:0 24px 60px -15px rgba(0,0,0,.45)">
      <img src="assets/equipo-gold.jpg" alt="LYOS Academia" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 36%;transition:transform .7s" style-hover="transform:scale(1.05)" />
      <span style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,11,7,.2) 0%,rgba(14,11,7,.6) 45%,rgba(14,11,7,.95) 100%)"></span>
      
      <span style="position:relative;padding:clamp(24px,3.4vw,36px);width:100%;z-index:2">
        <span style="display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:999px;border:1px solid rgba(241,222,184,.4);background:rgba(14,11,7,.6);backdrop-filter:blur(12px);font-size:10px;letter-spacing:.2em;text-transform:uppercase;font-weight:800;color:#F1DEB8">
          <span style="width:6px;height:6px;border-radius:999px;background:var(--gold);display:inline-block"></span>
          Formación Continua
        </span>
        
        <h3 style="display:block;margin:12px 0 0;font-family:'Outfit',sans-serif;font-size:clamp(24px,3vw,34px);font-weight:800;letter-spacing:-.035em;color:#FFFDF8">
          Academia Profesional LYOS
        </h3>
        
        <p style="margin:8px 0 0;font-size:14px;line-height:1.6;color:rgba(255,253,248,.84);max-width:44ch">
          Tricología, diagnóstico con capilógrafo y técnicas de alisado brasileño. Cupos exclusivos por cohorte.
        </p>
        
        <span style="display:inline-flex;align-items:center;gap:8px;margin-top:20px;height:46px;padding:0 22px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:700;font-size:14px;box-shadow:0 10px 24px -6px rgba(168,124,47,.7)">
          <span class="mi" style="font-size:19px">chat</span>
          <span>Consultar Próximas Fechas</span>
        </span>
      </span>
    </a>

    <!-- Card 2: Cristina Gutiérrez -->
    <a href="{{ waLink }}" target="_blank" style="position:relative;border-radius:32px;overflow:hidden;min-height:clamp(260px,30vw,340px);display:flex;align-items:flex-end;border:1.5px solid var(--line2);box-shadow:var(--e3);color:var(--txt);transition:transform .4s cubic-bezier(.2,.8,.2,1),box-shadow .4s" style-hover="transform:translateY(-6px);box-shadow:0 24px 60px -15px rgba(0,0,0,.45)">
      <img src="assets/cristina-cutout.png" alt="Cristina Gutiérrez, CEO LYOS" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 12%;background:linear-gradient(160deg,#2A2318 0%,#0D0B08 100%);transition:transform .7s" style-hover="transform:scale(1.05)" />
      <span style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,11,7,.1) 0%,rgba(14,11,7,.5) 45%,rgba(14,11,7,.95) 100%)"></span>
      
      <span style="position:relative;padding:clamp(24px,3.4vw,36px);width:100%;z-index:2">
        <span style="display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:999px;border:1px solid rgba(241,222,184,.4);background:rgba(14,11,7,.6);backdrop-filter:blur(12px);font-size:10px;letter-spacing:.2em;text-transform:uppercase;font-weight:800;color:#F1DEB8">
          <span style="width:6px;height:6px;border-radius:999px;background:#25D366;display:inline-block"></span>
          Dirección &amp; Filosofía
        </span>
        
        <span style="display:block;margin-top:10px;font-family:'Kaushan Script',cursive;font-size:clamp(28px,3.6vw,42px);color:#F1DEB8;line-height:1.05">
          Cristina Gutiérrez
        </span>
        
        <p style="margin:6px 0 0;font-size:14px;line-height:1.6;color:rgba(255,253,248,.84);max-width:44ch">
          De estilista de salón a fundadora de una marca que lidera la salud capilar y la rentabilidad de miles de profesionales.
        </p>
        
        <span style="display:inline-flex;align-items:center;gap:8px;margin-top:20px;height:46px;padding:0 22px;border-radius:999px;border:1.5px solid rgba(255,253,248,.4);background:rgba(255,253,248,.12);backdrop-filter:blur(12px);color:#FFFDF8;font-weight:700;font-size:14px">
          <span class="mi mio" style="font-size:19px">arrow_outward</span>
          <span>Conectar con Cristina</span>
        </span>
      </span>
    </a>

  </div>
</section>

<section id="blog" style="position:relative;max-width:1320px;margin:0 auto;padding:clamp(50px,7vw,88px) 18px 0">
  
  <!-- Subtle ambient decorative golden backdrop -->
  <div style="position:absolute;top:20px;right:5%;width:360px;height:360px;background:radial-gradient(circle,rgba(201,164,92,.12) 0%,transparent 70%);filter:blur(40px);pointer-events:none"></div>

  <!-- Header with Editorial Styling and Slide Navigation Controls -->
  <div style="display:flex;flex-wrap:wrap;gap:20px;align-items:flex-end;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:24px">
    <div style="max-width:740px">
      <div style="display:inline-flex;align-items:center;gap:8px;padding:6px 15px;border-radius:999px;background:var(--surf);border:1px solid var(--line2);box-shadow:var(--e1);margin-bottom:12px">
        <span class="mi" style="font-size:16px;color:var(--gold)">menu_book</span>
        <span style="font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:800">LYOS Journal · Ciencia, Técnica &amp; Negocio</span>
      </div>
      <h2 data-en="Information that raises your standard" style="font-family:'Outfit',sans-serif;font-size:clamp(30px,5vw,52px);font-weight:800;letter-spacing:-.045em;line-height:1.05;margin:0">
        Conocimiento que eleva tu estándar<br>
        <span style="font-family:'Kaushan Script',cursive;font-weight:400;font-size:.92em;letter-spacing:0;background:var(--goldGrad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">y multiplica tus resultados</span>
      </h2>
      <p style="font-size:15px;color:var(--mut);margin:14px 0 0;line-height:1.6;max-width:54ch">
        Protocolos clínicos, tricología aplicada y estrategias de monetización para estilistas que lideran el mercado.
      </p>
    </div>
    
    <!-- Controls Row: Slide arrows & Suggest Button -->
    <div style="display:flex;align-items:center;gap:10px">
      <button onClick="{{ slideBlogPrev }}" aria-label="Anterior artículo" style="width:44px;height:44px;border-radius:999px;border:1.5px solid var(--line2);background:var(--surf);display:grid;place-items:center;cursor:pointer;color:var(--txt);transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold);transform:scale(1.05)">
        <span class="mi" style="font-size:22px">arrow_back</span>
      </button>
      <button onClick="{{ slideBlogNext }}" aria-label="Siguiente artículo" style="width:44px;height:44px;border-radius:999px;border:1.5px solid var(--line2);background:var(--surf);display:grid;place-items:center;cursor:pointer;color:var(--txt);transition:all .25s;box-shadow:var(--e1)" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold);transform:scale(1.05)">
        <span class="mi" style="font-size:22px">arrow_forward</span>
      </button>
      <a href="{{ waBlog }}" target="_blank" data-en="Suggest a topic" style="display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 20px;border-radius:999px;border:1px solid var(--line2);background:var(--surf);font-size:13px;font-weight:700;color:var(--txt);transition:all .25s;box-shadow:var(--e1)" style-hover="border-color:var(--gold);color:var(--gold);transform:translateY(-1px)">
        <span class="mi" style="font-size:17px;color:var(--gold)">lightbulb</span>
        <span>Sugerir Tema</span>
      </a>
    </div>
  </div>

  <!-- 3-Column Sliding Carousel Container -->
  <div id="blog-track" class="hs" style="display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:28px 4px;margin:0 -4px">
    <sc-for list="{{ articlesList }}" as="art" hint-placeholder-count="3">
      <article onClick="{{ art.open }}" style="flex:0 0 calc(33.333% - 16px);min-width:300px;max-width:420px;scroll-snap-align:start;border-radius:28px;overflow:hidden;background:var(--surf);border:1.5px solid var(--line2);box-shadow:var(--e2);display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s,border-color .35s;position:relative" style-hover="transform:translateY(-7px);box-shadow:var(--e3);border-color:var(--gold)">
        
        <!-- Card Top Cover Image with Floating Tags -->
        <div style="position:relative;width:100%;aspect-ratio:16/10;overflow:hidden;background:var(--plinth);border-bottom:1px solid var(--line)">
          <img src="{{ art.img }}" alt="{{ art.title }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:center 26%;transition:transform .6s cubic-bezier(.2,.8,.2,1)" style-hover="transform:scale(1.08)" />
          <span style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.35) 0%,transparent 40%,rgba(0,0,0,.45) 100%)"></span>
          
          <!-- Category Floating Badge -->
          <span style="position:absolute;top:14px;left:14px;padding:5px 12px;border-radius:999px;background:rgba(14,11,7,.85);backdrop-filter:blur(10px);border:1px solid rgba(241,222,184,.4);color:#F1DEB8;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase">
            {{ art.cat }}
          </span>

          <!-- Read Time Badge -->
          <span style="position:absolute;top:14px;right:14px;display:inline-flex;align-items:center;gap:4px;padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.9);backdrop-filter:blur(8px);color:#16120D;font-size:10.5px;font-weight:700">
            <span class="mi mio" style="font-size:14px">schedule</span>{{ art.readTime }}
          </span>
        </div>

        <!-- Card Body Content -->
        <div style="padding:22px 22px 24px;display:flex;flex-direction:column;flex:1">
          
          <!-- Rating & Verified Row -->
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px">
            <div style="display:flex;align-items:center;gap:6px">
              <span style="color:var(--gold);letter-spacing:1.2px;font-size:13px">{{ art.stars }}</span>
              <span style="font-size:12px;font-weight:800;color:var(--txt)">{{ art.rating }}</span>
            </div>
            <span style="font-size:9.5px;font-weight:800;color:var(--gold);letter-spacing:.08em;padding:2px 7px;border-radius:999px;background:var(--surf3)">RECOMENDADO</span>
          </div>

          <!-- Title -->
          <h3 style="font-family:'Outfit',sans-serif;font-size:19px;font-weight:800;line-height:1.24;letter-spacing:-.025em;color:var(--txt);margin:0">
            {{ art.title }}
          </h3>

          <!-- Excerpt -->
          <p style="font-size:13.5px;line-height:1.55;color:var(--mut);margin:10px 0 0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
            {{ art.excerpt }}
          </p>

          <!-- Author Info Capsule -->
          <div style="display:flex;align-items:center;gap:10px;margin-top:auto;padding-top:16px;border-top:1px solid var(--line)">
            <span style="width:34px;height:34px;border-radius:999px;background:var(--goldGrad);display:grid;place-items:center;color:var(--onGold);font-family:'Outfit',sans-serif;font-weight:800;font-size:12.5px;flex:none">
              {{ art.avatar }}
            </span>
            <div style="display:flex;flex-direction:column;min-width:0">
              <span style="font-size:12.5px;font-weight:800;color:var(--txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ art.author }}</span>
              <span style="font-size:11px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ art.role }}</span>
            </div>
          </div>

          <!-- Bottom Action Buttons -->
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:14px;padding-top:12px">
            <span style="font-size:13px;font-weight:800;color:var(--gold);display:inline-flex;align-items:center;gap:5px" style-hover="color:var(--gold2)">
              <span>Leer Artículo</span>
              <span class="mi mio" style="font-size:16px">arrow_forward</span>
            </span>
            <a href="{{ art.waCommentLink }}" onClick="{{ art.stop }}" target="_blank" aria-label="Comentar por WhatsApp" style="width:36px;height:36px;border-radius:999px;background:var(--surf2);border:1px solid var(--line2);display:grid;place-items:center;color:#25D366;transition:all .2s" style-hover="background:var(--surf3);transform:scale(1.08)">
              <span class="mi" style="font-size:18px">chat</span>
            </a>
          </div>

        </div>

      </article>
    </sc-for>
  </div>

  <!-- Bottom Technical Community Callout -->
  <div style="position:relative;margin-top:clamp(16px,2.5vw,28px);border-radius:26px;background:linear-gradient(135deg,rgba(168,124,47,.12) 0%,var(--surf2) 50%,var(--surf) 100%);border:1px solid var(--line2);padding:clamp(20px,3vw,28px);box-shadow:var(--e1);display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:space-between">
    <div style="display:flex;gap:16px;align-items:center;max-width:680px">
      <div style="width:48px;height:48px;border-radius:16px;background:var(--goldGrad);display:grid;place-items:center;color:var(--onGold);flex:none;box-shadow:0 8px 20px -6px rgba(168,124,47,.7)">
        <span class="mi" style="font-size:24px">school</span>
      </div>
      <div>
        <span style="display:block;font-family:'Outfit',sans-serif;font-size:17px;font-weight:800;color:var(--txt);letter-spacing:-.02em">
          ¿Quieres recibir nuestros protocolos y fichas técnicas en PDF?
        </span>
        <span style="display:block;font-size:13px;color:var(--mut);margin-top:2px">
          Compartimos casos reales, guías de mezcla y actualizaciones de academia cada semana por WhatsApp.
        </span>
      </div>
    </div>

    <a href="{{ waAcademia }}" target="_blank" style="display:inline-flex;align-items:center;gap:9px;height:48px;padding:0 24px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-size:13.5px;font-weight:700;box-shadow:0 10px 24px -8px rgba(168,124,47,.7);transition:all .25s;white-space:nowrap" style-hover="filter:brightness(1.08);transform:translateY(-2px)">
      <span class="mi" style="font-size:18px">download</span>
      <span>Unirme al Canal Técnico VIP</span>
    </a>
  </div>

</section>

<!-- Full Reading Modal for Articles -->
<sc-if value="{{ hasActiveArticle }}" hint-placeholder-val="{{ false }}">
  <div onClick="{{ closeArticleModal }}" style="position:fixed;inset:0;z-index:99;background:rgba(8,6,4,.72);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);display:flex;align-items:center;justify-content:center;padding:clamp(14px,3vw,24px);overflow-y:auto">
    <div onClick="{{ stop }}" class="hs" style="width:min(100%,680px);background:var(--surf);border:1.5px solid var(--line2);border-radius:32px;box-shadow:0 30px 90px -20px rgba(0,0,0,.6),var(--e3);animation:slidein .34s cubic-bezier(.2,.8,.2,1);max-height:min(90dvh,840px);overflow-y:auto;position:relative;margin:auto">
      
      <!-- Top Cover Image -->
      <div style="position:relative;width:100%;height:240px;overflow:hidden">
        <img src="{{ activeArticleData.img }}" alt="" style="width:100%;height:100%;object-fit:cover;object-position:center 26%" />
        <span style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.3) 0%,rgba(0,0,0,.7) 100%)"></span>
        <button onClick="{{ closeArticleModal }}" aria-label="Cerrar modal" style="position:absolute;top:16px;right:16px;width:38px;height:38px;border:0;border-radius:999px;background:rgba(0,0,0,.6);color:#fff;cursor:pointer;display:grid;place-items:center">
          <span class="mi" style="font-size:20px">close</span>
        </button>
        <span style="position:absolute;bottom:16px;left:20px;padding:5px 12px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase">
          {{ activeArticleData.cat }}
        </span>
      </div>

      <div style="padding:26px 28px 32px">
        <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--mut);margin-bottom:8px">
          <span style="color:var(--gold)">{{ activeArticleData.stars }}</span>
          <span>{{ activeArticleData.rating }}</span>
          <span>·</span>
          <span>{{ activeArticleData.readTime }}</span>
        </div>

        <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(22px,3.4vw,28px);font-weight:800;letter-spacing:-.03em;color:var(--txt);margin:0;line-height:1.2">
          {{ activeArticleData.title }}
        </h2>

        <div style="display:flex;align-items:center;gap:12px;margin:18px 0;padding:12px 16px;border-radius:18px;background:var(--surf2);border:1px solid var(--line)">
          <span style="width:38px;height:38px;border-radius:999px;background:var(--goldGrad);display:grid;place-items:center;color:var(--onGold);font-weight:800;font-size:14px;flex:none">
            {{ activeArticleData.avatar }}
          </span>
          <div>
            <span style="display:block;font-size:13px;font-weight:800;color:var(--txt)">{{ activeArticleData.author }}</span>
            <span style="display:block;font-size:11.5px;color:var(--mut)">{{ activeArticleData.role }}</span>
          </div>
        </div>

        <p style="font-size:15px;line-height:1.75;color:var(--txt);margin:16px 0 0">
          {{ activeArticleData.fullText }}
        </p>

        <div style="display:flex;gap:10px;margin-top:28px;padding-top:20px;border-top:1px solid var(--line)">
          <a href="{{ activeArticleData.waLink }}" target="_blank" style="flex:1;height:48px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:800;font-size:13.5px;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 8px 20px -6px rgba(168,124,47,.7)">
            <span class="mi" style="font-size:18px">chat</span>
            <span>Discutir Protocolo por WhatsApp</span>
          </a>
          <button onClick="{{ closeArticleModal }}" style="height:48px;padding:0 22px;border-radius:999px;border:1.5px solid var(--line2);background:var(--surf2);color:var(--txt);font-weight:700;font-size:13px;cursor:pointer">
            <span>Cerrar</span>
          </button>
        </div>
      </div>

    </div>
  </div>
</sc-if>

<!-- ========================================================================= -->
<!-- ACORDEÓN DE PREGUNTAS FRECUENTES (FAQ VIP INTERACTIVO)                    -->
<!-- ========================================================================= -->
<section id="faq" style="position:relative;max-width:1040px;margin:clamp(52px,7.5vw,96px) auto 0;padding:0 18px">
  
  <!-- Section Header -->
  <div style="text-align:center;max-width:720px;margin:0 auto">
    <div style="display:inline-flex;align-items:center;gap:7px;padding:6px 16px;border-radius:999px;background:var(--surf);border:1.5px solid var(--line2);font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:800;margin-bottom:12px;box-shadow:var(--e1)">
      <span class="mi" style="font-size:16px">help_outline</span>Centro de Dudas &amp; Preguntas Frecuentes
    </div>
    
    <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(28px,4.5vw,48px);font-weight:800;letter-spacing:-.04em;line-height:1.06;margin:0;color:var(--txt)">
      Todo lo que Necesitas Saber
    </h2>
    
    <p style="font-size:14.5px;color:var(--mut);margin:8px auto 0;line-height:1.6;max-width:52ch">
      Resolvemos tus dudas sobre formulación 0% formol, compatibilidad con decoloración, durabilidad y envíos.
    </p>
  </div>

  <!-- Search & Category Filters -->
  <div style="margin:26px 0 20px;display:flex;flex-direction:column;gap:14px">
    
    <!-- Instant Search Bar -->
    <div style="position:relative;max-width:560px;margin:0 auto;width:100%">
      <span class="mi mio" style="position:absolute;left:16px;top:50%;transform:translateY(-50%);color:var(--gold);font-size:20px;pointer-events:none">search</span>
      <input value="{{ faqQuery }}" onInput="{{ onFaqQueryInput }}" placeholder="Buscar por palabra clave (ej: decoloración, embarazo, formol)..." style="width:100%;height:48px;padding:0 18px 0 46px;border-radius:999px;border:1.5px solid var(--line2);background:var(--surf);outline:none;font-size:13.5px;color:var(--txt);box-shadow:var(--e1);transition:all .2s" style-focus="border-color:var(--gold)" />
    </div>

    <!-- Category Filter Pills -->
    <div class="hs" style="display:flex;gap:8px;justify-content:center;overflow-x:auto;padding:4px 2px;scroll-snap-type:x proximity">
      <sc-for list="{{ faqCategories }}" as="fc" hint-placeholder-count="5">
        <button onClick="{{ fc.pick }}" style="{{ fc.style }}" style-hover="border-color:var(--gold);transform:translateY(-1px)">
          <span class="mi" style="font-size:16px">{{ fc.icon }}</span>
          <span>{{ fc.label }}</span>
        </button>
      </sc-for>
    </div>

  </div>

  <!-- Accordion List -->
  <div style="display:grid;gap:12px;margin-top:16px">
    <sc-for list="{{ faqsList }}" as="f" hint-placeholder-count="6">
      <div style="border-radius:22px;background:var(--surf);border:1.5px solid {{ f.isOpen ? 'var(--gold)' : 'var(--line)' }};box-shadow:var(--e1);overflow:hidden;transition:all .3s">
        
        <button onClick="{{ f.toggle }}" style="width:100%;display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border:0;background:transparent;cursor:pointer;text-align:left;gap:14px">
          <div style="display:flex;align-items:center;gap:12px">
            <span style="width:36px;height:36px;border-radius:12px;background:{{ f.isOpen ? 'var(--goldGrad)' : 'var(--surf2)' }};color:{{ f.isOpen ? 'var(--onGold)' : 'var(--gold)' }};display:grid;place-items:center;flex:none;transition:all .25s">
              <span class="mi" style="font-size:18px">{{ f.icon }}</span>
            </span>
            <span style="font-family:'Outfit',sans-serif;font-size:15.5px;font-weight:800;color:var(--txt);letter-spacing:-.015em">{{ f.q }}</span>
          </div>
          <span class="mi" style="font-size:22px;color:{{ f.isOpen ? 'var(--gold)' : 'var(--dim)' }};transform:{{ f.isOpen ? 'rotate(180deg)' : 'none' }};transition:transform .3s;flex:none">expand_more</span>
        </button>

        <sc-if value="{{ f.isOpen }}" hint-placeholder-val="{{ false }}">
          <div style="padding:0 22px 20px 70px;border-top:1px solid var(--line);margin-top:-2px">
            <p style="font-size:14px;line-height:1.7;color:var(--mut);margin:14px 0 0">{{ f.a }}</p>
          </div>
        </sc-if>

      </div>
    </sc-for>
  </div>

  <!-- Bottom Direct WhatsApp Help Link -->
  <div style="text-align:center;margin-top:28px">
    <span style="font-size:13px;color:var(--mut)">¿Tienes otra duda técnica? </span>
    <a href="{{ waLink }}" target="_blank" style="font-size:13px;font-weight:800;color:var(--gold);text-decoration:underline" style-hover="color:var(--gold2)">
      Escríbenos por WhatsApp y te asesoramos en minutos →
    </a>
  </div>

</section>

<section id="contacto" style="position:relative;margin-top:clamp(52px,7.5vw,96px);padding:clamp(50px,7vw,88px) 0;background:linear-gradient(180deg,var(--bg) 0%,var(--bg2) 40%,var(--bg) 100%);border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden">
  
  <!-- Subtle ambient decorative glow spheres -->
  <div style="position:absolute;top:10%;left:50%;transform:translateX(-50%);width:min(800px,90vw);height:320px;background:radial-gradient(ellipse,rgba(201,164,92,.16) 0%,rgba(138,100,37,.04) 50%,transparent 70%);filter:blur(50px);pointer-events:none"></div>

  <div style="max-width:1320px;margin:0 auto;padding:0 18px;position:relative;z-index:2">
    
    <!-- Section Header with High Impact Styling -->
    <div style="text-align:center;max-width:760px;margin:0 auto">
      <div style="display:inline-flex;align-items:center;gap:8px;padding:7px 18px;border-radius:999px;background:var(--surf);border:1px solid var(--line2);box-shadow:var(--e1);margin-bottom:16px">
        <span style="width:8px;height:8px;border-radius:999px;background:#25D366;box-shadow:0 0 10px #25D366;display:inline-block"></span>
        <span style="font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:800">Atención Personalizada · Concierge LYOS</span>
      </div>
      
      <h2 data-en="How can we help you today?" style="font-family:'Outfit',sans-serif;font-size:clamp(32px,5.2vw,56px);font-weight:800;letter-spacing:-.045em;line-height:1.04;margin:0">
        ¿Cómo podemos ayudarte hoy?<br>
        <span style="font-family:'Kaushan Script',cursive;font-weight:400;font-size:.92em;letter-spacing:0;background:var(--goldGrad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">estamos a un mensaje de distancia</span>
      </h2>
      
      <p data-en="Buying is instant. Anything else gets a real call with our team." style="font-size:15.5px;color:var(--mut);margin:16px auto 0;line-height:1.65;max-width:54ch">
        Elige tu objetivo y te conectamos al instante con la especialista indicada: compras directas, planes de embajadora, distribución o masterclass.
      </p>
    </div>

    <!-- Interactive Intent Selector Pills -->
    <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:32px">
      <sc-for list="{{ intents }}" as="i" hint-placeholder-count="4">
        <button onClick="{{ i.pick }}" style="{{ i.style }};box-shadow:var(--e1)">
          <span class="mi" style="font-size:19px">{{ i.icon }}</span>
          <span>{{ i.label }}</span>
        </button>
      </sc-for>
    </div>

    <!-- Main Dual Action Cards Grid -->
    <div style="max-width:1120px;margin:32px auto 0;display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));align-items:stretch">
      
      <!-- Dynamic Card 1: Intent Dynamic Showcase -->
      <sc-if value="{{ isBuyIntent }}" hint-placeholder-val="{{ true }}">
        <div style="position:relative;padding:clamp(26px,3.8vw,42px);border-radius:32px;background:linear-gradient(150deg,var(--surf) 0%,var(--surf2) 100%);border:1.5px solid var(--line2);box-shadow:var(--e3);display:flex;flex-direction:column;justify-content:space-between;overflow:hidden">
          
          <!-- Top Badge -->
          <div>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
              <div style="width:48px;height:48px;border-radius:16px;background:var(--goldGrad);display:grid;place-items:center;color:var(--onGold);box-shadow:0 10px 22px -8px rgba(168,124,47,.7)">
                <span class="mi" style="font-size:26px">bolt</span>
              </div>
              <span style="padding:6px 14px;border-radius:999px;background:var(--surf3);border:1px solid var(--line);font-size:10.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--gold)">Compra Express</span>
            </div>

            <h3 style="font-family:'Outfit',sans-serif;font-size:clamp(24px,3.2vw,32px);font-weight:800;letter-spacing:-.035em;line-height:1.15;margin:18px 0 0">
              Compra en 2 clics por WhatsApp
            </h3>
            
            <p style="font-size:14.5px;line-height:1.65;color:var(--mut);margin:12px 0 0">
              Elige tu presentación, confirma tu ciudad y tu pedido llegará directamente a nuestro WhatsApp oficial con el detalle y medios de pago inmediatos.
            </p>

            <!-- Value checkpoints -->
            <div style="display:grid;gap:10px;margin-top:22px">
              <div style="display:flex;align-items:center;gap:10px;font-size:13.5px;font-weight:600;color:var(--txt)">
                <span class="mi" style="font-size:19px;color:var(--gold)">check_circle</span>
                <span>Despacho prioritario en menos de 24 horas</span>
              </div>
              <div style="display:flex;align-items:center;gap:10px;font-size:13.5px;font-weight:600;color:var(--txt)">
                <span class="mi" style="font-size:19px;color:var(--gold)">check_circle</span>
                <span>Envío 100% GRATIS en compras superiores a $150.000</span>
              </div>
              <div style="display:flex;align-items:center;gap:10px;font-size:13.5px;font-weight:600;color:var(--txt)">
                <span class="mi" style="font-size:19px;color:var(--gold)">check_circle</span>
                <span>Pagos seguros por Bancolombia, Nequi o Contraentrega</span>
              </div>
            </div>
          </div>

          <!-- Buttons Group -->
          <div style="display:flex;flex-direction:column;gap:10px;margin-top:30px;padding-top:22px;border-top:1px solid var(--line)">
            <a href="#productos" style="display:flex;align-items:center;justify-content:center;gap:10px;height:54px;border-radius:999px;background:var(--goldGrad);color:var(--onGold);font-weight:700;font-size:15px;box-shadow:0 14px 32px -10px rgba(168,124,47,.7);transition:all .25s" style-hover="filter:brightness(1.08);transform:translateY(-2px)">
              <span class="mi" style="font-size:21px">storefront</span>
              <span>Ir al Catálogo de Productos</span>
            </a>
            <a href="{{ waLink }}" target="_blank" style="display:flex;align-items:center;justify-content:center;gap:10px;height:52px;border-radius:999px;border:1px solid var(--line2);background:var(--surf);color:var(--txt);font-weight:600;font-size:14.5px;transition:all .25s" style-hover="background:var(--surf2);border-color:var(--gold);color:var(--gold)">
              <span class="mi" style="font-size:20px;color:#25D366">chat</span>
              <span>Preguntar a una Asesora</span>
            </a>
          </div>

        </div>
      </sc-if>

      <sc-if value="{{ isBookIntent }}" hint-placeholder-val="{{ false }}">
        <div style="position:relative;padding:clamp(26px,3.8vw,42px);border-radius:32px;background:linear-gradient(150deg,var(--surf) 0%,var(--surf2) 100%);border:1.5px solid var(--line2);box-shadow:var(--e3);display:flex;flex-direction:column;justify-content:space-between;overflow:hidden">
          
          <div>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
              <div style="width:48px;height:48px;border-radius:16px;background:var(--goldGrad);display:grid;place-items:center;color:var(--onGold);box-shadow:0 10px 22px -8px rgba(168,124,47,.7)">
                <span class="mi" style="font-size:26px">workspace_premium</span>
              </div>
              <span style="padding:6px 14px;border-radius:999px;background:var(--surf3);border:1px solid var(--line);font-size:10.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--gold)">Atención VIP</span>
            </div>

            <h3 style="font-family:'Outfit',sans-serif;font-size:clamp(24px,3.2vw,32px);font-weight:800;letter-spacing:-.035em;line-height:1.15;margin:18px 0 0">
              {{ bookTitle }}
            </h3>
            
            <p style="font-size:14.5px;line-height:1.65;color:var(--mut);margin:12px 0 0">
              {{ bookText }}
            </p>

            <div style="display:grid;gap:10px;margin-top:22px">
              <div style="display:flex;align-items:center;gap:10px;font-size:13.5px;font-weight:600;color:var(--txt)">
                <span class="mi" style="font-size:19px;color:var(--gold)">verified</span>
                <span>Asignación de ejecutiva comercial dedicada</span>
              </div>
              <div style="display:flex;align-items:center;gap:10px;font-size:13.5px;font-weight:600;color:var(--txt)">
                <span class="mi" style="font-size:19px;color:var(--gold)">verified</span>
                <span>Material de apoyo, fichas técnicas y certificados</span>
              </div>
